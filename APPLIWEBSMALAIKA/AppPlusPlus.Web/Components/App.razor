<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@3.35.0/dist/tabler-icons.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=block" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/aw-ui.css"]" />
    <link rel="stylesheet" href="@Assets["css/malaika-public.css"]" />
    <link rel="stylesheet" href="@Assets["css/alibaba-home.css"]" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&amp;family=Figtree:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["css/malaika-mockup-theme.css"]" />
    <script src="js/appliweb-interop.js"></script>
    <ImportMap />
    <link rel="icon" type="image/png" href="appliweb-logo-v2.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <div id="app-nav-progress" aria-hidden="true"></div>
    <CascadingAuthenticationState>
        <Routes @rendermode="InteractiveServer" />
    </CascadingAuthenticationState>
    <ReconnectModal />
    <script>
        // Lecteur code-barres — définition de secours si appliweb-interop.js absent
        window.ensureAppliWebInterop && window.ensureAppliWebInterop();

        window.appNavigation = {
            backOrFallback: function (fallbackUrl) {
                try {
                    const referrer = document.referrer || "";
                    const sameOriginReferrer = referrer.startsWith(window.location.origin);
                    if (window.history.length > 1 && sameOriginReferrer) {
                        window.history.back();
                        return;
                    }
                } catch (e) {
                }
                window.location.href = fallbackUrl || "/";
            },
            scrollToElement: function (id) {
                var el = document.getElementById(id);
                if (el) {
                    el.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            },
            startProgress: function () {
                var bar = document.getElementById("app-nav-progress");
                if (!bar) return;
                bar.classList.add("is-active");
                if (window.appNavigation._progressTimer) {
                    clearTimeout(window.appNavigation._progressTimer);
                }
                window.appNavigation._progressTimer = setTimeout(function () {
                    window.appNavigation.finishProgress();
                }, 3200);
            },
            finishProgress: function () {
                var bar = document.getElementById("app-nav-progress");
                if (window.appNavigation._progressTimer) {
                    clearTimeout(window.appNavigation._progressTimer);
                    window.appNavigation._progressTimer = null;
                }
                if (bar) bar.classList.remove("is-active");
            },
            hideBootFallback: function () {
                /* overlay plein écran retiré — no-op conservé pour compatibilité */
            },
            bindProgress: function () {
                if (window.appNavigation._progressBound) return;
                window.appNavigation._progressBound = true;
                document.addEventListener("click", function (e) {
                    var link = e.target.closest("a[href]");
                    if (!link || link.target === "_blank" || link.hasAttribute("download")) return;
                    var href = link.getAttribute("href") || "";
                    if (!href || href.charAt(0) === "#" || href.indexOf("javascript:") === 0) return;
                    var isInternal = href.charAt(0) === "/" || href.indexOf(window.location.origin) === 0;
                    if (!isInternal) return;
                    window.appNavigation.startProgress();
                });
                window.addEventListener("pageshow", function () {
                    window.appNavigation.finishProgress();
                });
                document.addEventListener("visibilitychange", function () {
                    if (document.visibilityState === "visible") {
                        window.appNavigation.finishProgress();
                    }
                });
            }
        };

        window.clientCart = {
            storageKey: "appliweb_client_cart_v1",
            readJson: function () {
                try {
                    return localStorage.getItem(this.storageKey) || "[]";
                } catch (e) {
                    return "[]";
                }
            },
            writeJson: function (json) {
                try {
                    localStorage.setItem(this.storageKey, json || "[]");
                } catch (e) {
                }
            },
            clear: function () {
                try {
                    localStorage.removeItem(this.storageKey);
                } catch (e) {
                }
            }
        };

        // Navigation avec onglet
        window.tabNavigation = {
            saveTab: function(hubName, tabIndex) {
                try {
                    localStorage.setItem('hub_tab_' + hubName, tabIndex);
                } catch { }
            },
            getTab: function(hubName, defaultTab = 0) {
                try {
                    const val = localStorage.getItem('hub_tab_' + hubName);
                    return val ? parseInt(val) : defaultTab;
                } catch {
                    return defaultTab;
                }
            },
            clearTab: function(hubName) {
                try {
                    localStorage.removeItem('hub_tab_' + hubName);
                } catch { }
            }
        };

        // Fix: Fermer le dropdown MudAutocomplete après sélection d'un élément
        (function () {
            document.addEventListener('click', function (e) {
                var listItem = e.target.closest('.mud-list-item-clickable');
                if (!listItem) return;
                // Laisser Blazor traiter la sélection, puis blur pour fermer le popover
                setTimeout(function () {
                    var focused = document.activeElement;
                    if (focused && focused.tagName === 'INPUT') {
                        var autocomplete = focused.closest('.mud-autocomplete');
                        if (autocomplete) {
                            focused.blur();
                        }
                    }
                }, 150);
            }, true);
        })();

        window.appSessionKeepAlive = {
            timer: null,
            start: function () {
                if (this.timer) return;
                var ping = function () {
                    fetch("/api/keepalive", { method: "GET", credentials: "same-origin", cache: "no-store" })
                        .catch(function () { });
                };
                ping();
                this.timer = setInterval(ping, 120000);
            }
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        (function () {
            Blazor.start({
                circuit: {
                    reconnectionOptions: {
                        maxRetries: 8,
                        retryIntervalMilliseconds: 4000
                    }
                }
            }).then(function () {
                window.ensureAppliWebInterop && window.ensureAppliWebInterop();
                window.appNavigation.bindProgress();
                if (window.appSessionKeepAlive) window.appSessionKeepAlive.start();
                if (typeof Blazor.addEventListener === "function") {
                    Blazor.addEventListener("enhancedload", function () {
                        window.ensureAppliWebInterop && window.ensureAppliWebInterop();
                        window.appNavigation.finishProgress();
                    });
                }
            }).catch(function (err) {
                console.error("Blazor.start failed", err);
            });
        })();
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.ensureAppliWebInterop && window.ensureAppliWebInterop();
        if (window.awOverlay && typeof window.awOverlay.configureBootstrapDropdowns === "function") {
            window.awOverlay.configureBootstrapDropdowns();
        }
    </script>
</body>

</html>
