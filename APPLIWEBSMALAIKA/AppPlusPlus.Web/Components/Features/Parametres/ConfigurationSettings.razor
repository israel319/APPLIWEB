    async Task<bool> Confirmer(string message)
    {
        var result = await DialogService.ShowMessageBox("Confirmation", message,
            yesText: "Supprimer", cancelText: "Annuler");
        return result == true;
    }

    async Task DeleteBulkAsync()
    {
        if (_bulkSelected.Count == 0)
            return;

        var label = GetBulkItemLabel();
        var count = _bulkSelected.Count;
        if (!await Confirmer($"Supprimer {count} {label}{(count > 1 ? "s" : "")} ?"))
            return;

        var keys = _bulkSelected.ToList();
        var deleted = 0;
        var errors = 0;

        foreach (var key in keys)
        {
            try
            {
                if (await TryDeleteByKeyAsync(key))
                    deleted++;
            }
            catch (Exception ex)
            {
                errors++;
                Snackbar.Add(ex.InnerException?.Message ?? ex.Message, Severity.Error);
            }
        }

        ClearBulkSelection();

        if (deleted > 0)
            Snackbar.Add($"{deleted} {label}{(deleted > 1 ? "s" : "")} supprimé{(deleted > 1 ? "s" : "")}.", Severity.Success);
        if (errors > 0 && deleted == 0)
            Snackbar.Add("Aucun élément n'a pu être supprimé.", Severity.Warning);
    }

    async Task<bool> TryDeleteByKeyAsync(string key)
    {
        var sep = key.IndexOf(':');
        if (sep <= 0 || !int.TryParse(key[(sep + 1)..], out var id))
            return false;

        var kind = key[..sep];
        switch (kind)
        {
            case "cat":
            {
                var item = _categories.FirstOrDefault(c => c.IdCategory == id);
                if (item is null) return false;
                await CatalogueService.DeleteCategoryAsync(item);
                _categories.Remove(item);
                return true;
            }
            case "type":
            {
                var item = _types.FirstOrDefault(t => t.IdType == id);
                if (item is null) return false;
                await CatalogueService.DeleteTypeAsync(item);
                _types.Remove(item);
                return true;
            }
            case "marque":
            {
                var item = _marques.FirstOrDefault(m => m.IdMarque == id);
                if (item is null) return false;
                await CatalogueService.DeleteMarqueAsync(item);
                _marques.Remove(item);
                return true;
            }
            case "mesure":
            {
                var item = _mesures.FirstOrDefault(m => m.IdMesure == id);
                if (item is null) return false;
                await CatalogueService.DeleteMesureAsync(item);
                _mesures.Remove(item);
                return true;
            }
            default:
                return false;
        }
    }
