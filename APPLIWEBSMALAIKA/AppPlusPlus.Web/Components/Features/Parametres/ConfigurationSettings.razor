    static string BulkKey(string kind, int id) => $"{kind}:{id}";

    int BulkSelectedCount => _bulkSelected.Count;

    void ClearBulkSelection() => _bulkSelected.Clear();

    void ToggleBulkItem(string key, bool selected)
    {
        if (selected)
            _bulkSelected.Add(key);
        else
            _bulkSelected.Remove(key);
    }

    bool IsBulkSelected(string key) => _bulkSelected.Contains(key);

    static bool AllPageSelected(IReadOnlyList<string> pageKeys, HashSet<string> selected) =>
        pageKeys.Count > 0 && pageKeys.All(selected.Contains);

    static bool SomePageSelected(IReadOnlyList<string> pageKeys, HashSet<string> selected) =>
        pageKeys.Any(selected.Contains) && !AllPageSelected(pageKeys, selected);

    void SetPageBulkSelection(IReadOnlyList<string> pageKeys, bool selected)
    {
        foreach (var key in pageKeys)
        {
            if (selected)
                _bulkSelected.Add(key);
            else
                _bulkSelected.Remove(key);
        }
    }

    string GetBulkItemLabel() => _section switch
    {
        "types" => "type",
        "marques" => "marque",
        "mesures" => "unité",
        _ => "catégorie"
    };

    IList<T> PageOf<T>(IList<T> items, int page, int pageSize) =>
        items.Skip((page - 1) * pageSize).Take(pageSize).ToList();

    int PageCount(int total, int pageSize) =>
        total <= 0 ? 1 : (int)Math.Ceiling(total / (double)Math.Max(1, pageSize));

    void SetPage(int page) =>
        _page = Math.Clamp(page, 1, PageCount(GetFilteredCount(), _pageSize));

    void SetPageSize(int size)
    {
        if (!PageSizeChoices.Contains(size)) return;
        _pageSize = size;
        _page = 1;
    }

    int GetFilteredCount() => _section switch
    {
        "types" => FilterByText(_types, t => t.DescriptionType, _search).Count,
        "marques" => FilterByText(_marques, m => m.DescriptionMarque, _search).Count,
        "mesures" => FilterByText(_mesures, m => m.DescriptionMesure, _search).Count,
        _ => FilterByText(_categories, c => c.DescriptionCategory, _search).Count
    };

    static List<T> FilterByText<T>(IEnumerable<T> source, Func<T, string?> selector, string? query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return source.ToList();
        var q = query.Trim();
        return source.Where(x => (selector(x) ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    void CancelAllEdits()
    {
        _editCategoryId = null;
        _editCategoryText = "";
        _editCategoryImage = null;
        _categoryImageError = null;
        _editTypeId = null;
        _editTypeText = "";
        _editMarqueId = null;
        _editMarqueText = "";
        _editMesureId = null;
        _editMesureText = "";
    }

    async Task OnCategoryImageSelected(InputFileChangeEventArgs e)
    {
        _categoryImageError = null;
        var file = e.File;
        if (file.Size > 2 * 1024 * 1024)
        {
            _categoryImageError = "Fichier trop grand (max 2 Mo).";
            return;
        }
        if (!file.ContentType.StartsWith("image/"))
        {
            _categoryImageError = "Seuls les fichiers image sont acceptés.";
            return;
        }

        _categoryImageUploading = true;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            _editCategoryImage = $"data:{file.ContentType};base64,{base64}";
        }
        catch (Exception ex)
        {
            _categoryImageError = ex.Message;
        }
        finally
        {
            _categoryImageUploading = false;
        }
    }

