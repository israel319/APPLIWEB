@page "/vente"
@rendermode InteractiveServer
@inject IFacturationService FacturationService
@inject ILivraisonService LivraisonService
@inject IClotureService ClotureService
@inject ILocalisationService LocalisationService
@inject IPermissionResolver PermissionResolver
@inject MudBlazor.IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject IFinanceService FinanceService
@inject IUserCurrencyPreferenceService UserCurrency
@using System.Security.Claims
@using AppPlusPlus.Domain.Entities.Finance
@implements IDisposable

<ModuleGuard ModuleCode="vente" ModuleName="Ventes & Facturation">

<PageTitle>@AppSettings.AppName — Ventes</PageTitle>

@if (!_loaded)
{
    <div class="aw-page">
        <AwSkeleton Variant="page" Rows="7" />
    </div>
}
else
{
    @if (!_hasSalesReadAccess)
    {
        <div class="aw-page">
            <div class="aw-shell" style="max-width:720px;margin:1.5rem auto;">
                <div class="aw-empty">
                    <i class="bi bi-lock"></i>
                    <p><strong>Accès refusé</strong><br />Votre rôle ne possède pas les droits de lecture sur les ventes.</p>
                </div>
            </div>
        </div>
    }
    else
    {
    <div class="aw-page aw-page--workspace">
        <div class="aw-workspace">
            <header class="aw-object-head">
                <div class="aw-object-head__identity">
                    <h1 class="aw-object-head__title">Ventes</h1>
                    <p class="aw-object-head__desc">
                        @GetVenteSectionDescription()
                        @if (_activePeriode != null)
                        {
                            <text> · Période : @_activePeriode.FromDate?.ToString("dd/MM/yyyy") — @_activePeriode.ToDate?.ToString("dd/MM/yyyy")</text>
                            @if (!string.IsNullOrWhiteSpace(_activePeriode.Comment))
                            {
                                <text> (@_activePeriode.Comment)</text>
                            }
                        }
                        else
                        {
                            <text> · <span style="color:var(--aw-accent);">Aucune période active</span></text>
                        }
                    </p>
                </div>
            </header>

            <nav class="aw-railnav" aria-label="Sections ventes" role="tablist">
                @if (_canFacturationRead)
                {
                    <button type="button" role="tab" aria-selected="@(_tab == 0)"
                            class="aw-railnav__item @(_tab == 0 ? "aw-railnav__item--active" : "")"
                            title="Factures"
                            @onclick="@(async () => await OnTabChange(0))">
                        <i class="bi bi-file-text" aria-hidden="true"></i>
                        Factures
                        @if (_factData.Count > 0)
                        {
                            <span class="aw-railnav__count">@_factData.Count</span>
                        }
                    </button>
                }
                @if (_canLivraisonRead)
                {
                    <button type="button" role="tab" aria-selected="@(_tab == 1)"
                            class="aw-railnav__item @(_tab == 1 ? "aw-railnav__item--active" : "")"
                            title="Livraisons"
                            @onclick="@(async () => await OnTabChange(1))">
                        <i class="bi bi-truck" aria-hidden="true"></i>
                        Livraisons
                        @if (_livData.Count > 0)
                        {
                            <span class="aw-railnav__count">@_livData.Count</span>
                        }
                    </button>
                }
                @if (_canPaiementRead)
                {
                    <button type="button" role="tab" aria-selected="@(_tab == 2)"
                            class="aw-railnav__item @(_tab == 2 ? "aw-railnav__item--active" : "")"
                            title="Paiements"
                            @onclick="@(async () => await OnTabChange(2))">
                        <i class="bi bi-cash" aria-hidden="true"></i>
                        Paiements
                        @{
                            var payOpen = _payData.Count(p => p.Reste > 0 && p.Facture.Status != 3);
                        }
                        @if (payOpen > 0)
                        {
                            <span class="aw-railnav__count aw-railnav__count--alert">@payOpen</span>
                        }
                    </button>
                }
                @if (_canFacturationWrite)
                {
                    <button type="button" role="tab" aria-selected="@(_tab == 3)"
                            class="aw-railnav__item @(_tab == 3 ? "aw-railnav__item--active" : "")"
                            title="Clôtures journalières"
                            @onclick="@(async () => await OnTabChange(3))">
                        <i class="bi bi-calendar-check" aria-hidden="true"></i>
                        Clôtures
                        @{
                            var clotPending = _clotureData.Count(c => c.StatutCloture == 0);
                        }
                        @if (clotPending > 0)
                        {
                            <span class="aw-railnav__count aw-railnav__count--alert">@clotPending</span>
                        }
                    </button>
                }
            </nav>

            <div class="aw-workspace__body">

            @if (_userPendingClotureToday)
            {
                <div class="aw-empty" style="min-height:auto;padding:0.75rem 1rem;flex-direction:row;gap:0.75rem;justify-content:flex-start;align-items:center;margin-bottom:0.75rem;">
                    <i class="bi bi-hourglass-split" style="color:var(--aw-accent);"></i>
                    <p style="margin:0;flex:1;">
                        Clôture soumise — en attente d'approbation admin. Transactions bloquées jusqu'à validation.
                    </p>
                    @if (_tab != 3)
                    {
                        <button type="button" class="aw-btn aw-btn--ghost" @onclick="@(async () => await OnTabChange(3))">
                            Voir le suivi
                        </button>
                    }
                </div>
            }
            else if (_myTodayApprovedCloture != null)
            {
                <div class="aw-empty" style="min-height:auto;padding:0.75rem 1rem;flex-direction:row;gap:0.75rem;justify-content:flex-start;align-items:center;margin-bottom:0.75rem;">
                    <i class="bi bi-check-circle" style="color:var(--aw-brand);"></i>
                    <p style="margin:0;">
                        Clôture du @_myTodayApprovedCloture.DateCloture:dd/MM/yyyy approuvée par @_myTodayApprovedCloture.TraitePar —
                        vous pouvez continuer à vendre. Les factures <strong>clôturées</strong> et celles de la <strong>nouvelle période</strong> sont séparées ci-dessous.
                    </p>
                </div>
            }

            @* ══════════════════ FACTURES ══════════════════ *@
            @if (_tab == 0 && _canFacturationRead)
            {
                var fBrouillon = _factData.Count(r => r.DisplayStatus == 0);
                var fValidee = _factData.Count(r => r.DisplayStatus == 1);
                var fPayee = _factData.Count(r => r.DisplayStatus == 2);
                var fPartiel = _factData.Count(r => r.DisplayStatus == 4);
                var fCloturees = _factData.Count(r => r.EstCloturee);
                var fApresCloture = _factData.Count(r => r.ApresCloture);
                var fOpen = fBrouillon + fValidee + fPartiel;
                var fPaidPct = _factData.Count == 0 ? 0d : Math.Round(100d * fPayee / _factData.Count, 1);
                var fCoverTone = fOpen == 0 ? "brand" : fPartiel > 0 ? "accent" : "brand";
                var factPageItems = PageOf(_factFiltered, _factPage, _factPageSize).ToList();

                @if (_factData.Any())
                {
                    <section class="aw-overview aw-overview--with-cover" aria-label="Vue d'ensemble factures">
                        <div class="aw-overview__top">
                            <div class="aw-overview__intro">
                                <h2 class="aw-overview__title">Vue d'ensemble</h2>
                                <p class="aw-overview__lead">
                                    Facturation du jour : validation, encaissement et clôture.
                                </p>
                            </div>
                            <div class="@($"aw-overview__cover aw-overview__cover--{fCoverTone}")">
                                <span class="aw-overview__cover-value">@fPaidPct.ToString("0.#")&nbsp;%</span>
                                <span class="aw-overview__cover-label">factures payées</span>
                            </div>
                        </div>
                        <div class="aw-overview__meter" role="meter"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)fPaidPct)"
                             aria-label="Part des factures payées">
                            <div class="aw-overview__meter-track">
                                <div class="@($"aw-overview__meter-fill aw-overview__meter-fill--{fCoverTone}")"
                                     style="width: @(fPaidPct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                        <div class="aw-overview__metrics">
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-pencil"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Brouillon</span>
                                    <span class="aw-overview__metric-value">@fBrouillon</span>
                                    <span class="aw-overview__metric-hint">À finaliser</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Ouvertes</span>
                                    <span class="aw-overview__metric-value">@(fValidee + fPartiel)</span>
                                    <span class="aw-overview__metric-hint">Validées / partielles</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Payées</span>
                                    <span class="aw-overview__metric-value">@fPayee</span>
                                    <span class="aw-overview__metric-hint">Encaissées</span>
                                </div>
                            </article>
                        </div>
                    </section>
                }

                <div class="aw-actionbar">
                    <div class="aw-actionbar__search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <AwDebouncedInput Placeholder="Rechercher n°, client, article…"
                                          AriaLabel="Rechercher une facture"
                                          Value="@_factSearch"
                                          ValueChanged="OnFactSearchChanged" />
                    </div>
                    <div class="aw-actionbar__filters">
                        @if (_factData.Any())
                        {
                            <AwSearchSelect AriaLabel="Statut de la facture"
                                            Placeholder="Statut"
                                            Searchable="false"
                                            Value="@(_factStatusFilter?.ToString() ?? "")"
                                            ValueChanged="OnFactStatusFilterChanged"
                                            Options="@GetFactStatusFilterOptions(fBrouillon, fValidee, fPayee, fPartiel)" />
                            @if (fCloturees > 0 || fApresCloture > 0)
                            {
                                <AwSearchSelect AriaLabel="Filtre clôture"
                                                Placeholder="Clôture"
                                                Searchable="false"
                                                Value="@_factClotureFilter"
                                                ValueChanged="OnFactClotureFilterChanged"
                                                Options="@GetFactClotureFilterOptions(fCloturees, fApresCloture)" />
                            }
                        }
                    </div>
                    <div class="aw-actionbar__actions">
                        <button type="button" class="aw-btn aw-btn--ghost" title="Exporter Excel"
                                disabled="@(!_factData.Any())" @onclick="ExportFacturesExcel">
                            <i class="bi bi-file-earmark-excel"></i> Exporter
                        </button>
                        @if (_canFacturationWrite)
                        {
                            <button type="button" class="aw-btn aw-btn--primary"
                                    disabled="@_userPendingClotureToday"
                                    @onclick="@(() => Navigation.NavigateTo("/vente/facturation"))">
                                <i class="bi bi-plus-lg"></i> Nouvelle facture
                            </button>
                        }
                    </div>
                </div>

                @if (_canFacturationWrite && !string.IsNullOrEmpty(_login))
                {
                    <div class="vente-encaissement-bar">
                        <EncaissementDailyStrip @ref="_dailyStrip" Login="@_login" Compact="true" DisplayTaux="_displayTaux" />
                    </div>
                }

                @if (_factData.Any(r => r.EstCloturee) && _factData.Any(r => r.ApresCloture))
                {
                    <div class="aw-empty" style="min-height:auto;padding:0.5rem 0.85rem;flex-direction:row;gap:0.5rem;justify-content:flex-start;margin-bottom:0.75rem;">
                        <i class="bi bi-layout-split" aria-hidden="true"></i>
                        <p style="margin:0;font-size:0.85rem;">
                            <strong>@fCloturees</strong> facture(s) déjà clôturée(s) ·
                            <strong>@fApresCloture</strong> à inclure dans la prochaine clôture
                        </p>
                    </div>
                }

                @if (_factLoading)
                {
                    <div class="aw-table-region">
                        <AwSkeleton Variant="table" Rows="5" />
                    </div>
                }
                else if (!factPageItems.Any())
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-receipt"></i>
                            <p>Aucune facture pour ces filtres.</p>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var factSection in GetFactDisplaySections(factPageItems))
                    {
                        @if (factSection.ShowHeader)
                        {
                            <div style="display:flex;align-items:center;gap:0.5rem;margin:0.5rem 0 0.35rem;">
                                <span class="aw-badge @factSection.BadgeClass"><i class="bi @factSection.Icon" aria-hidden="true"></i>@factSection.Title</span>
                                <span class="aw-table__meta">@factSection.Count facture(s)</span>
                            </div>
                        }
                        <div class="aw-table-region" @key="@($"{UserCurrency.DisplayRevision}-{factSection.Key}")"
                             style="@factSection.GridStyle">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>N° / Date</th>
                                            <th>Client / Articles</th>
                                            <th>Qté</th>
                                            <th>Montant</th>
                                            <th>Statut</th>
                                            <th>Opérateur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in factSection.Rows)
                                        {
                                            var (flbl, fbadge, ficon) = item.DisplayStatus switch
                                            {
                                                0 => ("Brouillon", "aw-badge--muted", "bi-pencil"),
                                                1 => ("Validée", "aw-badge--brand", "bi-check2"),
                                                2 => ("Payée", "aw-badge--brand", "bi-check-circle"),
                                                3 => ("Annulée", "aw-badge--danger", "bi-x-circle"),
                                                4 => ("Partiel", "aw-badge--accent", "bi-hourglass-split"),
                                                _ => ("—", "aw-badge--muted", "bi-question")
                                            };
                                            <tr @onclick="@(() => OnFactRowClick(item))" style="cursor:pointer;">
                                                <td>
                                                    <span class="aw-table__title">N° @item.Id</span>
                                                    <span class="aw-table__meta">@item.Date.ToString("dd/MM/yyyy")</span>
                                                </td>
                                                <td>
                                                    <span class="aw-table__title">@item.Client</span>
                                                    <span class="aw-table__meta">@item.Articles</span>
                                                </td>
                                                <td><span class="aw-badge aw-badge--muted">@item.TotalQte.ToString("N0")</span></td>
                                                <td>
                                                    <span class="aw-table__title">@FactFcUsdDisplay(item.Total, item.Taux)</span>
                                                    @if (item.Paye > 0)
                                                    {
                                                        <span class="aw-table__meta" style="color:var(--aw-brand);">Payé : @FactFcUsdDisplay(item.Paye, item.Taux)</span>
                                                    }
                                                    @if (item.DisplayStatus >= 1 && item.DisplayStatus != 3 && item.Solde > 0)
                                                    {
                                                        <span class="aw-table__meta" style="color:var(--aw-danger);">Reste : @FactFcUsdDisplay(item.Solde, item.Taux)</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="aw-badge @fbadge"><i class="bi @ficon" aria-hidden="true"></i>@flbl</span>
                                                    @if (item.EstCloturee)
                                                    {
                                                        <span class="aw-badge aw-badge--muted"><i class="bi bi-lock-fill" aria-hidden="true"></i>Clôturée</span>
                                                    }
                                                    else if (item.ApresCloture)
                                                    {
                                                        <span class="aw-badge aw-badge--brand"><i class="bi bi-plus-circle" aria-hidden="true"></i>Nouvelle période</span>
                                                    }
                                                    else if (item.ClotureEnAttente)
                                                    {
                                                        <span class="aw-badge aw-badge--accent"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Clôture en attente</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="aw-table__meta"><i class="bi bi-person-circle" aria-hidden="true"></i> @item.Login</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    <AwPager TotalCount="_factFiltered.Count"
                             Page="_factPage"
                             PageSize="_factPageSize"
                             ItemLabel="facture"
                             PageChanged="SetFactPage"
                             PageSizeChanged="SetFactPageSize" />
                }
            }

            @* ══════════════════ LIVRAISONS ══════════════════ *@
            @if (_tab == 1 && _canLivraisonRead)
            {
                var livPayees = _livData.Count(IsLivPaid);
                var livEnAttente = _livData.Count(IsLivPending);
                var livEnCours = _livData.Count - livPayees - livEnAttente;
                var livDonePct = _livData.Count == 0 ? 0d : Math.Round(100d * livPayees / _livData.Count, 1);
                var livCoverTone = livEnAttente == 0 ? "brand" : "accent";
                var livPageItems = PageOf(_livFiltered, _livPage, _livPageSize).ToList();

                @if (_livData.Any())
                {
                    <section class="aw-overview aw-overview--with-cover" aria-label="Vue d'ensemble livraisons">
                        <div class="aw-overview__top">
                            <div class="aw-overview__intro">
                                <h2 class="aw-overview__title">Vue d'ensemble</h2>
                                <p class="aw-overview__lead">
                                    Suivi des livraisons clients : attente, facturation et paiement.
                                </p>
                            </div>
                            <div class="@($"aw-overview__cover aw-overview__cover--{livCoverTone}")">
                                <span class="aw-overview__cover-value">@livDonePct.ToString("0.#")&nbsp;%</span>
                                <span class="aw-overview__cover-label">livraisons payées</span>
                            </div>
                        </div>
                        <div class="aw-overview__meter" role="meter"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)livDonePct)"
                             aria-label="Part des livraisons payées">
                            <div class="aw-overview__meter-track">
                                <div class="@($"aw-overview__meter-fill aw-overview__meter-fill--{livCoverTone}")"
                                     style="width: @(livDonePct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                        <div class="aw-overview__metrics">
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">En attente</span>
                                    <span class="aw-overview__metric-value">@livEnAttente</span>
                                    <span class="aw-overview__metric-hint">À livrer / facturer</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-truck"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">En cours</span>
                                    <span class="aw-overview__metric-value">@livEnCours</span>
                                    <span class="aw-overview__metric-hint">Livrées / partielles</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Payées</span>
                                    <span class="aw-overview__metric-value">@livPayees</span>
                                    <span class="aw-overview__metric-hint">Soldées</span>
                                </div>
                            </article>
                        </div>
                    </section>
                }

                <div class="aw-actionbar">
                    <div class="aw-actionbar__search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <AwDebouncedInput Placeholder="Rechercher n°, client, porteur…"
                                          AriaLabel="Rechercher une livraison"
                                          Value="@_livSearch"
                                          ValueChanged="OnLivSearchChanged" />
                    </div>
                    <div class="aw-actionbar__filters">
                        @if (_livData.Any())
                        {
                            <AwSearchSelect AriaLabel="Statut de la livraison"
                                            Placeholder="Statut"
                                            Searchable="false"
                                            Value="@_livStatusFilter"
                                            ValueChanged="OnLivStatusFilterChanged"
                                            Options="@GetLivStatusFilterOptions(livEnAttente, livEnCours, livPayees)" />
                        }
                    </div>
                    <div class="aw-actionbar__actions">
                        @if (_canLivraisonWrite)
                        {
                            <button type="button" class="aw-btn aw-btn--primary"
                                    disabled="@_userPendingClotureToday" @onclick="OnAddLivraison">
                                <i class="bi bi-truck"></i> Nouvelle livraison
                            </button>
                        }
                    </div>
                </div>

                @if (_livLoading)
                {
                    <div class="aw-table-region">
                        <AwSkeleton Variant="table" Rows="5" />
                    </div>
                }
                else if (!livPageItems.Any())
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-truck"></i>
                            <p>Aucune livraison pour ces filtres.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                        <div class="aw-table-wrap">
                            <table class="aw-table">
                                <thead>
                                    <tr>
                                        <th>N° / Date</th>
                                        <th>Client</th>
                                        <th>Commande / Porteur</th>
                                        <th>Montant</th>
                                        <th>Statut</th>
                                        <th>Facture</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in livPageItems)
                                    {
                                        string llbl; string lbadge; string licon;
                                        if (item.Fact != null)
                                        {
                                            var fTotal = (double)(item.Fact.TotalApresReduction ?? item.Fact.Total ?? 0);
                                            var fPaye = item.Fact.Payments?.Sum(p => (double)p.Montant) ?? 0;
                                            if (fPaye >= fTotal && fTotal > 0) { llbl = "Payée"; lbadge = "aw-badge--brand"; licon = "bi-check-circle"; }
                                            else if (fPaye > 0) { llbl = "Partiel"; lbadge = "aw-badge--accent"; licon = "bi-hourglass-split"; }
                                            else { llbl = "Facturée"; lbadge = "aw-badge--brand"; licon = "bi-receipt"; }
                                        }
                                        else
                                        {
                                            (llbl, lbadge, licon) = (item.Status ?? 0) switch
                                            {
                                                1 => ("Livrée", "aw-badge--brand", "bi-truck"),
                                                _ => ("En attente", "aw-badge--accent", "bi-hourglass-split")
                                            };
                                        }
                                        var montant = item.Details.Sum(d => d.MontantPaye ?? 0);
                                        <tr @onclick="@(() => OnLivraisonRowClick(item))" style="cursor:pointer;">
                                            <td>
                                                <span class="aw-table__title">N° @item.LivraisonId</span>
                                                <span class="aw-table__meta">@(item.Date?.ToString("dd/MM/yyyy") ?? "—")</span>
                                            </td>
                                            <td>
                                                @if (item.Customer != null)
                                                {
                                                    <span class="aw-table__title">@item.Customer.CustomerName</span>
                                                }
                                                else
                                                {
                                                    <span class="aw-table__meta">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.CommandeId.HasValue)
                                                {
                                                    <span class="aw-badge aw-badge--muted">C-@item.CommandeId</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.Porteur))
                                                {
                                                    <span class="aw-table__meta"><i class="bi bi-person" aria-hidden="true"></i> @item.Porteur</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="aw-table__title"><CurrencyText Mode="@CurrencyText.DisplayMode.FromFcStored" Amount="montant" Taux="_displayTaux" /></span>
                                                <span class="aw-table__meta">@item.Details.Count article@(item.Details.Count > 1 ? "s" : "")</span>
                                            </td>
                                            <td>
                                                <span class="aw-badge @lbadge"><i class="bi @licon" aria-hidden="true"></i>@llbl</span>
                                            </td>
                                            <td>
                                                @if (item.Fact != null)
                                                {
                                                    <span class="aw-badge aw-badge--brand">F-@item.Fact.Id</span>
                                                }
                                                else
                                                {
                                                    <span class="aw-table__meta">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <AwPager TotalCount="_livFiltered.Count"
                                 Page="_livPage"
                                 PageSize="_livPageSize"
                                 ItemLabel="livraison"
                                 PageChanged="SetLivPage"
                                 PageSizeChanged="SetLivPageSize" />
                    </div>
                }
            }

            @* ══════════════════ PAIEMENTS ══════════════════ *@
            @if (_tab == 2 && _canPaiementRead)
            {
                var payImpayees = _payData.Count(p => p.Reste > 0 && p.Facture.Status != 3);
                var payPayees = _payData.Count - payImpayees;
                var payDonePct = _payData.Count == 0 ? 0d : Math.Round(100d * payPayees / _payData.Count, 1);
                var payCoverTone = payImpayees == 0 ? "brand" : "accent";
                var payPageItems = PageOf(_payFiltered, _payPage, _payPageSize).ToList();

                @if (_payData.Any())
                {
                    <section class="aw-overview aw-overview--with-cover" aria-label="Vue d'ensemble paiements">
                        <div class="aw-overview__top">
                            <div class="aw-overview__intro">
                                <h2 class="aw-overview__title">Vue d'ensemble</h2>
                                <p class="aw-overview__lead">
                                    Suivi des encaissements : soldes et paiements partiels.
                                </p>
                            </div>
                            <div class="@($"aw-overview__cover aw-overview__cover--{payCoverTone}")">
                                <span class="aw-overview__cover-value">@payImpayees</span>
                                <span class="aw-overview__cover-label">impayée(s)</span>
                            </div>
                        </div>
                        <div class="aw-overview__meter" role="meter"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)payDonePct)"
                             aria-label="Part des factures soldées">
                            <div class="aw-overview__meter-track">
                                <div class="@($"aw-overview__meter-fill aw-overview__meter-fill--{payCoverTone}")"
                                     style="width: @(payDonePct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                        <div class="aw-overview__metrics">
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-exclamation-circle"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Impayées</span>
                                    <span class="aw-overview__metric-value">@payImpayees</span>
                                    <span class="aw-overview__metric-hint">Reste à encaisser</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Soldées</span>
                                    <span class="aw-overview__metric-value">@payPayees</span>
                                    <span class="aw-overview__metric-hint">Payées intégralement</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-cash-stack"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Total</span>
                                    <span class="aw-overview__metric-value">@_payData.Count</span>
                                    <span class="aw-overview__metric-hint">Factures suivies</span>
                                </div>
                            </article>
                        </div>
                    </section>
                }

                <div class="aw-actionbar">
                    <div class="aw-actionbar__search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <AwDebouncedInput Placeholder="Rechercher facture, client…"
                                          AriaLabel="Rechercher un paiement"
                                          Value="@_paySearch"
                                          ValueChanged="OnPaySearchChanged" />
                    </div>
                    <div class="aw-actionbar__filters">
                        @if (_payData.Any())
                        {
                            <AwSearchSelect AriaLabel="Statut du paiement"
                                            Placeholder="Statut"
                                            Searchable="false"
                                            Value="@_payStatusFilter"
                                            ValueChanged="OnPayStatusFilterChanged"
                                            Options="@GetPayStatusFilterOptions(payImpayees, payPayees)" />
                        }
                    </div>
                </div>

                @if (_payLoading)
                {
                    <div class="aw-table-region">
                        <AwSkeleton Variant="table" Rows="5" />
                    </div>
                }
                else if (!payPageItems.Any())
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-cash"></i>
                            <p>Aucun paiement pour ces filtres.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                        <div class="aw-table-wrap">
                            <table class="aw-table">
                                <thead>
                                    <tr>
                                        <th style="width:2.5rem;"></th>
                                        <th>Facture / Client</th>
                                        <th>Origine</th>
                                        <th>Montant</th>
                                        <th>Reste</th>
                                        <th>Statut</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in payPageItems)
                                    {
                                        var taux = item.Facture.Taux > 0 ? item.Facture.Taux : _displayTaux;
                                        var expanded = _payExpandedIds.Contains(item.Facture.Id);
                                        <tr>
                                            <td>
                                                <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon"
                                                        title="@(expanded ? "Masquer l'historique" : "Voir l'historique")"
                                                        @onclick="@(() => TogglePayExpand(item.Facture.Id))"
                                                        @onclick:stopPropagation="true">
                                                    <i class="bi @(expanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <span class="aw-table__title">F-@item.Facture.Id</span>
                                                <span class="aw-table__meta">@item.ClientName</span>
                                            </td>
                                            <td>
                                                @if (item.Facture.CommandeId.HasValue)
                                                {
                                                    <span class="aw-badge aw-badge--muted">Cmd N° @item.Facture.CommandeId</span>
                                                }
                                                else
                                                {
                                                    <span class="aw-badge aw-badge--muted">Vente directe</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="aw-table__title"><CurrencyText Mode="@CurrencyText.DisplayMode.FromFcStored" Amount="(item.Facture.TotalApresReduction ?? item.Facture.Total ?? 0)" Taux="taux" /></span>
                                                <span class="aw-table__meta" style="color:var(--aw-brand);">Payé : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.FromFcStored" Amount="item.TotalPaye" Taux="taux" /></span>
                                            </td>
                                            <td>
                                                <span class="aw-badge @(item.Reste <= 0 ? "aw-badge--brand" : "aw-badge--danger")">
                                                    <CurrencyText Mode="@CurrencyText.DisplayMode.FromFcStored" Amount="item.Reste" Taux="taux" />
                                                </span>
                                            </td>
                                            <td>
                                                @if (item.Facture.Status == 3)
                                                {
                                                    <span class="aw-badge aw-badge--danger"><i class="bi bi-x-circle" aria-hidden="true"></i>Annulée</span>
                                                }
                                                else if (item.Reste <= 0 || (item.IsDirectSale && item.Facture.Status is 1 or 2))
                                                {
                                                    <span class="aw-badge aw-badge--brand"><i class="bi bi-check-circle" aria-hidden="true"></i>Payée</span>
                                                }
                                                else if (item.TotalPaye > 0)
                                                {
                                                    <span class="aw-badge aw-badge--accent"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Partiel</span>
                                                }
                                                else
                                                {
                                                    <span class="aw-badge aw-badge--danger"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>Impayée</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.Reste > 0 && _canFacturationWrite)
                                                {
                                                    <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm"
                                                            title="Enregistrer un paiement"
                                                            @onclick="@(() => OnPayerPaiement(item))"
                                                            @onclick:stopPropagation="true">
                                                        <i class="bi bi-cash-coin"></i> Payer
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                        @if (expanded)
                                        {
                                            <tr>
                                                <td colspan="7" style="background:var(--aw-surface-2, #f8fafc);padding:0.75rem 1rem;">
                                                    @if (item.Payments.Any())
                                                    {
                                                        <div class="aw-table__meta" style="font-weight:600;margin-bottom:0.35rem;">Historique des paiements</div>
                                                        <div class="aw-table-wrap">
                                                            <table class="aw-table">
                                                                <thead>
                                                                    <tr>
                                                                        <th>N°</th>
                                                                        <th>Date</th>
                                                                        <th style="text-align:right;">Montant</th>
                                                                        <th>Note</th>
                                                                        <th>Utilisateur</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var p in item.Payments)
                                                                    {
                                                                        <tr>
                                                                            <td>@p.Id</td>
                                                                            <td>@p.Date.ToString("dd/MM/yyyy")</td>
                                                                            <td style="text-align:right;">@UserCurrency.FormatPayment(p, taux)</td>
                                                                            <td>@p.Note</td>
                                                                            <td>@p.User</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="aw-table__meta">Aucun paiement enregistré.</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        <AwPager TotalCount="_payFiltered.Count"
                                 Page="_payPage"
                                 PageSize="_payPageSize"
                                 ItemLabel="facture"
                                 PageChanged="SetPayPage"
                                 PageSizeChanged="SetPayPageSize" />
                    </div>
                }
            }

            @* ══════════════════ CLÔTURES ══════════════════ *@
            @if (_tab == 3 && _canFacturationWrite)
            {
                var clotApprouvees = _clotureData.Count(c => c.StatutCloture == 1);
                var clotEnAttente = _clotureData.Count(c => c.StatutCloture == 0);
                var clotRejetees = _clotureData.Count(c => c.StatutCloture == 2);
                var clotDonePct = _clotureData.Count == 0 ? 0d : Math.Round(100d * clotApprouvees / _clotureData.Count, 1);
                var clotCoverTone = clotEnAttente == 0 ? "brand" : "accent";
                var clotPageItems = PageOf(_clotureFiltered, _cloturePage, _cloturePageSize).ToList();

                @if (_clotureData.Any())
                {
                    <section class="aw-overview aw-overview--with-cover" aria-label="Vue d'ensemble clôtures">
                        <div class="aw-overview__top">
                            <div class="aw-overview__intro">
                                <h2 class="aw-overview__title">Vue d'ensemble</h2>
                                <p class="aw-overview__lead">
                                    Clôtures journalières : soumissions, approbations et rejets.
                                </p>
                            </div>
                            <div class="@($"aw-overview__cover aw-overview__cover--{clotCoverTone}")">
                                <span class="aw-overview__cover-value">@clotEnAttente</span>
                                <span class="aw-overview__cover-label">en attente</span>
                            </div>
                        </div>
                        <div class="aw-overview__meter" role="meter"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)clotDonePct)"
                             aria-label="Part des clôtures approuvées">
                            <div class="aw-overview__meter-track">
                                <div class="@($"aw-overview__meter-fill aw-overview__meter-fill--{clotCoverTone}")"
                                     style="width: @(clotDonePct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                        <div class="aw-overview__metrics">
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">En attente</span>
                                    <span class="aw-overview__metric-value">@clotEnAttente</span>
                                    <span class="aw-overview__metric-hint">À modérer</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Approuvées</span>
                                    <span class="aw-overview__metric-value">@clotApprouvees</span>
                                    <span class="aw-overview__metric-hint">Validées</span>
                                </div>
                            </article>
                            <article class="aw-overview__metric">
                                <span class="aw-overview__icon aw-overview__icon--danger" aria-hidden="true"><i class="bi bi-x-circle"></i></span>
                                <div class="aw-overview__metric-body">
                                    <span class="aw-overview__metric-label">Rejetées</span>
                                    <span class="aw-overview__metric-value">@clotRejetees</span>
                                    <span class="aw-overview__metric-hint">À refaire</span>
                                </div>
                            </article>
                        </div>
                    </section>
                }

                <div class="aw-actionbar">
                    <div class="aw-actionbar__filters">
                        @if (_clotureData.Any())
                        {
                            <AwSearchSelect AriaLabel="Statut de la clôture"
                                            Placeholder="Statut"
                                            Searchable="false"
                                            Value="@_clotureStatusFilter"
                                            ValueChanged="OnClotureStatusFilterChanged"
                                            Options="@GetClotureStatusFilterOptions(clotEnAttente, clotApprouvees, clotRejetees)" />
                        }
                        @if (_userLocalisations.Count > 1)
                        {
                            <AwSearchSelect AriaLabel="Localisation"
                                            Placeholder="Localisation"
                                            Searchable="false"
                                            Value="@(_clotureLocFilter?.ToString() ?? "")"
                                            ValueChanged="OnClotureLocFilterChanged"
                                            Options="@GetClotureLocFilterOptions()" />
                        }
                    </div>
                    <div class="aw-actionbar__actions">
                        <button type="button" class="aw-btn aw-btn--primary"
                                disabled="@_userPendingClotureToday" @onclick="OnCloturer">
                            <i class="bi bi-calendar-check"></i> Clôturer la journée
                        </button>
                    </div>
                </div>

                @if (_clotureLoading)
                {
                    <div class="aw-table-region">
                        <AwSkeleton Variant="table" Rows="5" />
                    </div>
                }
                else if (!clotPageItems.Any())
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-calendar-check"></i>
                            <p>Aucune clôture pour ces filtres.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                        <div class="aw-table-wrap">
                            <table class="aw-table">
                                <thead>
                                    <tr>
                                        <th>Date / Heure</th>
                                        <th>Localisation</th>
                                        <th>Type</th>
                                        <th>Montant</th>
                                        <th>Destination</th>
                                        <th>Ventes</th>
                                        <th>Utilisateur</th>
                                        <th>Statut</th>
                                        <th>Traitement</th>
                                        @if (_showClotureActions)
                                        {
                                            <th>Actions</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in clotPageItems)
                                    {
                                        var isMine = string.Equals(item.UserLogin, _login, StringComparison.OrdinalIgnoreCase);
                                        var ventes = item.NombreOperations;
                                        <tr>
                                            <td>
                                                <span class="aw-table__title">@item.DateCloture.ToString("dd/MM/yyyy")</span>
                                                <span class="aw-table__meta">@item.HeureCloture.ToString("HH:mm")</span>
                                            </td>
                                            <td>
                                                <span class="aw-table__meta"><i class="bi bi-geo-alt" aria-hidden="true"></i> @(item.Localisation?.DescriptionLocalisation ?? "—")</span>
                                            </td>
                                            <td>@item.TypeOperation</td>
                                            <td>
                                                <span class="aw-table__title" style="color:var(--aw-brand);"><CurrencyText Mode="@CurrencyText.DisplayMode.FromFcStored" Amount="item.Montant" Taux="_displayTaux" /></span>
                                            </td>
                                            <td>@item.ModeVersement</td>
                                            <td>
                                                <span class="aw-badge aw-badge--muted" title="Nombre de factures payées incluses dans la clôture">
                                                    @ventes vente@(ventes > 1 ? "s" : "")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="aw-table__meta"><i class="bi bi-person-circle" aria-hidden="true"></i> @item.UserLogin</span>
                                            </td>
                                            <td>
                                                @switch (item.StatutCloture)
                                                {
                                                    case 0:
                                                        <span class="aw-badge aw-badge--accent" title="En attente d'approbation par un autre utilisateur">
                                                            <i class="bi bi-hourglass-split" aria-hidden="true"></i>En attente
                                                        </span>
                                                        break;
                                                    case 1:
                                                        <span class="aw-badge aw-badge--brand"><i class="bi bi-check-circle" aria-hidden="true"></i>Approuvée</span>
                                                        break;
                                                    case 2:
                                                        <span class="aw-badge aw-badge--danger" title="@item.MotifRejet"><i class="bi bi-x-circle" aria-hidden="true"></i>Rejetée</span>
                                                        break;
                                                }
                                                @if (isMine && item.DateCloture == DateOnly.FromDateTime(DateTime.Today))
                                                {
                                                    <span class="aw-badge aw-badge--muted">Ma clôture</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.StatutCloture == 0)
                                                {
                                                    <span class="aw-table__meta">—</span>
                                                }
                                                else
                                                {
                                                    <span class="aw-table__meta">@item.TraitePar</span>
                                                    @if (item.DateTraitement.HasValue)
                                                    {
                                                        <span class="aw-table__meta">@item.DateTraitement.Value.ToString("dd/MM HH:mm")</span>
                                                    }
                                                }
                                            </td>
                                            @if (_showClotureActions)
                                            {
                                                <td>
                                                    @if (CanModerateCloture(item) && item.StatutCloture == 0)
                                                    {
                                                        <div style="display:flex;gap:0.25rem;">
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm" title="Approuver"
                                                                    @onclick="@(() => OnApprouverCloture(item))">
                                                                <i class="bi bi-check-circle" style="color:var(--aw-brand);"></i>
                                                            </button>
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm" title="Rejeter"
                                                                    @onclick="@(() => OnRejeterCloture(item))">
                                                                <i class="bi bi-x-circle" style="color:var(--aw-danger);"></i>
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (item.StatutCloture != 0)
                                                    {
                                                        <span class="aw-table__meta">Traité</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="aw-table__meta">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <AwPager TotalCount="_clotureFiltered.Count"
                                 Page="_cloturePage"
                                 PageSize="_cloturePageSize"
                                 ItemLabel="clôture"
                                 PageChanged="SetCloturePage"
                                 PageSizeChanged="SetCloturePageSize" />
                    </div>
                }
            }

            </div>
        </div>
    </div>
    }
}

</ModuleGuard>

@code {
    /* ── Hub ── */
    int _tab;
    bool _loaded;
    Periode? _activePeriode;
    bool _hasSalesReadAccess;
    bool _canVenteRead;
    bool _canFacturationRead;
    bool _canLivraisonRead;
    bool _canPaiementRead;
    bool _canFacturationWrite;
    bool _canFacturationDelete;
    bool _canLivraisonWrite;
    bool _canLivraisonDelete;
    List<int> _currentUserLocalisations = new();

    static readonly int[] PageSizeChoices = [10, 25, 50, 100];

    /* ── Facture state ── */
    List<FactRowDto> _factData = new();
    bool _factLoading;
    bool _factLoadedOnce;
    string _factSearch = "";
    int? _factStatusFilter;
    string _factClotureFilter = "all";
    int _factPage = 1;
    int _factPageSize = 25;

    List<FactRowDto> _factFiltered = new();

    void SetFactStatusFilter(int? status)
    {
        _factStatusFilter = status;
        if (!status.HasValue)
            _factClotureFilter = "all";
        ApplyFactFilter();
    }

    void SetFactClotureFilter(string filter)
    {
        _factClotureFilter = filter;
        ApplyFactFilter();
    }

    Task OnFactStatusFilterChanged(string? value)
    {
        SetFactStatusFilter(int.TryParse(value, out var st) ? st : null);
        return Task.CompletedTask;
    }

    Task OnFactClotureFilterChanged(string? value)
    {
        SetFactClotureFilter(string.IsNullOrWhiteSpace(value) ? "all" : value);
        return Task.CompletedTask;
    }

    List<AwSearchSelect.Option> GetFactStatusFilterOptions(int brouillon, int validee, int payee, int partiel)
    {
        var list = new List<AwSearchSelect.Option>
        {
            new("", $"Statut : tous ({_factData.Count})"),
            new("0", $"Brouillon ({brouillon})"),
            new("1", $"Validées ({validee})"),
            new("2", $"Payées ({payee})")
        };
        if (partiel > 0)
            list.Add(new("4", $"Partiel ({partiel})"));
        return list;
    }

    List<AwSearchSelect.Option> GetFactClotureFilterOptions(int cloturees, int apres)
    {
        var list = new List<AwSearchSelect.Option>
        {
            new("all", "Clôture : toutes")
        };
        if (cloturees > 0)
            list.Add(new("closed", $"Clôturées ({cloturees})"));
        if (apres > 0)
            list.Add(new("new", $"Nouvelle période ({apres})"));
        return list;
    }

    void ApplyFactFilter()
    {
        _factFiltered = _factData.Where(r =>
        {
            if (_factStatusFilter.HasValue && r.DisplayStatus != _factStatusFilter.Value)
                return false;
            if (_factClotureFilter == "closed" && !r.EstCloturee)
                return false;
            if (_factClotureFilter == "new" && !r.ApresCloture)
                return false;
            if (!string.IsNullOrWhiteSpace(_factSearch))
            {
                var s = _factSearch.Trim();
                return r.Id.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
                    || r.Client.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || r.Articles.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || r.Login.Contains(s, StringComparison.OrdinalIgnoreCase);
            }
            return true;
        }).ToList();
        _factPage = 1;
    }

    void OnFactSearchChanged(string value)
    {
        _factSearch = value ?? "";
        ApplyFactFilter();
    }

    sealed record FactDisplaySection(
        string Key,
        string Title,
        string BadgeClass,
        string Icon,
        string GridStyle,
        bool ShowHeader,
        int Count,
        List<FactRowDto> Rows);

    IEnumerable<FactDisplaySection> GetFactDisplaySections(IList<FactRowDto>? pageRows = null)
    {
        var hasClosed = _factFiltered.Any(r => r.EstCloturee);
        var hasNew = _factFiltered.Any(r => r.ApresCloture);
        var split = hasClosed && hasNew && _factClotureFilter == "all";
        var source = pageRows ?? _factFiltered;

        if (!split)
        {
            yield return new FactDisplaySection("all", "", "", "", "", false, source.Count, source.ToList());
            yield break;
        }

        var closed = source.Where(r => r.EstCloturee).ToList();
        var post = source.Where(r => r.ApresCloture).ToList();
        var other = source.Where(r => !r.EstCloturee && !r.ApresCloture).ToList();

        if (post.Any())
        {
            yield return new FactDisplaySection(
                "new", "Nouvelle période — à clôturer", "aw-badge--brand", "bi-plus-circle",
                "border-left:3px solid var(--aw-brand);", true, post.Count, post);
        }

        if (closed.Any())
        {
            yield return new FactDisplaySection(
                "closed", "Période clôturée", "aw-badge--muted", "bi-lock-fill",
                "opacity:.92;", true, closed.Count, closed);
        }

        if (other.Any())
        {
            yield return new FactDisplaySection(
                "other", "Autres factures", "aw-badge--muted", "bi-receipt",
                "", true, other.Count, other);
        }
    }

