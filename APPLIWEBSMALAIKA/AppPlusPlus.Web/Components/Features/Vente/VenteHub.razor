    IList<T> PageOf<T>(IList<T> items, int page, int pageSize) =>
        items.Skip((page - 1) * pageSize).Take(pageSize).ToList();

    int PageCount(int total, int pageSize) =>
        total <= 0 ? 1 : (int)Math.Ceiling(total / (double)Math.Max(1, pageSize));

    void SetFactPage(int page) =>
        _factPage = Math.Clamp(page, 1, PageCount(_factFiltered.Count, _factPageSize));

    void SetFactPageSize(int size)
    {
        if (!PageSizeChoices.Contains(size)) return;
        _factPageSize = size;
        _factPage = 1;
    }

    void SetLivPage(int page) =>
        _livPage = Math.Clamp(page, 1, PageCount(_livFiltered.Count, _livPageSize));

