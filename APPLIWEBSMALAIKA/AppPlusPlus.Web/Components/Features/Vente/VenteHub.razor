    async Task OnFactRowClick(FactRowDto item)
    {
        var parameters = new DialogParameters<FactureDetail>
        {
            { x => x.FactId, item.Id },
            { x => x.DisplayStatus, item.DisplayStatus },
            { x => x.CanWrite, _canFacturationWrite },
