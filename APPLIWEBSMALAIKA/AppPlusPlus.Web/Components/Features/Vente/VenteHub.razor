    void TogglePayExpand(int factId)
    {
        if (!_payExpandedIds.Add(factId))
            _payExpandedIds.Remove(factId);
    }

    void ApplyPayFilter()
    {
        _payFiltered = _payData.Where(p =>
        {
            if (_payStatusFilter == "unpaid" && (p.Reste <= 0 || p.Facture.Status == 3)) return false;
            if (_payStatusFilter == "paid" && (p.Reste > 0 && p.Facture.Status != 3)) return false;
            if (!string.IsNullOrWhiteSpace(_paySearch))
            {
                var s = _paySearch.Trim();
                return p.Facture.Id.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (p.ClientName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (p.Facture.CommandeId?.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
            }
            return true;
        }).ToList();
        _payPage = 1;
    }

    void OnPaySearchChanged(string value)
    {
        _paySearch = value ?? "";
        ApplyPayFilter();
    }

    async Task OnPayerPaiement(FactureViewDto fv)
    {
        if (!_canPaiementRead)
        {
            Snackbar.Add("Lecture paiements non autorisée.", Severity.Warning);
            return;
        }

        if (!_canFacturationWrite)
        {
            Snackbar.Add("Paiement non autorisé.", Severity.Warning);
            return;
        }

        var factTaux = fv.Facture.Taux > 0 ? fv.Facture.Taux : _displayTaux;
        var factIsUsd = CurrencyFormat.IsUsd(fv.Facture.Money?.DescriptionMonais);
        var parameters = new DialogParameters<PaiementForm>
        {
            { x => x.CommandeId, fv.Facture.CommandeId ?? 0 },
            { x => x.FactId, fv.Facture.Id },
            { x => x.MontantRest, fv.Reste },
            { x => x.FactTaux, factTaux },
            { x => x.FactIsUsd, factIsUsd }
        };
        var options = new MudBlazor.DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<PaiementForm>(
            $"Paiement — Facture F-{fv.Facture.Id}", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled) await LoadPaiements();
    }

    /* ════════════════════════════════════════════════════════════
       CLÔTURES
       ════════════════════════════════════════════════════════════ */

    async Task RefreshClotureUserStateAsync()
    {
        try
        {
            _userPendingClotureToday = await ClotureService.HasUserClosedTodayAsync(_login, _currentUserLocalisations);
            var today = DateOnly.FromDateTime(DateTime.Today);
            _myTodayApprovedCloture = _clotureData
                .Where(v => v.DateCloture == today
                    && v.StatutCloture == 1
                    && string.Equals(v.UserLogin, _login, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(v => v.DateTraitement ?? v.HeureCloture)
                .FirstOrDefault();
        }
        catch
        {
            _userPendingClotureToday = false;
            _myTodayApprovedCloture = null;
        }
    }

    async Task LoadClotures()
    {
        _clotureLoading = true;
        var locIds = _currentUserLocalisations.Any()
            ? _currentUserLocalisations
            : _userLocalisations.Select(l => l.IdLocalisation).ToList();
        _clotureData = await ClotureService.GetCloturesByLocalisationsAsync(locIds);
        _clotureLoading = false;
        ApplyClotureFilter();
        await RefreshClotureUserStateAsync();
    }

    bool CanModerateCloture(Versement v)
    {
        if (v.StatutCloture != 0) return false;
        if (string.Equals(v.UserLogin, _login, StringComparison.OrdinalIgnoreCase))
            return _isAdmin;
        return _isAdmin || _canFacturationWrite;
    }

    void SetClotureStatusFilter(string filter)
    {
        _clotureStatusFilter = filter;
        ApplyClotureFilter();
    }

    Task OnClotureStatusFilterChanged(string? value)
    {
        SetClotureStatusFilter(string.IsNullOrWhiteSpace(value) ? "all" : value);
        return Task.CompletedTask;
    }

    Task OnClotureLocFilterChanged(string? value)
    {
        _clotureLocFilter = int.TryParse(value, out var id) ? id : null;
        ApplyClotureFilter();
        return Task.CompletedTask;
    }

    List<AwSearchSelect.Option> GetClotureStatusFilterOptions(int enAttente, int approuvees, int rejetees)
    {
        var list = new List<AwSearchSelect.Option>
        {
            new("all", $"Statut : toutes ({_clotureData.Count})"),
            new("pending", $"En attente ({enAttente})"),
            new("approved", $"Approuvées ({approuvees})")
        };
        if (rejetees > 0)
            list.Add(new("rejected", $"Rejetées ({rejetees})"));
        return list;
    }

    List<AwSearchSelect.Option> GetClotureLocFilterOptions()
    {
        var list = new List<AwSearchSelect.Option> { new("", "Toutes localisations") };
        foreach (var loc in _userLocalisations)
            list.Add(new(loc.IdLocalisation.ToString(), loc.DescriptionLocalisation ?? $"Loc {loc.IdLocalisation}"));
        return list;
    }

    void ApplyClotureFilter()
    {
        _clotureFiltered = _clotureData.Where(v =>
        {
            if (_clotureLocFilter.HasValue && v.LocalisationId != _clotureLocFilter.Value)
                return false;
            if (_clotureStatusFilter == "pending" && v.StatutCloture != 0) return false;
            if (_clotureStatusFilter == "approved" && v.StatutCloture != 1) return false;
            if (_clotureStatusFilter == "rejected" && v.StatutCloture != 2) return false;
            return true;
        }).ToList();
        _cloturePage = 1;
    }

    async Task OnCloturer()
    {
        if (!_canFacturationWrite) return;
        if (!_userLocalisations.Any())
        {
            Snackbar.Add("Aucune localisation assignée.", Severity.Warning);
            return;
        }

        // Localisation avec activité du jour (ex. Magasin si vente là, pas Depot par défaut)
        var today = DateOnly.FromDateTime(DateTime.Today);
        var locIds = _currentUserLocalisations.Any()
            ? _currentUserLocalisations
            : _userLocalisations.Select(l => l.IdLocalisation).ToList();
        var suggestedLocId = await ClotureService.GetSuggestedLocalisationForClotureAsync(today, locIds)
            ?? _userLocalisations[0].IdLocalisation;
        var selectedLoc = _userLocalisations.FirstOrDefault(l => l.IdLocalisation == suggestedLocId)
            ?? _userLocalisations[0];
        var selectedLocId = selectedLoc.IdLocalisation;
        var selectedLocName = selectedLoc.DescriptionLocalisation ?? "—";

        // Confirmation
        var confirm = await DialogService.ShowMessageBox(
            "Clôture journalière",
            $"Clôturer la journée du {DateOnly.FromDateTime(DateTime.Today):dd/MM/yyyy} pour {selectedLocName} ?",
            yesText: "Continuer",
            cancelText: "Annuler");

        if (confirm != true) return;

        // Ouvrir le dialog de clôture
        var parameters = new DialogParameters<ClotureForm>
        {
            { x => x.LocalisationId, selectedLocId },
            { x => x.LocalisationName, selectedLocName },
            { x => x.UserLogin, _login },
            { x => x.AvailableLocalisations, _userLocalisations.ToList() },
        };
        var options = new MudBlazor.DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<ClotureForm>(
            $"Clôture — {selectedLocName}", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is true)
        {
            await LoadClotures();
            await LoadFactures();
        }
    }

    async Task OnApprouverCloture(Versement v)
    {
        if (!CanModerateCloture(v))
        {
            Snackbar.Add(_isAdmin
                ? "Vous ne pouvez pas approuver votre propre clôture."
                : "Seul un autre utilisateur habilité peut approuver cette clôture.", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Approuver la clôture",
            $"Approuver la clôture du {v.DateCloture:dd/MM/yyyy} par {v.UserLogin} ?",
            yesText: "Approuver",
            cancelText: "Annuler");

        if (confirm != true) return;

        var ok = await ClotureService.UpdateClotureStatutAsync(v.Id, 1, _login);
        if (!ok)
        {
            Snackbar.Add("Impossible de mettre à jour le statut de la clôture.", Severity.Error);
            return;
        }

        await ClotureService.EnsureClotureExpenseAsync(v.Id);
        Snackbar.Add("Clôture approuvée. L'utilisateur peut reprendre ses ventes.", Severity.Success);
        await LoadClotures();
        StateHasChanged();
    }

    async Task OnRejeterCloture(Versement v)
    {
        if (!CanModerateCloture(v))
        {
            Snackbar.Add("Vous ne pouvez pas rejeter votre propre clôture.", Severity.Warning);
            return;
        }

        var motif = await DialogService.ShowMessageBox(
            "Rejeter la clôture",
            (MarkupString)$"Rejeter la clôture du <b>{v.DateCloture:dd/MM/yyyy}</b> par <b>{v.UserLogin}</b> ?<br/><small class='text-muted'>L'utilisateur pourra de nouveau effectuer des transactions.</small>",
            yesText: "Rejeter",
            cancelText: "Annuler");

        if (motif != true) return;

        var ok = await ClotureService.UpdateClotureStatutAsync(v.Id, 2, _login, "Rejetée par l'administrateur");
        if (!ok)
        {
            Snackbar.Add("Impossible de mettre à jour le statut de la clôture.", Severity.Error);
            return;
        }

        Snackbar.Add("Clôture rejetée. L'utilisateur peut reprendre ses transactions.", Severity.Warning);
        await LoadClotures();
        StateHasChanged();
    }

    void OnCurrencyPreferenceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => UserCurrency.OnChanged -= OnCurrencyPreferenceChanged;
