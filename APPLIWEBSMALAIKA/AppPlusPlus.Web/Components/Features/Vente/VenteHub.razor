    List<AwSearchSelect.Option> GetLivStatusFilterOptions(int enAttente, int enCours, int payees) =>
    [
        new("all", $"Statut : toutes ({_livData.Count})"),
        new("pending", $"En attente ({enAttente})"),
        new("progress", $"En cours ({enCours})"),
        new("paid", $"Payées ({payees})")
    ];

    void ApplyLivFilter()
    {
        _livFiltered = _livData.Where(l =>
        {
            if (_livStatusFilter == "pending" && !IsLivPending(l)) return false;
            if (_livStatusFilter == "paid" && !IsLivPaid(l)) return false;
            if (_livStatusFilter == "progress" && (IsLivPending(l) || IsLivPaid(l))) return false;
            if (!string.IsNullOrWhiteSpace(_livSearch))
            {
                var s = _livSearch.Trim();
                return l.LivraisonId.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (l.Customer?.CustomerName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (l.Porteur?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
            }
            return true;
        }).ToList();
        _livPage = 1;
    }

    void OnLivSearchChanged(string value)
    {
        _livSearch = value ?? "";
        ApplyLivFilter();
    }

    static bool IsLivPaid(Livraison l) =>
        l.Fact != null
        && (l.Fact.TotalApresReduction ?? l.Fact.Total ?? 0) > 0
        && (l.Fact.Payments?.Sum(p => (double)p.Montant) ?? 0) >= (double)(l.Fact.TotalApresReduction ?? l.Fact.Total ?? 0);

    static bool IsLivPending(Livraison l) => l.Fact == null && (l.Status ?? 0) != 1;

