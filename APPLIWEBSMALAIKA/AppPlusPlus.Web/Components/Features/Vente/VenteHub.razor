    protected override async Task OnInitializedAsync()
    {
        UserCurrency.OnChanged += OnCurrencyPreferenceChanged;
        await UserCurrency.EnsureLoadedAsync();
        await LoadSecurityAsync();

        try { _activePeriode = await FinanceService.GetActivePeriodeAsync(); } catch { }

        // Vérifier si l'utilisateur a clôturé la journée
        await RefreshClotureUserStateAsync();

        var tauxList = await FinanceService.GetTauxAsync();
        _displayTaux = tauxList.OrderByDescending(t => t.Id).FirstOrDefault()?.TauxValue ?? 0;

        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var savedTab = await JS.InvokeAsync<int>("tabNavigation.getTab", "vente", ResolveDefaultTab());
            if (IsTabAllowed(savedTab))
                _tab = savedTab;
            else
                _tab = ResolveDefaultTab();
        }
        catch
        {
            _tab = ResolveDefaultTab();
        }

        await LoadActiveTabAsync();
        await InvokeAsync(StateHasChanged);
    }

    int ResolveDefaultTab()
    {
        if (_canFacturationRead) return 0;
        if (_canLivraisonRead) return 1;
        if (_canPaiementRead) return 2;
        if (_canFacturationWrite) return 3;
        return 0;
    }

    bool IsTabAllowed(int tab) => tab switch
    {
        0 => _canFacturationRead,
        1 => _canLivraisonRead,
        2 => _canPaiementRead,
        3 => _canFacturationWrite,
        _ => false
    };

    async Task LoadActiveTabAsync()
    {
        switch (_tab)
        {
            case 0 when _canFacturationRead && !_factLoadedOnce:
                await LoadFactures();
                _factLoadedOnce = true;
                break;
            case 1 when _canLivraisonRead && !_livLoadedOnce:
                await LoadLivraisons();
                _livLoadedOnce = true;
                break;
            case 2 when _canPaiementRead && !_payLoadedOnce:
                await LoadPaiements();
                _payLoadedOnce = true;
                break;
            case 3 when _canFacturationWrite && !_clotureLoadedOnce:
                await LoadClotures();
                _clotureLoadedOnce = true;
                break;
        }
    }

    async Task OnTabChange(int tabIndex)
    {
        _tab = tabIndex;
        try
        {
            await JS.InvokeVoidAsync("tabNavigation.saveTab", "vente", tabIndex);
        }
        catch { }

        await LoadActiveTabAsync();
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadSecurityAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            _hasSalesReadAccess = false;
            return;
        }

        var login = user.FindFirst("login")?.Value
            ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        _login = login ?? "";

        var permissions = await PermissionResolver.GetPermissionsAsync(login);
        var isAdmin = AppFunctions.Normalize(user.FindFirst(ClaimTypes.Role)?.Value) == "administrateur";
        _isAdmin = isAdmin;

        _canVenteRead = PermissionGate.ViewTab(permissions, "vente",
            () => PermissionGate.LegacyRead(permissions, AppFunctions.Vente, isAdmin));
        _canFacturationRead = PermissionGate.ViewSubTab(permissions, "vente.facturation",
            () => PermissionGate.LegacyRead(permissions, AppFunctions.Facturation, isAdmin));
        _canLivraisonRead = PermissionGate.ViewSubTab(permissions, "vente.livraisons",
            () => PermissionGate.LegacyRead(permissions, AppFunctions.Livraison, isAdmin));
        _canPaiementRead = _canFacturationRead;

        _hasSalesReadAccess = _canFacturationRead || _canLivraisonRead
            || (permissions.HasHierarchicalGrants && _canVenteRead);

        _canFacturationWrite = PermissionGate.DoAction(permissions, "vente.facturation.write",
            () => PermissionGate.LegacyWrite(permissions, AppFunctions.Facturation, isAdmin));
        _canFacturationDelete = PermissionGate.DoAction(permissions, "vente.facturation.delete",
            () => PermissionGate.LegacyDelete(permissions, AppFunctions.Facturation, isAdmin));
        _canLivraisonWrite = PermissionGate.DoAction(permissions, "vente.livraisons.write",
            () => PermissionGate.LegacyWrite(permissions, AppFunctions.Livraison, isAdmin)
                || PermissionGate.LegacyWrite(permissions, AppFunctions.Vente, isAdmin));
        _canLivraisonDelete = PermissionGate.DoAction(permissions, "vente.livraisons.delete",
            () => PermissionGate.LegacyDelete(permissions, AppFunctions.Livraison, isAdmin));
        _showClotureActions = _canFacturationWrite;

        // Fetch user's assigned localisations via ILocalisationService
        _currentUserLocalisations = await LocalisationService.GetUserLocalisationIdsAsync(_login, isAdmin);
        _userLocalisations = await LocalisationService.GetFilteredLocalisationsAsync(_currentUserLocalisations, isAdmin);
    }

