    async Task OnDeleteFacture(FactRowDto row)
    {
        if (_userPendingClotureToday)
        {
            Snackbar.Add("Clôture en attente d'approbation admin. Aucune transaction n'est possible.", Severity.Error);
            return;
        }
        if (!_canFacturationDelete)
