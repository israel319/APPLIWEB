@using MudBlazor
@inject IFacturationService FacturationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:200px;">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (_fact is null)
        {
            <div class="alert alert-warning mb-0"><strong>Introuvable</strong> Cette facture n'existe pas.</div>
        }
        else
        {
            <div class="aw-dialog">
                <header class="aw-dialog__head">
                    <div class="aw-dialog__title-wrap">
                        <i class="bi bi-receipt" aria-hidden="true"></i>
                        <h2 class="aw-dialog__title">Facture N° @FactId</h2>
                    </div>
                </header>
                <div class="aw-dialog__body">
                    <div class="aw-dialog__meta">
                        <div>
                            <span class="aw-dialog__meta-label">Client</span>
                            <span class="aw-dialog__meta-value">@_fact.DescriptionName</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Date</span>
                            <span class="aw-dialog__meta-value">@_fact.Date.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Statut</span>
                            @{
                                var label = _fact.Status switch { 0 => "Brouillon", 1 => "Validée", 2 => "Payée", 3 => "Annulée", _ => "—" };
                            }
                            <span class="aw-badge @StatusBadge(_fact.Status)"><i class="bi @StatusIcon(_fact.Status)"></i>@label</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_fact.Adresse))
                        {
                            <div>
                                <span class="aw-dialog__meta-label">Adresse</span>
                                <span class="aw-dialog__meta-value">@_fact.Adresse</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_fact.Email))
                        {
                            <div>
                                <span class="aw-dialog__meta-label">Email</span>
                                <span class="aw-dialog__meta-value">@_fact.Email</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_fact.Telephone))
                        {
                            <div>
                                <span class="aw-dialog__meta-label">Téléphone</span>
                                <span class="aw-dialog__meta-value">@_fact.Telephone</span>
                            </div>
                        }
                    </div>

                    <div class="aw-dialog__section">Articles</div>
                    <table class="table table-sm table-bordered hub-dialog-table">
                        <thead>
                            <tr>
                                <th>Article</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">P.U.</th>
                                <th class="text-end">Sous-total</th>
                                <th class="text-center">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _details)
                            {
                                var lbl = d.Status switch { 0 => "En attente", 1 => "Livré", 2 => "Annulé", _ => "—" };
                                <tr>
                                    <td>@d.Article</td>
                                    <td class="text-center">@QtyFormat.Display(d.Qte)</td>
                                    <td class="text-end">@CurrencyFormat.FactWithEquiv(d.Pu, _isUsd, _fact!.Taux)</td>
                                    <td class="text-end">@CurrencyFormat.FactWithEquiv(d.SousTotal, _isUsd, _fact!.Taux)</td>
                                    <td class="text-center"><span class="aw-badge @DetailStatusBadge(d.Status)">@lbl</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="aw-dialog__section">Récapitulatif</div>
                    <table class="table table-sm hub-dialog-table">
                        <tbody>
                            <tr>
                                <td class="text-muted">Total articles</td>
                                <td class="text-end fw-medium">@CurrencyFormat.FactWithEquiv(_fact.Total ?? 0, _isUsd, _fact.Taux)</td>
                            </tr>
                            @if (_fact.Reduction is not null and > 0)
                            {
                                var pctRed = _fact.Reduction ?? 0;
                                var montantRed = (_fact.Total ?? 0) * pctRed / 100m;
                                <tr>
                                    <td class="text-muted">Réduction (@(pctRed.ToString("0.##"))%)</td>
                                    <td class="text-end hub-text-danger">-@CurrencyFormat.Fact(montantRed, _isUsd, _fact.Taux)</td>
                                </tr>
                            }
                            <tr>
                                <td><strong>Total</strong></td>
                                <td class="text-end fw-bold">@CurrencyFormat.FactWithEquiv(_fact.TotalApresReduction ?? _fact.Total ?? 0, _isUsd, _fact.Taux)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Taux</td>
                                <td class="text-end">@(_fact.Taux.ToString("N0"))</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="row text-muted small g-2 mt-1">
                        <div class="col-md-4">Utilisateur : @_fact.User</div>
                        <div class="col-md-4">PC : @_fact.Cumputer</div>
                        <div class="col-md-4">Créé le : @_fact.DateSys.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_fact is not null)
        {
            <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;justify-content:space-between;">
                <div>
                    @if (CanDelete)
                    {
                        <button type="button" class="aw-btn aw-btn--danger" @onclick="OnDelete">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    }
                </div>
                <div style="display:inline-flex;gap:0.45rem;flex-wrap:wrap;">
                    @if (DisplayStatus == 0 && CanWrite)
                    {
                        <button type="button" class="aw-btn aw-btn--ghost" @onclick="OnEdit">
                            <i class="bi bi-pencil"></i> Modifier
                        </button>
                    }
                    @if ((DisplayStatus == 1 || DisplayStatus == 4) && CanWrite)
                    {
                        <button type="button" class="aw-btn aw-btn--primary" @onclick="OnPay">
                            <i class="bi bi-cash"></i> Enregistrer un paiement
                        </button>
                    }
                    else if (DisplayStatus == 2)
                    {
                        <button type="button" class="aw-btn aw-btn--ghost" @onclick="OnPay">
                            <i class="bi bi-eye"></i> Historique paiements
                        </button>
                    }
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="OnPrint">
                        <i class="bi bi-printer"></i> Imprimer
                    </button>
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="Cancel">
                        <i class="bi bi-x-lg"></i> Fermer
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;">
                <button type="button" class="aw-btn aw-btn--ghost" @onclick="Cancel">
                    <i class="bi bi-x-lg"></i> Fermer
                </button>
            </div>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int FactId { get; set; }
    [Parameter] public int DisplayStatus { get; set; }
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanDelete { get; set; }

    bool _loading = true;
    bool _isUsd => CurrencyFormat.IsUsd(_fact?.Money?.DescriptionMonais);
    Fact? _fact;
    List<DetailRow> _details = new();

    protected override async Task OnInitializedAsync()
    {
        _fact = await FacturationService.GetFactureWithDetailsAsync(FactId);

        if (_fact is not null)
        {
            _details = _fact.Details.Select(d => new DetailRow
            {
                Article = d.Article?.Description ?? d.IdArticle ?? "—",
                Qte = d.Qte ?? 0,
                Pu = d.Pu ?? 0,
                SousTotal = (d.Qte ?? 0) * (d.Pu ?? 0),
                Status = _fact.Status == 0 ? 0 : _fact.Status == 3 ? 2 : (d.Status ?? 0)
            }).ToList();
        }

        _loading = false;
    }

    static string StatusBadge(int status) => status switch
    {
        0 => "aw-badge--muted",
        1 => "aw-badge--primary",
        2 => "aw-badge--brand",
        3 => "aw-badge--danger",
        _ => "aw-badge--muted"
    };

    static string StatusIcon(int status) => status switch
    {
        0 => "bi-pencil",
        1 => "bi-check2",
        2 => "bi-check-circle",
        3 => "bi-x-circle",
        _ => "bi-circle"
    };

    static string DetailStatusBadge(int status) => status switch
    {
        0 => "aw-badge--muted",
        1 => "aw-badge--brand",
        2 => "aw-badge--danger",
        _ => "aw-badge--muted"
    };

    class DetailRow
    {
        public string Article { get; set; } = "";
        public double Qte { get; set; }
        public double Pu { get; set; }
        public double SousTotal { get; set; }
        public int Status { get; set; }
    }

    void Cancel() => MudDialog.Close();

    void OnEdit() => MudDialog.Close(DialogResult.Ok("edit"));
    void OnDelete() => MudDialog.Close(DialogResult.Ok("delete"));
    void OnPay() => MudDialog.Close(DialogResult.Ok("pay"));

    async Task OnPrint()
    {
        await JS.InvokeVoidAsync("open", $"/vente/facture/print/{FactId}/true", "_blank");
    }
}
