    /// <summary>ID du client anonyme en base (chargé au démarrage).</summary>
    int _anonymousCustomerId;

    /// <summary>Persiste la facture dans la BD et retourne l'Id créé/mis à jour (0 si échec).</summary>
    async Task<int> Enregistrer(int status, bool stayOnPage = false)
    {
        // S'assurer qu'un code-barres déjà saisi est traité avant l'enregistrement
        var pendingCode = await TryReadBarcodeFromDomAsync();
        if (!_scannerProcessing && !string.IsNullOrWhiteSpace(pendingCode))
        {
            _searchOpen = false;
            await OnScanner(pendingCode);
        }

        if (!_details.Any())
        {
            Snackbar.Add("Ajoutez au moins un article.", Severity.Warning);
            RequestBarcodeFocus();
            return 0;
        }

        Recalculer();

        var hasStockLines = _details.Any(d => !string.IsNullOrWhiteSpace(d.IdArticle));
        if (hasStockLines && !_selectedLocalisation.HasValue)
        {
            Snackbar.Add("Sélectionnez une localisation de vente.", Severity.Warning);
            return 0;
        }

        if (status == 1 && hasStockLines)
        {
            if (!await RefreshAndVerifyStockFromDatabaseAsync())
                return 0;
        }

        _saving = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _facture.Status = status;
            _facture.Date = DateOnly.FromDateTime(_dateValue ?? DateTime.Today);
            _facture.DateSys = DateTime.Now;

            // ── Devise et montant en lettres ──
            _facture.MoneyId = _selectedMoneyId;
            CurrencyFormat.ApplySnapshot(_facture, CurrencyFormat.FromFactStoredTotal(
                _facture.TotalApresReduction ?? _facture.Total ?? 0, _selectedMoneyId, _facture.Taux));
            _facture.MontantEnLettres = NumberToWords.Convert(
                IsUsd
                    ? MontantAffiche(_facture.TotalApresReduction ?? _facture.Total ?? 0)
                    : (_facture.TotalApresReduction ?? _facture.Total ?? 0),
                IsUsd ? "dollars" : "francs",
                IsUsd ? "cents" : "centimes");

            // ── Client : connu ou anonyme ──
            if (_selectedCustomerId.HasValue)
            {
                _facture.CustomerId = _selectedCustomerId.Value;
            }
            else
            {
                _facture.CustomerId = _anonymousCustomerId;
                if (string.IsNullOrWhiteSpace(_facture.DescriptionName))
                    _facture.DescriptionName = "Client Anonyme";
            }

            // Construire la description articles pour T_Facts.Description_Article
            _facture.DescriptionArticle = string.Join(" | ",
                _details.Select(d => $"{d.Description} x{FormatQty(d.Qte)}"));

            await using var ctx = await DbFactory.CreateDbContextAsync();

            // ── Vérification période active (T_Periodes en BD) ──
            await RefreshActivePeriodeAsync(ctx);
            if (!SalesAllowed)
            {
                Snackbar.Add(_periodeBlockMessage, Severity.Error);
                return 0;
            }

            // ── Vérification clôture journalière ──
            var hasClosed = await ClotureService.HasUserClosedTodayAsync(_currentLogin, _currentUserLocalisations);
            if (hasClosed)
            {
                Snackbar.Add("Clôture en attente d'approbation admin. Aucune transaction n'est possible.", Severity.Error);
                return 0;
            }

            // ══════ VÉRIFICATION CONCURRENTE DU STOCK DIRECTEMENT EN BD ══════
            // Utilise une transaction SERIALIZABLE + verrouillage (UPDLOCK, ROWLOCK)
            // pour garantir qu'aucune autre transaction ne modifie le stock entre la lecture et l'écriture.
            using var transaction = await ctx.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            try
            {
                if (status == 1) // Vérification stock en BD (T_Stock) — factures validées uniquement
                {
                    var stockLines = _details
                        .Where(d => !string.IsNullOrWhiteSpace(d.IdArticle))
                        .Select(d =>
                        {
                            d.Localisationid ??= _selectedLocalisation;
                            return d;
                        })
                        .Where(d => d.Localisationid.HasValue)
                        .ToList();

                    foreach (var d in stockLines)
                    {
                        var artDb = await ctx.Articles
                            .FromSqlRaw("SELECT * FROM T_Arts WITH (UPDLOCK, ROWLOCK) WHERE Id_Article = {0}", d.IdArticle)
                            .FirstOrDefaultAsync();

                        if (artDb == null)
                        {
                            Snackbar.Add($"L'article « {d.Description} » n'existe plus dans la base de données.", Severity.Error);
                            await transaction.RollbackAsync();
                            return 0;
                        }

                        if (!StockScope(d.Localisationid!.Value))
                        {
                            Snackbar.Add($"Localisation non autorisée pour « {d.Description} ».", Severity.Error);
                            await transaction.RollbackAsync();
                            return 0;
                        }
                    }

                    foreach (var group in stockLines.GroupBy(d => (d.IdArticle!, d.Localisationid!.Value)))
                    {
                        var demande = group.Sum(x => x.Qte);
                        var stockBd = await GetStockDisponibleLockedAsync(ctx, group.Key.Item1, group.Key.Item2);
                        if (demande > stockBd + 0.0001)
                        {
                            var label = group.First().Description;
                            Snackbar.Add(
                                $"Stock BD insuffisant pour « {label} » : disponible {FormatQty(stockBd)}, demandé {FormatQty(demande)}. Un autre poste a peut-être vendu entre-temps.",
                                Severity.Error);
                            await transaction.RollbackAsync();
                            return 0;
                        }
                    }
                }

            if (_isEdit)
            {
                // Nettoyer les propriétés de navigation peuplées par EF fixup
                // dans le DbContext initial pour éviter les conflits de tracking
                _facture.Customer = null;
                _facture.Commande = null;
                _facture.Livraison = null;
                _facture.Money = null;
                _facture.Payments = new List<Payment>();
                _facture.Details = new List<FactDetail>();

                // Mode édition : mettre à jour la facture existante
                ctx.Facts.Attach(_facture);
                ctx.Entry(_facture).State = EntityState.Modified;

                // Supprimer les anciens détails et recréer
                var oldDetails = await ctx.FactDetails.Where(d => d.IdFact == _facture.Id).ToListAsync();
                ctx.FactDetails.RemoveRange(oldDetails);

                foreach (var d in _details)
                {
                    var detail = new FactDetail
                    {
                        IdFact = _facture.Id,
                        IdArticle = string.IsNullOrWhiteSpace(d.IdArticle) ? null : d.IdArticle,
                        DescriptionLine = d.DescriptionLine ?? (string.IsNullOrWhiteSpace(d.IdArticle) ? d.Description : null),
                        Qte = d.Qte,
                        Pu = d.Pu,
                        Status = status >= 1 ? 1 : 0,
                        Localisationid = d.Localisationid ?? _selectedLocalisation,
                        Montant = d.Montant,
                        MoneyId = d.MoneyId,
                        Taux = d.Taux,
                        MontantApresConversion = d.MontantApresConversion,
                    };
                    ctx.FactDetails.Add(detail);
                }
            }
            else
            {
                // Mode création
                _facture.Details = _details.Select(d => new FactDetail
                {
                    IdArticle = string.IsNullOrWhiteSpace(d.IdArticle) ? null : d.IdArticle,
                    DescriptionLine = d.DescriptionLine ?? (string.IsNullOrWhiteSpace(d.IdArticle) ? d.Description : null),
                    Qte = d.Qte,
                    Pu = d.Pu,
                    Status = status >= 1 ? 1 : 0,
                    Localisationid = d.Localisationid ?? _selectedLocalisation,
                    Montant = d.Montant,
                    MoneyId = d.MoneyId,
                    Taux = d.Taux,
                    MontantApresConversion = d.MontantApresConversion,
                }).ToList();

                ctx.Facts.Add(_facture);
            }

            await ctx.SaveChangesAsync();

            // ── Déduire T_Stock via moteur centralisé ──
            if (status == 1)
            {
                if (_isEdit)
                {
                    await StockMovement.TryReverseDocumentAsync(
                        ctx,
                        TypesDocument.FACTURE,
                        _facture.Id,
                        _currentLogin,
                        $"Correction facture N°{_facture.Id}",
                        DateTime.Now);
                }

                var outboundLines = _details
                    .Where(d => !string.IsNullOrWhiteSpace(d.IdArticle))
                    .Select(d => new StockOutboundLineRequest(
                        d.IdArticle,
                        QuantityFormat.Normalize((decimal)d.Qte),
                        d.Localisationid ?? _selectedLocalisation!.Value,
                        PrixUnitaire: (decimal?)d.Pu))
                    .ToList();

                try
                {
                    await StockMovement.ApplyOutboundAsync(
                        ctx,
                        _facture.Id,
                        TypesDocument.FACTURE,
                        outboundLines,
                        _currentLogin,
                        $"FACT-{_facture.Id}",
                        "Vente — déduction stock",
                        DateTime.Now);
                }
                catch (InvalidOperationException ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                    await transaction.RollbackAsync();
                    return 0;
                }

                await ctx.SaveChangesAsync();
            }

            // ── Insertion automatique du paiement (uniquement facture validée) ──
            if (status == 1)
            {
                var paySnap = CurrencyFormat.FromFactStoredTotal(
                    _facture.TotalApresReduction ?? _facture.Total ?? 0, _selectedMoneyId, _facture.Taux);
                var payment = new Payment
                {
                    IdFact  = _facture.Id,
                    Date    = _facture.Date,
                    Note    = $"Paiement auto — {_modePaiement}",
                    DateSys = DateTime.Now,
                    User    = _facture.User
                };
                CurrencyFormat.ApplySnapshot(payment, paySnap);
                ctx.Payments.Add(payment);
                _facture.Status = 2; // Payée
                await ctx.SaveChangesAsync();
            }

            await transaction.CommitAsync();
            } // fin du bloc try transaction
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }

            Snackbar.Add($"N°{_facture.Id} — Client: {_facture.DescriptionName} — Total: {CurrencyFormat.Fact(_facture.TotalApresReduction ?? 0, IsUsd, _facture.Taux)}", Severity.Success);

            if (!stayOnPage)
                Navigation.NavigateTo(_backRoute);
            return _facture.Id;
        }
        catch (Exception ex)
        {
            var msg = ex.InnerException?.Message ?? ex.Message;
            Snackbar.Add($"Impossible d'enregistrer la facture : {msg}", Severity.Error);
            return 0;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Relit T_Periodes : Activated + dates couvrant aujourd'hui.</summary>
    async Task RefreshActivePeriodeAsync(AppDbContext? ctx = null)
    {
        _activePeriode = await FinanceService.GetActivePeriodeAsync();
        if (_activePeriode != null)
        {
            _periodeBlockMessage = "";
            return;
        }

        var dispose = ctx == null;
        ctx ??= await DbFactory.CreateDbContextAsync();
        try
        {
            var activated = await ctx.Periodes.AsNoTracking()
                .FirstOrDefaultAsync(p => p.Activated == true);
            _periodeBlockMessage = activated == null
                ? "Aucune période active n'est définie. Créez ou activez une période avant de vendre."
                : "La date du jour n'est pas comprise dans la période active.";
        }
        finally
        {
            if (dispose)
                await ctx.DisposeAsync();
        }
    }

    /// <summary>Relit T_Stock en BD et refuse si une ligne catalogue dépasse le stock disponible.</summary>
    async Task<bool> RefreshAndVerifyStockFromDatabaseAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        foreach (var d in _details.Where(x => !string.IsNullOrWhiteSpace(x.IdArticle)))
        {
            var loc = d.Localisationid ?? _selectedLocalisation;
            d.StockDispo = await GetStockDisponibleAsync(ctx, d.IdArticle!, loc);
        }

        foreach (var group in _details
                     .Where(x => !string.IsNullOrWhiteSpace(x.IdArticle))
                     .GroupBy(x => (x.IdArticle!, x.Localisationid ?? _selectedLocalisation!.Value)))
        {
            var demande = group.Sum(x => x.Qte);
            var stockBd = await GetStockDisponibleAsync(ctx, group.Key.Item1, group.Key.Item2);
            if (demande > stockBd + 0.0001)
            {
                var label = group.First().Description;
                Snackbar.Add(
                    $"Stock BD insuffisant pour « {label} » à {GetLocName(group.Key.Item2)} : disponible {FormatQty(stockBd)}, demandé {FormatQty(demande)}.",
                    Severity.Error);
                await InvokeAsync(StateHasChanged);
                return false;
            }
        }

        return true;
    }

    bool StockScope(int localisationId) =>
        _isAdmin || !_currentUserLocalisations.Any() || _currentUserLocalisations.Contains(localisationId);

    async Task<string> GetStockAutresLocalisationsMessageAsync(AppDbContext ctx, string idArticle)
    {
        var stocks = await ctx.Stocks.AsNoTracking()
            .Where(s => s.IdArticle == idArticle && s.Qte > 0)
            .ToListAsync();
        stocks = stocks.Where(s => StockScope(s.IdLocalisation) && s.IdLocalisation != _selectedLocalisation).ToList();
        if (!stocks.Any()) return " ";

        var parts = stocks.Select(s =>
        {
            var nom = GetLocName(s.IdLocalisation);
            return $"{nom}: {s.Qte:N0}";
        });
        return $" Stock disponible ailleurs : {string.Join(", ", parts)}. ";
    }

    async Task<double> GetStockDisponibleAsync(AppDbContext ctx, string idArticle, int? localisationId)
    {
        if (localisationId.HasValue)
        {
            if (!StockScope(localisationId.Value)) return 0;
            var stock = await ctx.Stocks.AsNoTracking()
                .FirstOrDefaultAsync(s => s.IdArticle == idArticle && s.IdLocalisation == localisationId.Value);
            return stock != null ? (double)stock.Qte : 0;
        }

        var stocks = await ctx.Stocks.AsNoTracking()
            .Where(s => s.IdArticle == idArticle)
            .ToListAsync();
        stocks = stocks.Where(s => StockScope(s.IdLocalisation)).ToList();
        return stocks.Any() ? (double)stocks.Sum(s => s.Qte) : 0;
    }

    async Task<double> GetStockDisponibleLockedAsync(AppDbContext ctx, string idArticle, int? localisationId)
    {
        if (localisationId.HasValue)
        {
            if (!StockScope(localisationId.Value)) return 0;
            var stock = await ctx.Stocks
                .FromSqlRaw(
                    "SELECT * FROM T_Stock WITH (UPDLOCK, ROWLOCK) WHERE Id_Article = {0} AND Id_Localisation = {1}",
                    idArticle, localisationId.Value)
                .FirstOrDefaultAsync();
            return stock != null ? (double)stock.Qte : 0;
        }

        var stocks = await ctx.Stocks
            .FromSqlRaw("SELECT * FROM T_Stock WITH (UPDLOCK, ROWLOCK) WHERE Id_Article = {0}", idArticle)
            .ToListAsync();
        stocks = stocks.Where(s => StockScope(s.IdLocalisation)).ToList();
        return stocks.Any() ? (double)stocks.Sum(s => s.Qte) : 0;
    }

    /// <summary>Ligne de détail affichée dans le DataGrid — correspond aux champs de T_Fact_Details.</summary>
    class FactDetailLine
    {
        public string IdArticle { get; set; } = "";
        public string Description { get; set; } = "";
        public string? DescriptionLine { get; set; }
        public bool IsServiceLine => string.IsNullOrWhiteSpace(IdArticle);
        public double Pu { get; set; }
        public double Qte { get; set; } = 1;
        public double StockDispo { get; set; }
        public int? Localisationid { get; set; }
        public decimal? Montant { get; set; }
        public int? MoneyId { get; set; }
        public decimal? Taux { get; set; }
        public decimal? MontantApresConversion { get; set; }
        public double Total => Pu * Qte;
    }
}
