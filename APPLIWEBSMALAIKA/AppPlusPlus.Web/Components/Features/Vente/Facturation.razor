    void Recalculer()
    {
        foreach (var d in _details)
        {
            var snap = CurrencyFormat.ComputeMonetarySnapshot(
                (decimal)d.Pu, (decimal)d.Qte, _selectedMoneyId, _facture.Taux, puStoredInCdf: true);
            d.Montant = snap.Montant;
            d.MoneyId = snap.MoneyId;
            d.Taux = snap.Taux;
            d.MontantApresConversion = snap.MontantApresConversion;
        }

        _facture.Total = (decimal)_details.Sum(d => d.Pu * d.Qte);
        var brut = (_facture.Total ?? 0) - ReductionMontant;
        _facture.TotalApresReduction = CurrencyFormat.RoundInvoicePayable(brut, IsUsd);
        _facture.TotalReduit = (_facture.Total ?? 0) * ((_facture.Reduction ?? 0) / 100m);

        _details = _details.ToList();
    }

    static string FormatQty(double q) => QtyFormat.InputValue(q);

    string GetQtyDisplay(FactDetailLine line) =>
        _qtyTexts.TryGetValue(line, out var text)
            ? text
            : FormatQty(line.Qte);

    void SyncQtyText(FactDetailLine line) => _qtyTexts[line] = FormatQty(line.Qte);

    static string FilterQtyInput(string raw)
    {
        var sb = new StringBuilder();
        var hasSep = false;
        foreach (var c in raw)
        {
            if (char.IsDigit(c))
                sb.Append(c);
            else if ((c == '.' || c == ',') && !hasSep)
            {
                sb.Append(c);
                hasSep = true;
            }
        }
        return sb.ToString();
    }

    static bool TryParseQty(string? raw, out double qte)
    {
        qte = 0;
        if (string.IsNullOrWhiteSpace(raw)) return false;
        var normalized = raw.Trim().Replace(',', '.');
        return double.TryParse(normalized, NumberStyles.AllowDecimalPoint, CultureInfo.InvariantCulture, out qte)
               && qte > 0;
    }

    void OnQtyInput(FactDetailLine line, ChangeEventArgs e)
    {
        _qtyTexts[line] = FilterQtyInput(e.Value?.ToString() ?? "");
        StateHasChanged();
    }

    void OnQtyKeyDown(KeyboardEventArgs e) => _preventQtyKey = ShouldPreventQtyKey(e);

    static bool ShouldPreventQtyKey(KeyboardEventArgs e)
    {
        if (e.CtrlKey || e.AltKey || e.MetaKey) return false;
        return e.Key switch
        {
            "Backspace" or "Delete" or "Tab" or "Enter"
                or "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown"
                or "Home" or "End" => false,
            _ when e.Key.Length == 1 && (char.IsDigit(e.Key[0]) || e.Key[0] is '.' or ',') => false,
            _ => true
        };
    }

    async Task OnQtyBlurAsync(FactDetailLine line)
    {
        var raw = _qtyTexts.GetValueOrDefault(line, FormatQty(line.Qte));
        if (!TryParseQty(raw, out var qte))
        {
            SyncQtyText(line);
            StateHasChanged();
            return;
        }

        await SetQteAsync(line, qte);
    }

    async Task OnScanner(string? codeOverride = null)
    {
        if (_scannerProcessing) return;
        _scannerProcessing = true;

        try
        {
        if (!SalesAllowed)
        {
            Snackbar.Add(_periodeBlockMessage, Severity.Error);
            return;
        }

        var code = (codeOverride ?? _barcode)?.Trim();
        if (string.IsNullOrWhiteSpace(code)) return;
        if (!_selectedLocalisation.HasValue)
        {
            Snackbar.Add("Sélectionnez une localisation de vente avant d'ajouter des articles.", Severity.Warning);
            return;
        }

        // ── Résoudre l'article (catalogue local pour les infos, mais stock = BD) ──
        var article = _catalogue.FirstOrDefault(a => a.IdArticle == code)
                   ?? _catalogue.FirstOrDefault(a => a.Description.Contains(code, StringComparison.OrdinalIgnoreCase));

        // Si pas trouvé → chercher par code-barres dans T_Stock (localisation courante en priorité)
        if (article == null)
        {
            await using var ctxLookup = await DbFactory.CreateDbContextAsync();
            var stock = await ctxLookup.Stocks
                .FirstOrDefaultAsync(s => s.CodeBar == code && s.IdLocalisation == _selectedLocalisation.Value)
                ?? await ctxLookup.Stocks.FirstOrDefaultAsync(s => s.CodeBar == code);
            if (stock != null)
                article = _catalogue.FirstOrDefault(a => a.IdArticle == stock.IdArticle);
        }

        if (article == null)
        {
            Snackbar.Add($"Code ou nom « {code} » non trouvé dans le catalogue.", Severity.Warning);
            _barcode = "";
            await FocusBarcodeInputAsync();
            return;
        }

        // ── Vérifier le stock DIRECTEMENT EN BD (T_Stock par localisation) ──
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var stockBd = await GetStockDisponibleAsync(ctx, article.IdArticle, _selectedLocalisation);

        if (stockBd < MinQte)
        {
            var stockAutresLocs = await GetStockAutresLocalisationsMessageAsync(ctx, article.IdArticle);
            Snackbar.Add(
                $"« {article.Description} » : rupture à {LocLabel} (stock BD: {stockBd:N2}).{stockAutresLocs} Approvisionnez ou changez la localisation.",
                Severity.Error);
            _barcode = "";
            await FocusBarcodeInputAsync();
            return;
        }

        if (stockBd > 0 && _selectedLocalisation.HasValue)
        {
            var stockRec = await ctx.Stocks.AsNoTracking()
                .FirstOrDefaultAsync(s => s.IdArticle == article.IdArticle && s.IdLocalisation == _selectedLocalisation.Value);
            if (stockRec != null && stockRec.Seuil > 0 && stockBd <= stockRec.Seuil)
            {
                Snackbar.Add($"L'article « {article.Description} » a un stock bas ({stockBd:N0} restant, seuil: {stockRec.Seuil}).", Severity.Warning);
            }
        }

        // ── Ajouter ou incrémenter (par article + localisation) ──
        var existant = _details.FirstOrDefault(d =>
            d.IdArticle == article.IdArticle && d.Localisationid == _selectedLocalisation);
        if (existant != null)
        {
            // Si le stock restant est inférieur à 1, on autorise l'ajout fractionné.
            // On cappe la quantité à la quantité disponible.
            var cible = Math.Min(existant.Qte + 1, stockBd);
            if (cible + 0.0000001 < MinQte)
            {
                Snackbar.Add($"Stock BD de « {article.Description} » : {stockBd:N2}. Impossible d'ajouter.", Severity.Error);
                _barcode = "";
                await FocusBarcodeInputAsync();
                return;
            }
            existant.Qte = Math.Round(cible, 3, MidpointRounding.AwayFromZero);
            existant.StockDispo = stockBd;
            SyncQtyText(existant);
        }
        else
        {
            // Valeur initiale = 1 si stock suffisant, sinon quantité disponible (fraction).
            var qteInit = Math.Min(1, stockBd);
            if (qteInit < MinQte)
            {
                var stockAutresLocs = await GetStockAutresLocalisationsMessageAsync(ctx, article.IdArticle);
                Snackbar.Add(
                    $"« {article.Description} » : stock insuffisant à {LocLabel} (stock BD: {stockBd:N2}).{stockAutresLocs}",
                    Severity.Error);
                _barcode = "";
                await FocusBarcodeInputAsync();
                return;
            }
            var line = new FactDetailLine
            {
                IdArticle = article.IdArticle,
                Description = article.Description,
                Pu = NativePriceToPuFc(article.Price, article.IdMonais),
                Qte = Math.Round(qteInit, 3, MidpointRounding.AwayFromZero),
                StockDispo = stockBd,
                Localisationid = _selectedLocalisation,
            };
            _details.Add(line);
            SyncQtyText(line);
        }
        Recalculer();
        _barcode = "";
        await FocusBarcodeInputAsync();
        }
        finally
        {
            _scannerProcessing = false;
        }
    }

    async Task ModifierQteAsync(FactDetailLine ligne, double delta)
    {
        await SetQteAsync(ligne, Math.Max(MinQte, ligne.Qte + delta));
    }

    async Task SetQteAsync(FactDetailLine ligne, double nouvelleQte)
    {
        nouvelleQte = Math.Round(nouvelleQte, 3, MidpointRounding.AwayFromZero);
        if (nouvelleQte < MinQte)
        {
            SyncQtyText(ligne);
            return;
        }

        await using var ctx = await DbFactory.CreateDbContextAsync();
        var locId = ligne.Localisationid ?? _selectedLocalisation;
        var stockBd = await GetStockDisponibleAsync(ctx, ligne.IdArticle, locId);
        var autresLignes = _details
            .Where(d => d.IdArticle == ligne.IdArticle && d != ligne && d.Localisationid == locId)
            .Sum(d => d.Qte);

        if (!string.IsNullOrWhiteSpace(ligne.IdArticle) && nouvelleQte + autresLignes > stockBd + 0.0001)
        {
            Snackbar.Add(
                $"Stock BD de « {ligne.Description} » : {FormatQty(stockBd)}. Déjà {FormatQty(autresLignes)} sur d'autres lignes.",
                Severity.Error);
            SyncQtyText(ligne);
            return;
        }

        ligne.Qte = nouvelleQte;
        ligne.StockDispo = stockBd;
        SyncQtyText(ligne);
        Recalculer();
    }

    void Supprimer(FactDetailLine ligne)
    {
        _qtyTexts.Remove(ligne);
        _details.Remove(ligne);
        Recalculer();
        RequestBarcodeFocus();
    }

