@using MudBlazor
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IUserCurrencyPreferenceService UserCurrency

<MudDialog>
    <DialogContent>
        @if (_livraison == null)
        {
            <div class="aw-dialog">
                <div class="aw-dialog__body">
                    <AwSkeleton Variant="table" Rows="4" />
                </div>
            </div>
        }
        else
        {
            <div class="aw-dialog">
                <header class="aw-dialog__head">
                    <div class="aw-dialog__title-wrap">
                        <i class="bi bi-truck" aria-hidden="true"></i>
                        <h2 class="aw-dialog__title">Livraison N° @_livraison.LivraisonId</h2>
                    </div>
                </header>
                <div class="aw-dialog__body">
                    <div class="aw-dialog__meta">
                        <div>
                            <span class="aw-dialog__meta-label">Client</span>
                            <span class="aw-dialog__meta-value">@(_livraison.Customer?.CustomerName ?? "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Porteur</span>
                            <span class="aw-dialog__meta-value">@(_livraison.Porteur ?? "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Date</span>
                            <span class="aw-dialog__meta-value">@(_livraison.Date?.ToString("dd/MM/yyyy") ?? "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Statut</span>
                            <span class="aw-badge @_statusBadge"><i class="bi @_statusIcon"></i>@_statusLabel</span>
                        </div>
                        @if (_livraison.CommandeId.HasValue)
                        {
                            <div>
                                <span class="aw-dialog__meta-label">Commande</span>
                                <span class="aw-badge aw-badge--muted">C-@_livraison.CommandeId</span>
                            </div>
                        }
                        @if (_livraison.Fact != null)
                        {
                            <div>
                                <span class="aw-dialog__meta-label">Facture</span>
                                <span class="aw-badge aw-badge--primary"><i class="bi bi-receipt"></i>F-@_livraison.Fact.Id</span>
                            </div>
                        }
                    </div>

                    @if (_livraison.Details.Any())
                    {
                        <div class="aw-dialog__section">Articles</div>
                        <div class="aw-table-region">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>Article</th>
                                            <th class="aw-table__num">Qté</th>
                                            <th class="aw-table__num">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in _livraison.Details)
                                        {
                                            <tr style="cursor:default;">
                                                <td><span class="aw-table__title">@(d.Article?.Description ?? d.ArticleId ?? "—")</span></td>
                                                <td class="aw-table__num">@((d.Qte ?? 0).ToString("N0"))</td>
                                                <td class="aw-table__num">@UserCurrency.FormatFromSnapshot(d.Montant, d.MoneyId, d.Taux, d.MontantApresConversion, d.MontantPaye ?? 0, CurrencyDefaults.MoneyIdUsd, _displayTaux)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr style="cursor:default;">
                                            <td><span class="aw-table__title">Total</span></td>
                                            <td class="aw-table__num">@_livraison.Details.Sum(d => d.Qte ?? 0).ToString("N0")</td>
                                            <td class="aw-table__num"><span class="aw-table__title">@UserCurrency.FormatFromFcStored(_livraison.Details.Sum(d => d.MontantPaye ?? 0), _displayTaux)</span></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_livraison != null)
        {
            <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;justify-content:space-between;">
                <div>
                    @if (CanDelete && _livraison.Fact == null)
                    {
                        <button type="button" class="aw-btn aw-btn--danger" @onclick="@(() => MudDialog.Close(DialogResult.Ok("delete")))">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    }
                </div>
                <div style="display:inline-flex;gap:0.45rem;flex-wrap:wrap;">
                    @if ((_livraison.Status ?? 0) == 0 && CanWrite)
                    {
                        <button type="button" class="aw-btn aw-btn--primary" @onclick="@(() => MudDialog.Close(DialogResult.Ok("deliver")))">
                            <i class="bi bi-check-circle"></i> Marquer livrée
                        </button>
                    }
                    @if ((_livraison.Status ?? 0) <= 1 && _livraison.Fact == null && CanWrite)
                    {
                        <button type="button" class="aw-btn aw-btn--primary" @onclick="@(() => MudDialog.Close(DialogResult.Ok("pay")))">
                            <i class="bi bi-cash"></i> Payer
                        </button>
                    }
                    @if (CanWrite)
                    {
                        <button type="button" class="aw-btn aw-btn--ghost" @onclick="@(() => MudDialog.Close(DialogResult.Ok("edit")))">
                            <i class="bi bi-pencil"></i> Modifier
                        </button>
                    }
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="Cancel">
                        <i class="bi bi-x-lg"></i> Fermer
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;">
                <button type="button" class="aw-btn aw-btn--ghost" @onclick="Cancel">
                    <i class="bi bi-x-lg"></i> Fermer
                </button>
            </div>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int LivraisonId { get; set; }
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public bool CanDelete { get; set; }

    Livraison? _livraison;
    decimal _displayTaux;
    string _statusLabel = "";
    string _statusBadge = "aw-badge--muted";
    string _statusIcon = "bi-circle";

    protected override async Task OnInitializedAsync()
    {
        await UserCurrency.EnsureLoadedAsync();
        await using var ctx = await DbFactory.CreateDbContextAsync();
        _displayTaux = await ctx.TauxChanges.OrderByDescending(t => t.Id).Select(t => t.TauxValue).FirstOrDefaultAsync();
        _livraison = await ctx.Livraisons
            .Include(l => l.Customer)
            .Include(l => l.Details).ThenInclude(d => d.Article)
            .Include(l => l.Fact).ThenInclude(f => f!.Payments)
            .FirstOrDefaultAsync(l => l.LivraisonId == LivraisonId);

        if (_livraison != null)
        {
            if (_livraison.Fact != null)
            {
                var fTotal = (double)(_livraison.Fact.TotalApresReduction ?? _livraison.Fact.Total ?? 0);
                var fPaye = _livraison.Fact.Payments?.Sum(p => (double)p.Montant) ?? 0;
                if (fPaye >= fTotal && fTotal > 0)
                {
                    _statusLabel = "Payée";
                    _statusBadge = "aw-badge--brand";
                    _statusIcon = "bi-check-circle";
                }
                else if (fPaye > 0)
                {
                    _statusLabel = "Partiel";
                    _statusBadge = "aw-badge--accent";
                    _statusIcon = "bi-cash-stack";
                }
                else
                {
                    _statusLabel = "Facturée";
                    _statusBadge = "aw-badge--primary";
                    _statusIcon = "bi-receipt";
                }
            }
            else
            {
                (_statusLabel, _statusBadge, _statusIcon) = (_livraison.Status ?? 0) switch
                {
                    1 => ("Livrée", "aw-badge--primary", "bi-truck"),
                    _ => ("En attente", "aw-badge--accent", "bi-hourglass-split")
                };
            }
        }
    }

    void Cancel() => MudDialog.Cancel();
}
