    bool _approDialogOpen;

    async Task OpenApproDetailAsync(ApproListItemDto item)
    {
        if (_approDialogOpen || NavGate.IsLocked) return;
        _approDialogOpen = true;
        try
        {
            var parameters = new DialogParameters
            {
                { nameof(ApproDetailDialog.ApproId), item.Id },
                { nameof(ApproDetailDialog.CanWrite), _canApproWrite },
                { nameof(ApproDetailDialog.UserLogin), _currentLogin }
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
            var dialog = await DialogService.ShowAsync<ApproDetailDialog>($"Réception N° {item.Id}", parameters, options);
            try
            {
                var result = await dialog.Result;
                if (result is { Canceled: false })
                    await RefreshApproData();
            }
            catch (TaskCanceledException) { }
        }
        finally
        {
            _approDialogOpen = false;
        }
