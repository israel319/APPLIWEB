    void StartEditLocalisation(Localisation item)
    {
        _editLocalisationId = item.IdLocalisation;
        _editLocalisationText = item.DescriptionLocalisation ?? "";
    }

    void CancelEditLocalisation()
    {
        _editLocalisationId = null;
        _editLocalisationText = "";
    }

    async Task SaveEditLocalisation(Localisation item)
    {
        item.DescriptionLocalisation = _editLocalisationText.Trim();
        await OnUpdateLocalisation(item);
        CancelEditLocalisation();
    }

    /* ── LOCALISATION ── */

    async Task InsertLocalisation()
    {
        var item = new Localisation { DescriptionLocalisation = "Nouvelle localisation" };
        await CatalogueService.AddLocalisationAsync(item);
        _localisations.Add(item);
        Snackbar.Add("Localisation ajoutée — cliquez sur modifier pour renommer", Severity.Success);
    }

    async Task OnUpdateLocalisation(Localisation item)
    {
        await CatalogueService.UpdateLocalisationAsync(item);
        Snackbar.Add("Localisation modifiée", Severity.Success);
    }

    async Task DeleteLocalisation(Localisation item)
    {
        if (await Confirmer($"Supprimer « {item.DescriptionLocalisation} » ?"))
        {
            await CatalogueService.DeleteLocalisationAsync(item);
            _localisations.Remove(item);
            Snackbar.Add("Localisation supprimée", Severity.Success);
        }
    }

    /* ── Utilitaire ── */
    async Task<bool> Confirmer(string message)
    {
        var result = await DialogService.ShowMessageBox("Confirmation", message,
            yesText: "Supprimer", cancelText: "Annuler");
        return result == true;
    }
