    async Task LoadAppros()
    {
        _approLoading = true;
        _approData = await ApproQuery.GetListAsync(_currentUserLocalisations);
        _approLoadedOnce = true;
        _approLoading = false;
    }

    List<ApproListItemDto> GetFilteredAppros()
    {
        IEnumerable<ApproListItemDto> q = _approData;
        var today = DateTime.Today;
        q = _approScope switch
        {
            "month" => q.Where(a => a.Date.Month == today.Month && a.Date.Year == today.Year),
            "order" => q.Where(a => a.IsFromCommand),
            "direct" => q.Where(a => !a.IsFromCommand),
            _ => q
        };
        if (!string.IsNullOrWhiteSpace(_approSearch))
        {
            var s = _approSearch.Trim();
            q = q.Where(a =>
                a.ArticleName.Contains(s, StringComparison.OrdinalIgnoreCase) ||
                a.Id.ToString().Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (a.Reference?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.User?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.LocalisationLabel?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return q.ToList();
    }

    void SetApproScope(string scope)
    {
        _approScope = scope;
        _approPage = 1;
    }

    void OnApproSearchChanged() => _approPage = 1;

    void OnApproSearchValueChanged(string value)
    {
        _approSearch = value ?? "";
        OnApproSearchChanged();
    }

    async Task RefreshApproData()
    {
        await LoadAppros();
        _approPage = Math.Clamp(_approPage, 1, PageCount(GetFilteredAppros().Count, _approPageSize));
    }

