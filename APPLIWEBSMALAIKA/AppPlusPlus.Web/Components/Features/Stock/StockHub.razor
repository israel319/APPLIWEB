    async Task OnCancelAppro(ApproListItemDto item)
    {
        var confirm = await DialogService.ShowMessageBox(
            item.IsTransfer ? "Annuler le transfert" : "Annuler l'approvisionnement",
            item.IsTransfer
                ? $"Annuler le transfert N° {item.Id} ? Les {item.Qte:N0} unités seront réintégrées au magasin source et retirées de la destination."
                : $"Annuler l'appro N° {item.Id} ? Le stock sera contre-passé et l'opération restera tracée avec le statut « Annulé ».",
            yesText: item.IsTransfer ? "Annuler le transfert" : "Annuler l'appro", cancelText: "Fermer");
        if (confirm != true) return;

        try
        {
            var login = !string.IsNullOrWhiteSpace(_currentLogin) ? _currentLogin : item.User;
            if (string.IsNullOrWhiteSpace(login))
                login = "system";

            await ApproPosting.CancelApproAsync(item.Id, login);
            await RefreshApproData();
            Snackbar.Add(item.IsTransfer
                ? $"Transfert N° {item.Id} annulé — stocks restaurés."
                : $"Approvisionnement N° {item.Id} annulé — stock corrigé.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    async Task OnDeleteAppro(ApproListItemDto item)
    {
        var confirm = await DialogService.ShowMessageBox("Confirmation",
            $"Supprimer définitivement l'appro N° {item.Id} ? Cette action est irréversible.",
            yesText: "Supprimer", cancelText: "Fermer");
        if (confirm != true) return;

        try
        {
            await ApproPosting.DeleteApproAsync(item.Id);
            await RefreshApproData();
            Snackbar.Add($"Appro N° {item.Id} supprimé.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /* ════════════════════════════════════════════════════════════
       TRANSFORMATION
       ════════════════════════════════════════════════════════════ */

    async Task LoadTransformations()
    {
        _transLoading = true;
        await EnsureArticlesLoadedAsync();
        await using var ctx = await DbFactory.CreateDbContextAsync();

        var transQuery = ctx.Transformations.AsQueryable();

        if (_currentUserLocalisations.Any())
        {
            transQuery = transQuery.Where(t =>
                (t.FromLocalisationId.HasValue && _currentUserLocalisations.Contains(t.FromLocalisationId.Value)) ||
                (t.ToLocalisationId.HasValue && _currentUserLocalisations.Contains(t.ToLocalisationId.Value)));
        }

        _transData = await transQuery.OrderByDescending(t => t.Date).ToListAsync();
        _transLoadedOnce = true;
        _transLoading = false;
    }

    List<Transformation> GetFilteredTransformations()
    {
        IEnumerable<Transformation> q = _transData;
        var today = DateTime.Today;
        if (_transScope == "month")
            q = q.Where(t => t.Date.Month == today.Month && t.Date.Year == today.Year);

        if (!string.IsNullOrWhiteSpace(_transSearch))
        {
            var s = _transSearch.Trim();
            q = q.Where(t =>
            {
                var fromArt = _articles.FirstOrDefault(a => a.IdArticle == t.FromArticleId)?.Description ?? t.FromArticleId;
                var toArt = _articles.FirstOrDefault(a => a.IdArticle == t.ToArticleId)?.Description ?? t.ToArticleId;
                return t.TransformationId.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
                    || fromArt.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || toArt.Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (t.UserLogin?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (t.Comment?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
            });
        }

        return q.ToList();
    }

    void SetTransScope(string scope)
    {
        _transScope = scope;
        _transPage = 1;
    }

    void OnTransSearchChanged() => _transPage = 1;

    void OnTransSearchValueChanged(string value)
    {
        _transSearch = value ?? "";
        OnTransSearchChanged();
    }

    async Task RefreshTransData()
    {
        await LoadTransformations();
        _transPage = Math.Clamp(_transPage, 1, PageCount(GetFilteredTransformations().Count, _transPageSize));
    }

    void OnTransClick(Transformation item)
    {
        OnEditTrans(item);
    }

