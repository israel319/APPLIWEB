                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>N° Facture</th>
                                            <th>Client</th>
                                            <th class="aw-table__num">Total</th>
                                            <th class="aw-table__num">Réduction</th>
                                            <th class="aw-table__num">Net à payer</th>
