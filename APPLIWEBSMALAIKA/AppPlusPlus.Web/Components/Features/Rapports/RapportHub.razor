        await JS.InvokeVoidAsync("eval", $"var a=document.createElement('a');a.href='data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';a.download='Ventes_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx';document.body.appendChild(a);a.click();document.body.removeChild(a);");
