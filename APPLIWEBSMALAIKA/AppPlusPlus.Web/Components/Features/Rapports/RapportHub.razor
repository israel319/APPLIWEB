    static string FormatPeriodeLabel(Periode p)
    {
        var dates = p.FromDate.HasValue && p.ToDate.HasValue
            ? $"{p.FromDate:dd/MM/yyyy} — {p.ToDate:dd/MM/yyyy}"
            : "Dates non définies";
        return string.IsNullOrWhiteSpace(p.Comment) ? dates : $"{dates} · {p.Comment}";
    }

    Periode? FindPeriodeForDate(DateOnly date) =>
        _periodes.FirstOrDefault(p => p.FromDate.HasValue && p.ToDate.HasValue
            && date >= DateOnly.FromDateTime(p.FromDate.Value)
            && date <= DateOnly.FromDateTime(p.ToDate.Value));

    string ResolvePeriodeLabel(DateOnly date)
    {
        var p = FindPeriodeForDate(date);
        return p != null ? FormatPeriodeLabel(p) : "Hors période";
    }

    async Task OnVentePeriodeFilterChanged()
    {
        if (int.TryParse(_ventePeriodeFilter, out var pid))
        {
            var p = _periodes.FirstOrDefault(x => x.Id == pid);
            if (p?.FromDate != null) _venteFrom = p.FromDate.Value;
            if (p?.ToDate != null) _venteTo = p.ToDate.Value;
        }
        await LoadVentes();
    }

    bool HasVenteExportData() =>
        _ventePeriodeFilter == "grouped" ? _venteGroupedFiltered.Any(g => g.Lignes.Any()) : _venteFiltered.Any();

    static RptVenteVm ToVenteVm(VenteLigneReportDto d) => new(
        d.NumFacture, d.Client, d.Article, d.Qte,
        d.LineMontant, d.LineMoneyId, d.LineTaux, d.LineMontantApres,
        d.LegacyPu, d.LegacyLineTotal,
        d.FactMontant, d.FactMoneyId, d.FactMontantApres,
        d.LegacyFactTotal, d.Reduction, d.FactTaux,
        d.Date, d.Utilisateur, "", 0, 0, 0);

    async Task<List<RptVenteVm>> QueryVenteRowsAsync(DateOnly from, DateOnly to)
    {
        await UserCurrency.EnsureLoadedAsync();
        var latestTaux = await RapportQuery.GetLatestTauxAsync();
        if (latestTaux <= 0) latestTaux = UserCurrency.CachedTaux;

        var rows = await RapportQuery.GetVentesLignesAsync(from, to);
        return rows.Select(r => EnrichVenteRow(ToVenteVm(r), latestTaux)).ToList();
    }

    RptVenteVm EnrichVenteRow(RptVenteVm raw, decimal latestTaux)
    {
        var lineTaux = raw.LineTaux ?? (raw.FactTaux > 0 ? raw.FactTaux : latestTaux);
        var factMoneyId = raw.FactMoneyId ?? CurrencyDefaults.MoneyIdCdf;
        var lineMoneyFallback = raw.LineMoneyId ?? factMoneyId;
        var factTaux = raw.FactTaux > 0 ? raw.FactTaux : latestTaux;

        var displayLine = UserCurrency.ResolveDisplayAmount(
            raw.LineMontant, raw.LineMoneyId, raw.LineTaux, raw.LineMontantApres,
            (decimal)raw.LegacyLineTotal, lineMoneyFallback, lineTaux);

        var displayFact = UserCurrency.ResolveDisplayAmount(
            raw.FactMontant, raw.FactMoneyId, factTaux, raw.FactMontantApres,
            raw.LegacyFactTotal, factMoneyId, factTaux);

        return raw with
        {
            DisplayLineTotal = displayLine,
            DisplayPu = UserCurrency.ResolveLineUnitPrice(displayLine, raw.Qte),
            DisplayFactTotal = displayFact,
            PeriodeLabel = ResolvePeriodeLabel(raw.Date)
        };
    }

    async Task LoadVentes()
    {
        _venteLoading = true;
        _venteGrouped.Clear();
        _venteData.Clear();

        if (_ventePeriodeFilter == "grouped")
        {
            DateOnly minDate = DateOnly.FromDateTime(DateTime.Today.AddYears(-10));
            DateOnly maxDate = DateOnly.FromDateTime(DateTime.Today);
            if (_periodes.Any(p => p.FromDate.HasValue))
                minDate = _periodes.Where(p => p.FromDate.HasValue).Min(p => DateOnly.FromDateTime(p.FromDate!.Value));
            if (_periodes.Any(p => p.ToDate.HasValue))
                maxDate = _periodes.Where(p => p.ToDate.HasValue).Max(p => DateOnly.FromDateTime(p.ToDate!.Value));
            if (maxDate < DateOnly.FromDateTime(DateTime.Today))
                maxDate = DateOnly.FromDateTime(DateTime.Today);

            var allRows = await QueryVenteRowsAsync(minDate, maxDate);

            foreach (var p in _periodes.OrderByDescending(x => x.FromDate))
            {
                if (!p.FromDate.HasValue || !p.ToDate.HasValue) continue;
                var from = DateOnly.FromDateTime(p.FromDate.Value);
                var to = DateOnly.FromDateTime(p.ToDate.Value);
                var lignes = allRows.Where(r => r.Date >= from && r.Date <= to).ToList();
                if (!lignes.Any()) continue;
                _venteGrouped.Add(new VentePeriodeGroup
                {
                    Label = FormatPeriodeLabel(p),
                    IsActive = p.Activated == true,
                    NbFactures = lignes.Select(l => l.NumFacture).Distinct().Count(),
                    Total = lignes.Sum(l => l.DisplayLineTotal),
                    Lignes = lignes
                });
            }

            var hors = allRows.Where(r => FindPeriodeForDate(r.Date) == null).ToList();
            if (hors.Any())
            {
                _venteGrouped.Add(new VentePeriodeGroup
                {
                    Label = "Hors période comptable",
                    IsHorsPeriode = true,
                    NbFactures = hors.Select(l => l.NumFacture).Distinct().Count(),
                    Total = hors.Sum(l => l.DisplayLineTotal),
                    Lignes = hors
                });
            }
        }
        else
        {
            DateOnly from, to;
            if (int.TryParse(_ventePeriodeFilter, out var pid))
            {
                var p = _periodes.FirstOrDefault(x => x.Id == pid);
                if (p?.FromDate != null && p?.ToDate != null)
                {
                    from = DateOnly.FromDateTime(p.FromDate.Value);
                    to = DateOnly.FromDateTime(p.ToDate.Value);
                }
                else
                {
                    from = _venteFrom.HasValue ? DateOnly.FromDateTime(_venteFrom.Value) : DateOnly.MinValue;
                    to = _venteTo.HasValue ? DateOnly.FromDateTime(_venteTo.Value) : DateOnly.MaxValue;
                }
            }
            else
            {
                from = _venteFrom.HasValue ? DateOnly.FromDateTime(_venteFrom.Value) : DateOnly.MinValue;
                to = _venteTo.HasValue ? DateOnly.FromDateTime(_venteTo.Value) : DateOnly.MaxValue;
            }
            _venteData = await QueryVenteRowsAsync(from, to);
        }

        _venteLoading = false;
        ApplyVenteFilter();
    }

