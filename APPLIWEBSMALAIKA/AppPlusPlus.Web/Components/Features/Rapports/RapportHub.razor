                                            Options="@ToFilterOptions(_benData.Select(r => r.ArticleName), "Article : tous")" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadApproBen">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportBenExcel" disabled="@(!_benData.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_benLoading)
                    {
                        <div class="aw-table-region">
                            <AwSkeleton Variant="table" Rows="5" />
                        </div>
                    }
                    else if (!benPageItems.Any())
                    {
                        <div class="aw-table-region">
                            <div class="aw-empty">
                                <i class="bi bi-graph-down"></i>
                                <p>Aucune ligne d'appro / marge pour ces filtres.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>N°</th>
                                            <th>Article</th>
                                            <th class="aw-table__num">Qté</th>
                                            <th class="aw-table__num">Dépensé</th>
                                            <th class="aw-table__num">Stock act.</th>
                                            <th class="aw-table__num">PA</th>
                                            <th class="aw-table__num">PV</th>
                                            <th class="aw-table__num">Bén. unit.</th>
                                            <th class="aw-table__num">Bén. total</th>
                                            <th>Date</th>
                                            <th>Utilisateur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in benPageItems)
                                        {
                                            var stkBadge = a.StockActuel <= 0 ? "aw-badge--danger" : "aw-badge--brand";
                                            <tr>
                                                <td><span class="aw-table__meta">@a.Id</span></td>
                                                <td><span class="aw-table__title">@a.ArticleName</span></td>
                                                <td class="aw-table__num">@a.Qte.ToString("N2")</td>
                                                <td class="aw-table__num" title="Coût d'achat = Qté × PA">
                                                    <CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="a.Depense" />
                                                </td>
                                                <td class="aw-table__num">
                                                    <span class="aw-badge @stkBadge" title="Stock actuel de l'article">@a.StockActuel.ToString("N0")</span>
                                                </td>
                                                <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="a.PA" /></td>
                                                <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="a.PV" /></td>
                                                <td class="aw-table__num" style="color:@(a.Ben >= 0 ? "var(--bs-success)" : "var(--bs-danger)")">
                                                    <CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="a.Ben" />
                                                </td>
                                                <td class="aw-table__num" style="color:@(a.BenTotal >= 0 ? "var(--bs-success)" : "var(--bs-danger)")">
                                                    <CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="a.BenTotal" />
                                                </td>
                                                <td>@a.Date.ToString("dd/MM/yyyy")</td>
                                                <td>@a.User</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <AwPager TotalCount="_benFiltered.Count"
                                     Page="_benPage"
                                     PageSize="_benPageSize"
                                     ItemLabel="ligne"
                                     PageChanged="SetBenPage"
                                     PageSizeChanged="SetBenPageSize" />
                            <div class="d-flex justify-content-end mt-2 gap-3 flex-wrap">
                                <small class="aw-table__meta">@_benFiltered.Count lignes</small>
                                <small class="fw-bold">Total dépensé : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_benFiltered.Sum(b => b.Depense_Usd)" /></small>
                                <small class="fw-bold text-info">Bénéfice total : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_benFiltered.Sum(b => b.BenTotal_Usd)" /></small>
                            </div>
                        </div>
                    }
                }

                @if (_achatsView == "mouvements")
                {
                    var vaPageItems = PageOf(_vaFiltered, _vaPage, _vaPageSize).ToList();

                    <div class="aw-actionbar">
                        <div class="aw-actionbar__search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search"
                                   placeholder="Rechercher (article, code, utilisateur…)"
                                   aria-label="Rechercher des mouvements"
                                   @bind="_vaSearch"
                                   @bind:event="oninput"
                                   @bind:after="ApplyVaFilter" />
                        </div>
                        <div class="aw-actionbar__filters">
                            <AwDateRange AriaLabel="Période mouvements"
                                         PersistKey="rapports.mouvements"
                                         From="_vaFrom"
                                         To="_vaTo"
                                         FromChanged="OnVaFromChanged"
                                         ToChanged="OnVaToChanged"
                                         Changed="LoadVenteAppro" />
                            <AwSearchSelect AriaLabel="Utilisateur"
                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_vaUserFilter ?? "")"
                                            ValueChanged="OnVaUserFilterChanged"
                                            Options="@ToFilterOptions(_vaData.Select(r => r.Utilisateur), "Utilisateur : tous")" />
                            <AwSearchSelect AriaLabel="Article"
                                            Placeholder="Article"
                                            Searchable="true"
                                            Value="@(_vaArticleFilter ?? "")"
                                            ValueChanged="OnVaArticleFilterChanged"
                                            Options="@ToFilterOptions(_vaData.Select(r => r.Description), "Article : tous")" />
                            <AwSearchSelect AriaLabel="Mouvement"
                                            Placeholder="Mouvement"
                                            Searchable="false"
                                            Value="@(_vaMouvementFilter ?? "")"
                                            ValueChanged="OnVaMouvementFilterChanged"
                                            Options="@ToFilterOptions(_vaData.Select(r => r.Mouvement), "Mouvement : tous")" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadVenteAppro">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportVaExcel" disabled="@(!_vaData.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_vaLoading)
                    {
                        <div class="aw-table-region">
                            <AwSkeleton Variant="table" Rows="5" />
                        </div>
                    }
                    else if (!vaPageItems.Any())
                    {
                        <div class="aw-table-region">
                            <div class="aw-empty">
                                <i class="bi bi-arrow-left-right"></i>
                                <p>Aucun mouvement pour ces filtres.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Article</th>
                                            <th class="aw-table__num">Qté</th>
                                            <th class="aw-table__num">PU</th>
                                            <th>Date</th>
                                            <th>Mouvement</th>
                                            <th>Utilisateur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in vaPageItems)
                                        {
                                            var mvBadge = v.Mouvement == "Entrée" ? "aw-badge--brand" : "aw-badge--danger";
                                            <tr>
                                                <td><span class="aw-table__meta">@v.IdArticle</span></td>
                                                <td><span class="aw-table__title">@v.Description</span></td>
                                                <td class="aw-table__num">@v.Qte.ToString("N2")</td>
                                                <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="v.Pu" /></td>
                                                <td>@v.Date.ToString("dd/MM/yyyy")</td>
                                                <td><span class="aw-badge @mvBadge">@v.Mouvement</span></td>
                                                <td>@v.Utilisateur</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <AwPager TotalCount="_vaFiltered.Count"
                                     Page="_vaPage"
                                     PageSize="_vaPageSize"
                                     ItemLabel="mouvement"
                                     PageChanged="SetVaPage"
                                     PageSizeChanged="SetVaPageSize" />
                            <div class="d-flex justify-content-end mt-2 gap-3">
                                <small class="aw-table__meta">@_vaFiltered.Count mouvements</small>
                                <small class="fw-bold" style="color:var(--bs-success);">Entrées : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="@(_vaFiltered.Where(m => m.Mouvement == "Entrée").Sum(m => m.Qte * m.Pu))" /></small>
                                <small class="fw-bold" style="color:var(--bs-danger);">Sorties : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="@(_vaFiltered.Where(m => m.Mouvement == "Sortie").Sum(m => m.Qte * m.Pu))" /></small>
                            </div>
                        </div>
                    }
                }
            }

            @* ══════════════════ STOCK ══════════════════ *@
            @if (_tab == 3)
            {
                var stockPageItems = PageOf(_stockFiltered, _stockPage, _stockPageSize).ToList();

                <div class="aw-actionbar">
                    <div class="aw-actionbar__search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search"
                               placeholder="Rechercher (code, article, localisation…)"
                               aria-label="Rechercher dans le stock"
                               @bind="_stockSearch"
                               @bind:event="oninput"
                               @bind:after="ApplyStockFilter" />
                    </div>
                    <div class="aw-actionbar__filters">
                        <AwSearchSelect AriaLabel="Localisation"
                                        Placeholder="Localisation"
                                        Searchable="true"
                                        Value="@(_stockLocFilter ?? "")"
                                        ValueChanged="OnStockLocFilterChanged"
                                        Options="@ToFilterOptions(_stockData.Select(r => r.Localisation), "Localisation : toutes")" />
                    </div>
                    <div class="aw-actionbar__actions">
                        <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadStock">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <HubActionsMenu>
                            <li><button type="button" class="dropdown-item" @onclick="@ExportStockExcel" disabled="@(!_stockData.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                            <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                        </HubActionsMenu>
                    </div>
                </div>

                @if (_stockLoading)
                {
                    <div class="aw-table-region">
                        <AwSkeleton Variant="table" Rows="5" />
                    </div>
                }
                else if (!stockPageItems.Any())
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-box-seam"></i>
                            <p>Aucun stock pour ces filtres.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                        <div class="aw-table-wrap">
                            <table class="aw-table">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Article</th>
                                        <th>Localisation</th>
                                        <th class="aw-table__num">Prix</th>
                                        <th class="aw-table__num">Stock</th>
                                        <th class="aw-table__num">Min (seuil)</th>
                                        <th class="aw-table__num">Qté max</th>
                                        <th class="aw-table__num">Valeur stock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in stockPageItems)
                                    {
                                        var stockBadge = s.Qte <= s.Seuil ? "aw-badge--danger" : "aw-badge--brand";
                                        <tr>
                                            <td><span class="aw-table__meta">@s.IdArticle</span></td>
                                            <td><span class="aw-table__title">@s.Description</span></td>
                                            <td>@s.Localisation</td>
                                            <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="@((decimal)s.Price)" /></td>
                                            <td class="aw-table__num"><span class="aw-badge @stockBadge">@s.Qte</span></td>
                                            <td class="aw-table__num">@s.Seuil</td>
                                            <td class="aw-table__num">@s.QteMax</td>
                                            <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="@((decimal)s.ValeurStock)" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <AwPager TotalCount="_stockFiltered.Count"
                                 Page="_stockPage"
                                 PageSize="_stockPageSize"
                                 ItemLabel="ligne"
                                 PageChanged="SetStockPage"
                                 PageSizeChanged="SetStockPageSize" />
                        <div class="d-flex justify-content-end mt-2 gap-3">
                            <small class="aw-table__meta">@_stockFiltered.Count lignes</small>
                            <small class="fw-bold" style="color:var(--aw-brand);">Valeur totale : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="@((decimal)_stockFiltered.Sum(a => a.ValeurStock))" /></small>
                        </div>
                    </div>
                }
            }

            </div>
        </div>
    </div>
}

</ModuleGuard>

@code {
    /* ── Hub ── */
    int _tab;
    bool _loaded;
    bool _canRapportsRead;
    List<int> _currentUserLocalisations = new();

    /* --- Sous-vues fusionnées --- */
    string _activiteView = "bilan";
    string _venteView = "lignes";
    string _achatsView = "commandes";

    static readonly int[] PageSizeChoices = [10, 25, 50, 100];
    static readonly List<AwSearchSelect.Option> _bilanPeriodeOptions = new()
    {
        new("jour", "Jour"),
        new("semaine", "Semaine"),
        new("mois", "Mois")
    };

    readonly Dictionary<string, int> _venteGroupPages = new(StringComparer.Ordinal);
    int _bilanPage = 1, _bilanPageSize = 25;
    int _histoPage = 1, _histoPageSize = 25;
    int _ventePage = 1, _ventePageSize = 25;
    int _vmPage = 1, _vmPageSize = 25;
    int _cmdPage = 1, _cmdPageSize = 25;
    int _benPage = 1, _benPageSize = 25;
    int _vaPage = 1, _vaPageSize = 25;
    int _stockPage = 1, _stockPageSize = 25;

    readonly HashSet<string> _loadedSections = new(StringComparer.Ordinal);

    /* ════════════════════ BILAN ════════════════════ */
    List<BilanRowDto> _bilanRows = new();
    List<BilanRowDto> _bilanFiltered = new();
    string _bilanSearch = "";
    string? _bilanUserFilter;
    string? _bilanTypeFilter;
    bool _bilanLoading;
    string _bilanPeriode = "jour";
    DateTime? _bilanFrom = DateTime.Today;
    DateTime? _bilanTo = DateTime.Today;
    string _bilanTitre = "";
    int _bilanNbFactures;
    decimal _bilanTotalVentes;
    decimal _bilanTotalAppros;
    decimal _bilanBenefice;

    /* ════════════════════ VENTES ════════════════════ */
    List<Periode> _periodes = new();
    string _ventePeriodeFilter = "libre";
    DateTime? _venteFrom = new DateTime(DateTime.Today.Year, 1, 1);
    DateTime? _venteTo = DateTime.Today;
    bool _venteLoading;
    List<RptVenteVm> _venteData = new();
    List<VentePeriodeGroup> _venteGrouped = new();
    List<RptVenteVm> _venteFiltered = new();
    List<VentePeriodeGroup> _venteGroupedFiltered = new();
    string _venteSearch = "";
    string? _venteUserFilter;
    string? _venteArticleFilter;

    record RptVenteVm(
        int NumFacture, string Client, string Article,
        double Qte,
        decimal? LineMontant, int? LineMoneyId, decimal? LineTaux, decimal? LineMontantApres,
        double LegacyPu, double LegacyLineTotal,
        decimal? FactMontant, int? FactMoneyId, decimal? FactMontantApres,
        decimal LegacyFactTotal, decimal Reduction, decimal FactTaux,
        DateOnly Date, string Utilisateur, string PeriodeLabel,
        decimal DisplayPu, decimal DisplayLineTotal, decimal DisplayFactTotal);

    class VentePeriodeGroup
    {
        public string Label { get; set; } = "";
        public bool IsActive { get; set; }
        public bool IsHorsPeriode { get; set; }
        public int NbFactures { get; set; }
        public decimal Total { get; set; }
        public List<RptVenteVm> Lignes { get; set; } = new();
    }

    /* ════════════════════ STOCK ════════════════════ */
    List<StockReportRowDto> _stockData = new();
    List<StockReportRowDto> _stockFiltered = new();
    bool _stockLoading;
    string _stockSearch = "";
    string? _stockLocFilter;

    /* ════════════════════ COMMANDES ════════════════════ */
    List<CommandeReportRowDto> _cmdData = new();
    List<CommandeReportRowDto> _cmdFiltered = new();
    bool _cmdLoading;
    string _cmdSearch = "";
    string? _cmdUserFilter;
    string? _cmdFournisseurFilter;
    DateTime? _cmdFrom = new DateTime(DateTime.Today.Year, 1, 1);
    DateTime? _cmdTo = DateTime.Today;

    /* ════════════════════ APPRO & BÉNÉFICE ════════════════════ */
    List<ApproMargeReportRowDto> _benData = new();
    List<ApproMargeReportRowDto> _benFiltered = new();
    bool _benLoading;
    string _benSearch = "";
    string? _benUserFilter;
    string? _benArticleFilter;
    decimal _benTaux;
    decimal _displayTaux;
    decimal _benTotalUsd;
    DateTime? _benFrom = new DateTime(DateTime.Today.Year, 1, 1);
    DateTime? _benTo = DateTime.Today;

    /* ════════════════════ VENTES MENSUELLES ════════════════════ */
    List<FactMoisRowDto> _vmData = new();
    List<FactMoisRowDto> _vmFiltered = new();
    bool _vmLoading;
    string _vmSearch = "";
    string? _vmUserFilter;
    DateTime? _vmMois = DateTime.Today;
    int _vmTotalFactures;
    decimal _vmTotalMontant;
    decimal _vmTotalReduction;
    decimal _vmTotalNet;

    /* ════════════════════ VENTES & APPRO ════════════════════ */
    List<MouvementReportRowDto> _vaData = new();
    List<MouvementReportRowDto> _vaFiltered = new();
    bool _vaLoading;
    string _vaSearch = "";
    string? _vaUserFilter;
    string? _vaArticleFilter;
    string? _vaMouvementFilter;
    DateTime? _vaFrom = new DateTime(DateTime.Today.Year, 1, 1);
    DateTime? _vaTo = DateTime.Today;

    /* ════════════════════ HISTORIQUE ════════════════════ */
    List<HistoRow> _histoData = new();
    List<HistoRow> _histoFiltered = new();
    bool _histoLoading;
    string _histoSearch = "";
    string? _histoUserFilter;
    DateTime? _histoFrom = new DateTime(DateTime.Today.Year, 1, 1);
    DateTime? _histoTo = DateTime.Today;
    string? _histoTypeFilter;

    List<KeyValuePair<string, string>> _histoTypeOptions = new()
    {
        new("Vente", "Ventes"),
        new("Appro", "Approvisionnements"),
    };

    class HistoRow
    {
        public int RowId { get; set; }
        public DateTime DateOp { get; set; }
        public DateOnly Date { get; set; }
        public string Type { get; set; } = "";
        public string Reference { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Montant { get; set; }
        public int StatusCode { get; set; }
        public string StatusLabel { get; set; } = "";
        public Color StatusStyle { get; set; } = Color.Default;
        public string Utilisateur { get; set; } = "";
        public int? FactId { get; set; }
    }


    /* === PAGINATION & FILTRES AW === */

    IList<T> PageOf<T>(IList<T> items, int page, int pageSize) =>
        items.Skip((page - 1) * pageSize).Take(pageSize).ToList();

    int PageCount(int total, int pageSize) =>
        total <= 0 ? 1 : (int)Math.Ceiling(total / (double)Math.Max(1, pageSize));

    void SetBilanPage(int page) => _bilanPage = Math.Clamp(page, 1, PageCount(_bilanFiltered.Count, _bilanPageSize));
    void SetBilanPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _bilanPageSize = size; _bilanPage = 1; }
    void SetHistoPage(int page) => _histoPage = Math.Clamp(page, 1, PageCount(_histoFiltered.Count, _histoPageSize));
    void SetHistoPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _histoPageSize = size; _histoPage = 1; }
    void SetVentePage(int page) => _ventePage = Math.Clamp(page, 1, PageCount(_venteFiltered.Count, _ventePageSize));
    void SetVentePageSize(int size)
    {
        if (!PageSizeChoices.Contains(size)) return;
        _ventePageSize = size;
        _ventePage = 1;
        foreach (var key in _venteGroupPages.Keys.ToList())
            _venteGroupPages[key] = 1;
    }
    int GetVenteGroupPage(string label) => _venteGroupPages.TryGetValue(label, out var p) ? p : 1;
    void SetVenteGroupPage(string label, int page)
    {
        var group = _venteGroupedFiltered.FirstOrDefault(g => g.Label == label);
        var total = group?.Lignes.Count ?? 0;
        _venteGroupPages[label] = Math.Clamp(page, 1, PageCount(total, _ventePageSize));
    }
    void SetVmPage(int page) => _vmPage = Math.Clamp(page, 1, PageCount(_vmFiltered.Count, _vmPageSize));
    void SetVmPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _vmPageSize = size; _vmPage = 1; }
    void SetCmdPage(int page) => _cmdPage = Math.Clamp(page, 1, PageCount(_cmdFiltered.Count, _cmdPageSize));
    void SetCmdPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _cmdPageSize = size; _cmdPage = 1; }
    void SetBenPage(int page) => _benPage = Math.Clamp(page, 1, PageCount(_benFiltered.Count, _benPageSize));
    void SetBenPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _benPageSize = size; _benPage = 1; }
    void SetVaPage(int page) => _vaPage = Math.Clamp(page, 1, PageCount(_vaFiltered.Count, _vaPageSize));
    void SetVaPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _vaPageSize = size; _vaPage = 1; }
    void SetStockPage(int page) => _stockPage = Math.Clamp(page, 1, PageCount(_stockFiltered.Count, _stockPageSize));
    void SetStockPageSize(int size) { if (!PageSizeChoices.Contains(size)) return; _stockPageSize = size; _stockPage = 1; }

    List<AwSearchSelect.Option> ToFilterOptions(IEnumerable<string?> values, string allLabel)
    {
        var list = new List<AwSearchSelect.Option> { new("", allLabel) };
        foreach (var v in HubFilterHelper.DistinctNonEmpty(values))
            list.Add(new(v, v));
        return list;
    }

    List<AwSearchSelect.Option> GetHistoTypeFilterOptions()
    {
        var list = new List<AwSearchSelect.Option> { new("", "Type : tous") };
        foreach (var o in _histoTypeOptions)
            list.Add(new(o.Key, o.Value));
        return list;
    }

    List<AwSearchSelect.Option> GetVentePeriodeOptions()
    {
        var list = new List<AwSearchSelect.Option>
        {
            new("libre", "Plage libre"),
            new("grouped", "Périodes groupées")
        };
        foreach (var p in _periodes)
        {
            var lbl = FormatPeriodeLabel(p) + (p.Activated == true ? " ★" : "");
            list.Add(new(p.Id.ToString(), lbl));
        }
        return list;
    }

    Task OnBilanPeriodeSelectChanged(string? value)
    {
        _bilanPeriode = string.IsNullOrWhiteSpace(value) ? "jour" : value;
        OnBilanPeriodeChanged();
        return Task.CompletedTask;
    }

    Task OnBilanUserFilterChanged(string? v) { _bilanUserFilter = string.IsNullOrWhiteSpace(v) ? null : v; ApplyBilanFilter(); return Task.CompletedTask; }
    Task OnBilanTypeFilterChanged(string? v) { _bilanTypeFilter = string.IsNullOrWhiteSpace(v) ? null : v; ApplyBilanFilter(); return Task.CompletedTask; }
    Task OnHistoUserFilterChanged(string? v) { _histoUserFilter = string.IsNullOrWhiteSpace(v) ? null : v; ApplyHistoriqueFilter(); return Task.CompletedTask; }
