                                    <span class="aw-overview__cover-value"><CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_vmTotalNet" /></span>
                                    <span class="aw-overview__cover-label">net du mois</span>
                                </div>
                            </div>
