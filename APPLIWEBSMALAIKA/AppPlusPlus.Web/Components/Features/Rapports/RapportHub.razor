@page "/rapports"
@using MudBlazor
@rendermode InteractiveServer
@implements IDisposable
@inject IRapportQueryService RapportQuery
@inject ILocalisationService LocalisationService
@inject IFinanceService FinanceService
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionResolver PermissionResolver
@inject IJSRuntime JS
@inject MudBlazor.IDialogService DialogService
@inject ISnackbar Snackbar
@using System.Security.Claims
@using AppPlusPlus.Application.Services.Finance
@using AppPlusPlus.Application.Services.Rapports
@using AppPlusPlus.Application.DTOs.Rapports
@using AppPlusPlus.Domain.Entities.Finance

<ModuleGuard ModuleCode="rapports" ModuleName="Rapports & Analyses">

<PageTitle>@AppSettings.AppName — Rapports</PageTitle>

@if (!_loaded)
{
    <div class="aw-page">
        <AwSkeleton Variant="page" Rows="7" />
    </div>
}
else if (!_canRapportsRead)
{
    <div class="aw-page">
        <div class="aw-shell" style="max-width:720px;margin:1.5rem auto;">
            <div class="aw-empty">
                <i class="bi bi-lock"></i>
                <p><strong>Accès refusé</strong><br />Votre rôle ne possède pas les droits d'accès au module Rapports.</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="aw-page aw-page--workspace">
        <div class="aw-workspace">
            <header class="aw-object-head">
                <div class="aw-object-head__identity">
                    <p class="aw-object-head__eyebrow">Module rapports</p>
                    <h1 class="aw-object-head__title">Rapports &amp; Analyses</h1>
                    <p class="aw-object-head__desc">@GetRapportSectionDescription()</p>
                </div>
            </header>

            <nav class="aw-railnav" aria-label="Sections rapports" role="tablist">
                <button type="button" role="tab" aria-selected="@(_tab == 0)"
                        class="aw-railnav__item @(_tab == 0 ? "aw-railnav__item--active" : "")"
                        title="Bilan et historique d'activité"
                        @onclick="@(async () => await OnTabChange(0))">
                    <i class="bi bi-activity" aria-hidden="true"></i>
                    Activité
                </button>
                <button type="button" role="tab" aria-selected="@(_tab == 1)"
                        class="aw-railnav__item @(_tab == 1 ? "aw-railnav__item--active" : "")"
                        title="Ventes par lignes et factures"
                        @onclick="@(async () => await OnTabChange(1))">
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                    Ventes
                </button>
                <button type="button" role="tab" aria-selected="@(_tab == 2)"
                        class="aw-railnav__item @(_tab == 2 ? "aw-railnav__item--active" : "")"
                        title="Commandes, marges et mouvements"
                        @onclick="@(async () => await OnTabChange(2))">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    Achats &amp; Appro
                </button>
                <button type="button" role="tab" aria-selected="@(_tab == 3)"
                        class="aw-railnav__item @(_tab == 3 ? "aw-railnav__item--active" : "")"
                        title="Inventaire stock"
                        @onclick="@(async () => await OnTabChange(3))">
                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                    Stock
                </button>
            </nav>

            <div class="aw-workspace__body">

            @* ══════════════════ ACTIVITÉ ══════════════════ *@
            @if (_tab == 0)
            {
                <nav class="aw-modnav" aria-label="Vues activité" role="tablist">
                    <button type="button" role="tab" aria-selected="@(_activiteView == "bilan")"
                            class="aw-modnav__item @(_activiteView == "bilan" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnActiviteViewChanged("bilan"))'>
                        <i class="bi bi-graph-up" aria-hidden="true"></i>
                        <span>Bilan</span>
                    </button>
                    <button type="button" role="tab" aria-selected="@(_activiteView == "historique")"
                            class="aw-modnav__item @(_activiteView == "historique" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnActiviteViewChanged("historique"))'>
                        <i class="bi bi-clock-history" aria-hidden="true"></i>
                        <span>Historique</span>
                    </button>
                </nav>

                @if (_activiteView == "bilan")
                {
                    var bilanPageItems = PageOf(_bilanFiltered, _bilanPage, _bilanPageSize).ToList();

                    @if (_bilanRows.Any() || _bilanLoading)
                    {
                        <section class="aw-overview" aria-label="Vue d'ensemble bilan">
                            <div class="aw-overview__top">
                                <div class="aw-overview__intro">
                                    <h2 class="aw-overview__title">@_bilanTitre</h2>
                                    <p class="aw-overview__lead">Synthèse des ventes, approvisionnements et bénéfice sur la période.</p>
                                </div>
                                <div class="@($"aw-overview__cover {(_bilanBenefice >= 0 ? "aw-overview__cover--brand" : "aw-overview__cover--danger")}")">
                                    <span class="aw-overview__cover-value"><CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_bilanBenefice" /></span>
                                    <span class="aw-overview__cover-label">bénéfice</span>
                                </div>
                            </div>
                            <div class="aw-overview__metrics">
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-receipt"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Factures</span>
                                        <span class="aw-overview__metric-value">@_bilanNbFactures</span>
                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Ventes</span>
                                        <span class="aw-overview__metric-value"><CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_bilanTotalVentes" /></span>
                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-truck"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Appros</span>
                                        <span class="aw-overview__metric-value"><CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_bilanTotalAppros" /></span>
                                    </div>
                                </article>
                            </div>
                        </section>
                    }

                    <div class="aw-actionbar">
                        <div class="aw-actionbar__search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search"
                                   placeholder="Rechercher (réf., description, utilisateur…)"
                                   aria-label="Rechercher dans le bilan"
                                   @bind="_bilanSearch"
                                   @bind:event="oninput"
                                   @bind:after="ApplyBilanFilter" />
                        </div>
                        <div class="aw-actionbar__filters">
                            <AwSearchSelect AriaLabel="Période bilan"
                                            Placeholder="Période"
                                            Searchable="false"
                                            Value="@_bilanPeriode"
                                            ValueChanged="OnBilanPeriodeSelectChanged"
                                            Options="@_bilanPeriodeOptions" />
                            <AwDateRange AriaLabel="Date du bilan"
                                         SingleDay="@(_bilanPeriode == "jour")"
                                         ApplyOnSelect="@(_bilanPeriode == "jour")"
                                         PersistKey="rapports.bilan"
                                         From="_bilanFrom"
                                         To="_bilanTo"
                                         FromChanged="OnBilanFromChanged"
                                         ToChanged="OnBilanToChanged"
                                         Changed="LoadBilan" />
                            <AwSearchSelect AriaLabel="Utilisateur"
                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_bilanUserFilter ?? "")"
                                            ValueChanged="OnBilanUserFilterChanged"
                                            Options="@ToFilterOptions(_bilanRows.Select(r => r.Utilisateur), "Utilisateur : tous")" />
                            <AwSearchSelect AriaLabel="Type"
                                            Placeholder="Type"
                                            Searchable="false"
                                            Value="@(_bilanTypeFilter ?? "")"
                                            ValueChanged="OnBilanTypeFilterChanged"
                                            Options="@ToFilterOptions(_bilanRows.Select(r => r.Type), "Type : tous")" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadBilan">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportBilanExcel" disabled="@(!_bilanRows.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@SendBilanEmail" disabled="@(!_bilanRows.Any())"><i class="bi bi-envelope me-2"></i>Envoyer par email</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_bilanLoading)
                    {
                        <div class="aw-table-region">
                            <AwSkeleton Variant="table" Rows="5" />
                        </div>
                    }
                    else if (!bilanPageItems.Any())
                    {
                        <div class="aw-table-region">
                            <div class="aw-empty">
                                <i class="bi bi-activity"></i>
                                <p>Aucune ligne d'activité pour ces filtres.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Réf.</th>
                                            <th>Description</th>
                                            <th class="aw-table__num">Qté</th>
                                            <th class="aw-table__num">Montant</th>
                                            <th>Utilisateur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in bilanPageItems)
                                        {
                                            var typeBadge = r.Type switch
                                            {
                                                "Vente" => "aw-badge--brand",
                                                "Appro" => "aw-badge--accent",
                                                "Transfert" => "aw-badge--accent",
                                                _ => "aw-badge--muted"
                                            };
                                            <tr>
                                                <td>@r.Date.ToString("dd/MM/yyyy")</td>
                                                <td><span class="aw-badge @typeBadge">@r.Type</span></td>
                                                <td><span class="aw-table__meta">@r.Reference</span></td>
                                                <td><span class="aw-table__title">@r.Description</span></td>
                                                <td class="aw-table__num">@r.Qte.ToString("N0")</td>
                                                <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="r.Montant" /></td>
                                                <td>@r.Utilisateur</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <AwPager TotalCount="_bilanFiltered.Count"
                                     Page="_bilanPage"
                                     PageSize="_bilanPageSize"
                                     ItemLabel="ligne"
                                     PageChanged="SetBilanPage"
                                     PageSizeChanged="SetBilanPageSize" />
                            <div class="d-flex justify-content-end mt-2 gap-3">
                                <small class="aw-table__meta">@_bilanFiltered.Count lignes</small>
                                <small class="fw-bold" style="color:var(--aw-brand);">Total : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_bilanFiltered.Sum(r => r.Montant)" /></small>
                            </div>
                        </div>
                    }
                }

                @if (_activiteView == "historique")
                {
                    var histoPageItems = PageOf(_histoFiltered, _histoPage, _histoPageSize).ToList();
                    var histoVentes = _histoFiltered.Count(r => r.Type == "Vente");
                    var histoAppros = _histoFiltered.Count(r => r.Type == "Appro");

                    @if (_histoData.Any() || _histoLoading)
                    {
                        <section class="aw-overview" aria-label="Vue d'ensemble historique">
                            <div class="aw-overview__top">
                                <div class="aw-overview__intro">
                                    <h2 class="aw-overview__title">Historique d'activité</h2>
                                    <p class="aw-overview__lead">Chronologie des ventes et approvisionnements avec statut.</p>
                                </div>
                                <div class="aw-overview__cover aw-overview__cover--brand">
                                    <span class="aw-overview__cover-value">@_histoFiltered.Count</span>
                                    <span class="aw-overview__cover-label">opération(s)</span>
                                </div>
                            </div>
                            <div class="aw-overview__metrics">
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-cart-check"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Ventes</span>
                                        <span class="aw-overview__metric-value">@histoVentes</span>
                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-box-arrow-in-down"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Appros</span>
                                        <span class="aw-overview__metric-value">@histoAppros</span>
                                    </div>
                                </article>
                            </div>
                        </section>
                    }

                    <div class="aw-actionbar">
                        <div class="aw-actionbar__search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search"
                                   placeholder="Rechercher (réf., description, utilisateur…)"
                                   aria-label="Rechercher dans l'historique"
                                   @bind="_histoSearch"
                                   @bind:event="oninput"
                                   @bind:after="ApplyHistoriqueFilter" />
                        </div>
                        <div class="aw-actionbar__filters">
                            <AwDateRange AriaLabel="Période historique"
                                         PersistKey="rapports.historique"
                                         From="_histoFrom"
                                         To="_histoTo"
                                         FromChanged="OnHistoFromChanged"
                                         ToChanged="OnHistoToChanged"
                                         Changed="LoadHistorique" />
                            <AwSearchSelect AriaLabel="Utilisateur"
                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_histoUserFilter ?? "")"
                                            ValueChanged="OnHistoUserFilterChanged"
                                            Options="@ToFilterOptions(_histoData.Select(r => r.Utilisateur), "Utilisateur : tous")" />
                            <AwSearchSelect AriaLabel="Type"
                                            Placeholder="Type"
                                            Searchable="false"
                                            Value="@(_histoTypeFilter ?? "")"
                                            ValueChanged="OnHistoTypeFilterChanged"
                                            Options="@GetHistoTypeFilterOptions()" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadHistorique">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportHistoExcel" disabled="@(!_histoFiltered.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_histoLoading)
                    {
                        <div class="aw-table-region">
                            <AwSkeleton Variant="table" Rows="5" />
                        </div>
                    }
                    else if (!histoPageItems.Any())
                    {
                        <div class="aw-table-region">
                            <div class="aw-empty">
                                <i class="bi bi-clock-history"></i>
                                <p>Aucun historique pour ces filtres.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Réf.</th>
                                            <th>Description</th>
                                            <th class="aw-table__num">Montant</th>
                                            <th>Statut</th>
                                            <th>Utilisateur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in histoPageItems)
                                        {
                                            var histoTypeBadge = r.Type switch
                                            {
                                                "Vente" => "aw-badge--brand",
                                                "Appro" => "aw-badge--accent",
                                                _ => "aw-badge--muted"
                                            };
                                            var histoStatBadge = r.StatusLabel switch
                                            {
                                                "Payée" or "Effectué" => "aw-badge--brand",
                                                "Brouillon" => "aw-badge--accent",
                                                "Annulée" => "aw-badge--danger",
                                                "Validée" => "aw-badge--accent",
                                                _ => "aw-badge--muted"
                                            };
                                            <tr style="@(r.FactId.HasValue ? "cursor:pointer;" : null)" @onclick="@(() => OnHistoRowClick(r))">
                                                <td>@r.DateOp.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td><span class="aw-badge @histoTypeBadge">@r.Type</span></td>
                                                <td><span class="aw-table__meta">@r.Reference</span></td>
                                                <td><span class="aw-table__title">@r.Description</span></td>
                                                <td class="aw-table__num"><CurrencyText Mode="@CurrencyText.DisplayMode.Business" Amount="r.Montant" /></td>
                                                <td><span class="aw-badge @histoStatBadge">@r.StatusLabel</span></td>
                                                <td>@r.Utilisateur</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <AwPager TotalCount="_histoFiltered.Count"
                                     Page="_histoPage"
                                     PageSize="_histoPageSize"
                                     ItemLabel="ligne"
                                     PageChanged="SetHistoPage"
                                     PageSizeChanged="SetHistoPageSize" />
                            <div class="d-flex justify-content-end mt-2 gap-3">
                                <small class="aw-table__meta">@_histoFiltered.Count lignes</small>
                                <small class="fw-bold" style="color:var(--aw-brand);">Total : <CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_histoFiltered.Sum(h => h.Montant)" /></small>
                            </div>
                        </div>
                    }
                }
            }

            @* ══════════════════ VENTES ══════════════════ *@
            @if (_tab == 1)
            {
                <nav class="aw-modnav" aria-label="Vues ventes" role="tablist">
                    <button type="button" role="tab" aria-selected="@(_venteView == "lignes")"
                            class="aw-modnav__item @(_venteView == "lignes" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnVenteViewChanged("lignes"))'>
                        <i class="bi bi-list-ul" aria-hidden="true"></i>
                        <span>Détail lignes</span>
                    </button>
                    <button type="button" role="tab" aria-selected="@(_venteView == "factures")"
                            class="aw-modnav__item @(_venteView == "factures" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnVenteViewChanged("factures"))'>
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                        <span>Factures du mois</span>
                    </button>
                </nav>

                @if (_venteView == "lignes")
                {
                    var ventePageItems = PageOf(_venteFiltered, _ventePage, _ventePageSize).ToList();

                    <div class="aw-actionbar">
                        <div class="aw-actionbar__search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search"
                                   placeholder="Rechercher (n° facture, client, article, utilisateur…)"
                                   aria-label="Rechercher des lignes de vente"
                                   @bind="_venteSearch"
                                   @bind:event="oninput"
                                   @bind:after="ApplyVenteFilter" />
                        </div>
                        <div class="aw-actionbar__filters">
                            <AwSearchSelect AriaLabel="Période comptable"
                                            Placeholder="Période"
                                            Searchable="true"
                                            Value="@_ventePeriodeFilter"
                                            ValueChanged="OnVentePeriodeSelectChanged"
                                            Options="@GetVentePeriodeOptions()" />
                            @if (_ventePeriodeFilter == "libre")
                            {
                                <AwDateRange AriaLabel="Période libre ventes"
                                             PersistKey="rapports.ventes.libre"
                                             From="_venteFrom"
                                             To="_venteTo"
                                             FromChanged="OnVenteFromChanged"
                                             ToChanged="OnVenteToChanged"
                                             Changed="LoadVentes" />
                            }
                            else if (int.TryParse(_ventePeriodeFilter, out _))
                            {
                                var sel = _periodes.FirstOrDefault(p => p.Id.ToString() == _ventePeriodeFilter);
                                if (sel != null)
                                {
                                    <span class="aw-badge @(sel.Activated == true ? "aw-badge--brand" : "aw-badge--muted")">
                                        @sel.FromDate?.ToString("dd/MM/yyyy") — @sel.ToDate?.ToString("dd/MM/yyyy")
                                    </span>
                                }
                            }
                            <AwSearchSelect AriaLabel="Utilisateur"
                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_venteUserFilter ?? "")"
                                            ValueChanged="OnVenteUserFilterChanged"
                                            Options="@ToFilterOptions(VenteUserOptions(), "Utilisateur : tous")" />
                            <AwSearchSelect AriaLabel="Article"
                                            Placeholder="Article"
                                            Searchable="true"
                                            Value="@(_venteArticleFilter ?? "")"
                                            ValueChanged="OnVenteArticleFilterChanged"
                                            Options="@ToFilterOptions(VenteArticleOptions(), "Article : tous")" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadVentes">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportVenteExcel" disabled="@(!HasVenteExportData())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_ventePeriodeFilter == "grouped")
                    {
                        @if (_venteLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_venteGroupedFiltered.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-calendar-x"></i>
                                    <p>Aucune vente sur les périodes comptables définies.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var g in _venteGroupedFiltered)
                            {
                                var gPage = GetVenteGroupPage(g.Label);
                                var gPageSize = _ventePageSize;
                                var gItems = PageOf(g.Lignes, gPage, gPageSize).ToList();
                                <div class="aw-shell mb-3" style="padding:0;">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2" style="border-bottom:1px solid var(--aw-line,#e2e8f0);">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                                            <span class="fw-semibold">@g.Label</span>
                                            @if (g.IsActive)
                                            {
                                                <span class="aw-badge aw-badge--brand"><i class="bi bi-check-circle me-1"></i>Active</span>
                                            }
                                            @if (g.IsHorsPeriode)
                                            {
                                                <span class="aw-badge aw-badge--accent"><i class="bi bi-exclamation-triangle me-1"></i>Hors période</span>
                                            }
                                        </div>
