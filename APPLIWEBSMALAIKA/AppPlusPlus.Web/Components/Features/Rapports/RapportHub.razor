    IEnumerable<RptVenteVm> FilterVenteRows(IEnumerable<RptVenteVm> source)
    {
        var q = source.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_venteSearch))
            q = q.Where(r => HubFilterHelper.MatchesSearch(_venteSearch,
                r.NumFacture.ToString(), r.Client, r.Article, r.Utilisateur, r.PeriodeLabel));
        if (!string.IsNullOrWhiteSpace(_venteUserFilter))
            q = q.Where(r => HubFilterHelper.MatchesFilter(_venteUserFilter, r.Utilisateur));
        if (!string.IsNullOrWhiteSpace(_venteArticleFilter))
            q = q.Where(r => HubFilterHelper.MatchesFilter(_venteArticleFilter, r.Article));
        return q;
    }

    void ApplyVenteFilter() {
        _ventePage = 1;
        _venteGroupPages.Clear();
        _venteFiltered = FilterVenteRows(_venteData).ToList();
        _venteGroupedFiltered = _venteGrouped
            .Select(g =>
            {
                var lignes = FilterVenteRows(g.Lignes).ToList();
                return new VentePeriodeGroup
                {
                    Label = g.Label,
                    IsActive = g.IsActive,
                    IsHorsPeriode = g.IsHorsPeriode,
                    Lignes = lignes,
                    NbFactures = lignes.Select(l => l.NumFacture).Distinct().Count(),
                    Total = lignes.Sum(l => l.DisplayLineTotal)
                };
            })
            .Where(g => g.Lignes.Any())
            .ToList();
    }

    List<string> VenteUserOptions() =>
        HubFilterHelper.DistinctNonEmpty(
            (_ventePeriodeFilter == "grouped" ? _venteGrouped.SelectMany(g => g.Lignes) : _venteData)
