    protected override async Task OnInitializedAsync()
    {
        UserCurrency.OnChanged += OnCurrencyPreferenceChanged;
        await UserCurrency.EnsureLoadedAsync();

        // Fetch user's assigned localisations via service
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var login = user.FindFirst("login")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var isAdmin = AppFunctions.Normalize(user.FindFirst(ClaimTypes.Role)?.Value) == "administrateur";

            if (!string.IsNullOrEmpty(login))
            {
                _currentUserLocalisations = await LocalisationService.GetUserLocalisationIdsAsync(login, isAdmin);
            }

            var perms = await PermissionResolver.GetPermissionsAsync(login);
            _canRapportsRead = PermissionGate.ViewTab(perms, "rapports",
                () => PermissionGate.LegacyRead(perms, AppFunctions.Rapports, isAdmin));
        }

        SetBilanPeriodDates();
        try { _periodes = await FinanceService.GetPeriodesAsync(); } catch { _periodes = new(); }
        var activePeriode = _periodes.FirstOrDefault(p => p.Activated == true);
        if (activePeriode != null)
        {
            _ventePeriodeFilter = activePeriode.Id.ToString();
            if (activePeriode.FromDate.HasValue) _venteFrom = activePeriode.FromDate.Value;
            if (activePeriode.ToDate.HasValue) _venteTo = activePeriode.ToDate.Value;
        }
        _displayTaux = await RapportQuery.GetLatestTauxAsync();
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var saved = await JS.InvokeAsync<int>("tabNavigation.getTab", "rapport", 100);
            ApplySavedTabState(saved, persistMigration: true);
        }
        catch { }

        await EnsureActiveSectionLoadedAsync();
        await InvokeAsync(StateHasChanged);
    }

    void OnCurrencyPreferenceChanged()
    {
        if (!_loaded) return;
        RefreshCurrencyDisplay();
        _ = InvokeAsync(StateHasChanged);
    }

    void RefreshCurrencyDisplay()
    {
        var taux = _displayTaux > 0 ? _displayTaux : UserCurrency.CachedTaux;
        if (_venteData.Count > 0)
            _venteData = _venteData.Select(r => EnrichVenteRow(r, taux)).ToList();

        if (_venteGrouped.Count > 0)
        {
            _venteGrouped = _venteGrouped.Select(g =>
            {
                var lignes = g.Lignes.Select(r => EnrichVenteRow(r, taux)).ToList();
                return new VentePeriodeGroup
                {
                    Label = g.Label,
                    IsActive = g.IsActive,
                    IsHorsPeriode = g.IsHorsPeriode,
                    NbFactures = g.NbFactures,
                    Lignes = lignes,
                    Total = lignes.Sum(l => l.DisplayLineTotal)
                };
            }).ToList();
        }

        if (_venteData.Count > 0 || _venteGrouped.Count > 0)
            ApplyVenteFilter();
    }

    public void Dispose() => UserCurrency.OnChanged -= OnCurrencyPreferenceChanged;

    static int EncodeTabState(int tab, int subIndex) => (tab + 1) * 100 + subIndex;

    static (int tab, int subIndex) DecodeTabState(int encoded) => (encoded / 100 - 1, encoded % 100);

    static (int tab, int subIndex) MapLegacyTab(int legacyTab) => legacyTab switch
    {
        0 => (0, 0),
        7 => (0, 1),
        1 => (1, 0),
        5 => (1, 1),
        3 => (2, 0),
        4 => (2, 1),
        6 => (2, 2),
        2 => (3, 0),
        _ => (0, 0)
    };

    void ApplySavedTabState(int saved, bool persistMigration)
    {
        int tab;
        int subIndex;
        if (saved < 100)
        {
            (tab, subIndex) = MapLegacyTab(saved);
            if (persistMigration)
                _ = PersistTabStateAsync(tab, subIndex);
        }
        else
        {
            (tab, subIndex) = DecodeTabState(saved);
            tab = Math.Clamp(tab, 0, 3);
        }

        _tab = tab;
        ApplySubViewIndex(tab, subIndex);
    }

    void ApplySubViewIndex(int tab, int subIndex)
    {
        switch (tab)
        {
            case 0:
                _activiteView = subIndex == 1 ? "historique" : "bilan";
                break;
            case 1:
                _venteView = subIndex == 1 ? "factures" : "lignes";
                break;
            case 2:
                _achatsView = subIndex switch
                {
                    1 => "marges",
                    2 => "mouvements",
                    _ => "commandes"
                };
                break;
        }
    }

    int CurrentSubIndex() => _tab switch
    {
        0 => _activiteView == "historique" ? 1 : 0,
        1 => _venteView == "factures" ? 1 : 0,
        2 => _achatsView switch { "marges" => 1, "mouvements" => 2, _ => 0 },
        _ => 0
    };

    async Task PersistTabStateAsync(int tab, int subIndex)
    {
        try
        {
            await JS.InvokeVoidAsync("tabNavigation.saveTab", "rapport", EncodeTabState(tab, subIndex));
        }
        catch { }
    }

    async Task OnTabChange(int tabIndex)
    {
        _tab = tabIndex;
        await PersistTabStateAsync(tabIndex, CurrentSubIndex());
        await EnsureActiveSectionLoadedAsync();
    }

    string GetRapportSectionDescription() => _tab switch
    {
        1 => "Analyse des ventes par lignes de facture et synthèse mensuelle.",
        2 => "Commandes fournisseurs, marges d'approvisionnement et mouvements.",
        3 => "Inventaire et valorisation du stock par article et localisation.",
        _ => "Bilan d'activité et historique des opérations."
    };

    async Task OnActiviteViewChanged(string view)
    {
        _activiteView = view;
        await PersistTabStateAsync(0, view == "historique" ? 1 : 0);
        await EnsureSectionLoadedAsync(view == "historique" ? "historique" : "bilan");
    }

    async Task OnVenteViewChanged(string view)
    {
        _venteView = view;
        await PersistTabStateAsync(1, view == "factures" ? 1 : 0);
        await EnsureSectionLoadedAsync(view == "factures" ? "ventes-mois" : "ventes");
    }

    async Task OnAchatsViewChanged(string view)
    {
        _achatsView = view;
        var sub = view switch { "marges" => 1, "mouvements" => 2, _ => 0 };
        await PersistTabStateAsync(2, sub);
        await EnsureSectionLoadedAsync(view switch
        {
            "marges" => "appro-ben",
            "mouvements" => "vente-appro",
            _ => "commandes"
        });
    }

    async Task EnsureActiveSectionLoadedAsync()
    {
        switch (_tab)
        {
            case 0:
                await EnsureSectionLoadedAsync(_activiteView == "historique" ? "historique" : "bilan");
                break;
            case 1:
                await EnsureSectionLoadedAsync(_venteView == "factures" ? "ventes-mois" : "ventes");
                break;
            case 2:
                await EnsureSectionLoadedAsync(_achatsView switch
                {
                    "marges" => "appro-ben",
                    "mouvements" => "vente-appro",
                    _ => "commandes"
                });
                break;
            case 3:
                await EnsureSectionLoadedAsync("stock");
                break;
        }
    }

    async Task EnsureSectionLoadedAsync(string section)
    {
        if (_loadedSections.Contains(section)) return;
        _loadedSections.Add(section);
        switch (section)
        {
            case "bilan": await LoadBilan(); break;
            case "historique": await LoadHistorique(); break;
            case "ventes": await LoadVentes(); break;
            case "ventes-mois": await LoadVenteMois(); break;
            case "stock": await LoadStock(); break;
            case "commandes": await LoadCommandes(); break;
            case "appro-ben": await LoadApproBen(); break;
            case "vente-appro": await LoadVenteAppro(); break;
        }
    }

