                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-percent"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Réductions</span>
                                        <span class="aw-overview__metric-value"><CurrencyText Inline="true" Mode="@CurrencyText.DisplayMode.Business" Amount="_vmTotalReduction" /></span>
                                    </div>
                                </article>
                            </div>
                        </section>
                    }

                    <div class="aw-actionbar">
                        <div class="aw-actionbar__search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search"
                                   placeholder="Rechercher (n° facture, client, utilisateur…)"
                                   aria-label="Rechercher des factures"
                                   @bind="_vmSearch"
                                   @bind:event="oninput"
                                   @bind:after="ApplyVmFilter" />
                        </div>
                        <div class="aw-actionbar__filters">
                            <AwDateRange AriaLabel="Mois des factures"
                                         SingleDay="true"
                                         PersistKey="rapports.factures.mois"
                                         From="_vmMois"
                                         To="_vmMois"
                                         FromChanged="OnVmMoisChanged"
                                         ToChanged="OnVmMoisChanged"
                                         Changed="LoadVenteMois" />
                            <AwSearchSelect AriaLabel="Utilisateur"
                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_vmUserFilter ?? "")"
                                            ValueChanged="OnVmUserFilterChanged"
                                            Options="@ToFilterOptions(_vmData.Select(f => f.User), "Utilisateur : tous")" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadVenteMois">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportVmExcel" disabled="@(!_vmData.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_vmLoading)
                    {
                        <div class="aw-table-region">
                            <AwSkeleton Variant="table" Rows="5" />
