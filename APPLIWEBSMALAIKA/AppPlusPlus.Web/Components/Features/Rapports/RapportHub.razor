                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_benUserFilter ?? "")"
                                            ValueChanged="OnBenUserFilterChanged"
                                            Options="@ToFilterOptions(_benData.Select(r => r.User), "Utilisateur : tous")" />
                            <AwSearchSelect AriaLabel="Article"
                                            Placeholder="Article"
                                            Searchable="true"
