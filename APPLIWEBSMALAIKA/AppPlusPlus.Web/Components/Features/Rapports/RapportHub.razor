                            class="aw-modnav__item @(_achatsView == "commandes" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnAchatsViewChanged("commandes"))'>
                        <i class="bi bi-list-check" aria-hidden="true"></i>
                        <span>Commandes</span>
                    </button>
                    <button type="button" role="tab" aria-selected="@(_achatsView == "marges")"
                            class="aw-modnav__item @(_achatsView == "marges" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnAchatsViewChanged("marges"))'>
                        <i class="bi bi-graph-down" aria-hidden="true"></i>
                        <span>Appro &amp; marges</span>
                    </button>
                    <button type="button" role="tab" aria-selected="@(_achatsView == "mouvements")"
                            class="aw-modnav__item @(_achatsView == "mouvements" ? "aw-modnav__item--active" : "")"
                            @onclick='@(async () => await OnAchatsViewChanged("mouvements"))'>
                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                        <span>Mouvements</span>
                    </button>
                </nav>

                @if (_achatsView == "commandes")
                {
                    var cmdPageItems = PageOf(_cmdFiltered, _cmdPage, _cmdPageSize).ToList();
                    var cmdNouvelles = _cmdData.Count(r => r.Status == 0);
                    var cmdEnCours = _cmdData.Count(r => r.Status == 1);
                    var cmdRecues = _cmdData.Count(r => r.Status == 2);
                    var cmdAnnulees = _cmdData.Count(r => r.Status == 3);

                    @if (_cmdData.Any() || _cmdLoading)
                    {
                        <section class="aw-overview" aria-label="Vue d'ensemble commandes rapport">
                            <div class="aw-overview__top">
                                <div class="aw-overview__intro">
                                    <h2 class="aw-overview__title">Commandes fournisseurs</h2>
                                    <p class="aw-overview__lead">Suivi des commandes, articles et taux de réception.</p>
                                </div>
                                <div class="aw-overview__cover aw-overview__cover--brand">
                                    <span class="aw-overview__cover-value">@_cmdData.Count</span>
                                    <span class="aw-overview__cover-label">commande(s)</span>
                                </div>
                            </div>
                            <div class="aw-overview__metrics">
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-plus-circle"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Nouvelles</span>
                                        <span class="aw-overview__metric-value">@cmdNouvelles</span>
                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">En cours</span>
                                        <span class="aw-overview__metric-value">@cmdEnCours</span>
                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--brand" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Reçues</span>
                                        <span class="aw-overview__metric-value">@cmdRecues</span>
                                    </div>
                                </article>
                                <article class="aw-overview__metric">
                                    <span class="aw-overview__icon aw-overview__icon--accent" aria-hidden="true"><i class="bi bi-x-circle"></i></span>
                                    <div class="aw-overview__metric-body">
                                        <span class="aw-overview__metric-label">Annulées</span>
                                        <span class="aw-overview__metric-value">@cmdAnnulees</span>
                                    </div>
                                </article>
                            </div>
                        </section>
                    }

                    <div class="aw-actionbar">
                        <div class="aw-actionbar__search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search"
                                   placeholder="Rechercher (n°, fournisseur, article, utilisateur…)"
                                   aria-label="Rechercher des commandes"
                                   @bind="_cmdSearch"
                                   @bind:event="oninput"
                                   @bind:after="ApplyCmdFilter" />
