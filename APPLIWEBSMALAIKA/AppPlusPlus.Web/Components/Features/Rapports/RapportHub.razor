        IEnumerable<RptVenteVm> exportRows = _ventePeriodeFilter == "grouped"
            ? _venteGroupedFiltered.SelectMany(g => g.Lignes)
            : _venteFiltered;
        foreach (var r in exportRows)
        {
            ws.Cell(row, 1).Value = r.PeriodeLabel;
