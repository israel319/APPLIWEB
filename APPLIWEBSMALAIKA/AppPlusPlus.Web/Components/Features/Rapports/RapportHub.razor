                            <AwDateRange AriaLabel="Période commandes"
                                         PersistKey="rapports.commandes"
                                         From="_cmdFrom"
                                         To="_cmdTo"
                                         FromChanged="OnCmdFromChanged"
                                         ToChanged="OnCmdToChanged"
                                         Changed="LoadCommandes" />
                            <AwSearchSelect AriaLabel="Fournisseur"
                                            Placeholder="Fournisseur"
                                            Searchable="true"
                                            Value="@(_cmdFournisseurFilter ?? "")"
                                            ValueChanged="OnCmdFournisseurFilterChanged"
                                            Options="@ToFilterOptions(_cmdData.Select(r => r.Fournisseur), "Fournisseur : tous")" />
                            <AwSearchSelect AriaLabel="Utilisateur"
                                            Placeholder="Utilisateur"
                                            Searchable="true"
                                            Value="@(_cmdUserFilter ?? "")"
                                            ValueChanged="OnCmdUserFilterChanged"
                                            Options="@ToFilterOptions(_cmdData.Select(r => r.User), "Utilisateur : tous")" />
                        </div>
                        <div class="aw-actionbar__actions">
                            <button type="button" class="aw-btn aw-btn--ghost" title="Actualiser" @onclick="LoadCommandes">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <HubActionsMenu>
                                <li><button type="button" class="dropdown-item" @onclick="@ExportCmdExcel" disabled="@(!_cmdData.Any())"><i class="bi bi-file-earmark-excel me-2"></i>Exporter Excel</button></li>
                                <li><button type="button" class="dropdown-item" @onclick="@(() => JS.InvokeVoidAsync("printReport"))"><i class="bi bi-printer me-2"></i>Imprimer</button></li>
                            </HubActionsMenu>
                        </div>
                    </div>

                    @if (_cmdLoading)
                    {
                        <div class="aw-table-region">
                            <AwSkeleton Variant="table" Rows="5" />
                        </div>
                    }
                    else if (!cmdPageItems.Any())
                    {
                        <div class="aw-table-region">
                            <div class="aw-empty">
                                <i class="bi bi-list-check"></i>
                                <p>Aucune commande pour ces filtres.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-table-region" @key="@UserCurrency.DisplayRevision">
                            <div class="aw-table-wrap">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>N°</th>
                                            <th>Fournisseur</th>
                                            <th>Articles</th>
                                            <th class="aw-table__num">Nb Art.</th>
                                            <th>Réception</th>
                                            <th>Date cmd</th>
                                            <th>Statut</th>
                                            <th>Utilisateur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in cmdPageItems)
                                        {
                                            var (cmdLbl, cmdBadge) = r.Status switch
                                            {
                                                0 => ("Nouvelle", "aw-badge--muted"),
                                                1 => ("En cours", "aw-badge--accent"),
                                                2 => ("Reçue", "aw-badge--brand"),
                                                3 => ("Annulée", "aw-badge--danger"),
                                                _ => ("—", "aw-badge--muted")
                                            };
                                            var pct = r.TotalOrder > 0
                                                ? Math.Min(100, (int)(r.TotalReceived / r.TotalOrder * 100))
                                                : 0;
                                            var meterTone = pct >= 100 ? "brand" : pct >= 50 ? "accent" : "danger";
                                            <tr style="@(r.Status == 3 ? "opacity:0.5;" : null)">
                                                <td><span class="aw-table__title">@r.Id</span></td>
                                                <td>@r.Fournisseur</td>
                                                <td>
                                                    @foreach (var art in r.Articles)
                                                    {
                                                        <div style="font-size:0.85rem; line-height:1.5;">
                                                            <strong>@art.Name</strong>
                                                            <span class="aw-table__meta"> — Cmd: @art.QteOrder.ToString("N0")</span>
                                                            @if (art.QteReceived > 0)
                                                            {
                                                                <span style="color:var(--aw-brand);"> ✓ Reçu: @art.QteReceived.ToString("N0")</span>
                                                            }
                                                        </div>
                                                    }
                                                    @if (!r.Articles.Any())
                                                    {
                                                        <span class="aw-table__meta">Aucun article</span>
                                                    }
                                                </td>
                                                <td class="aw-table__num">@r.NbArticles</td>
                                                <td>
                                                    @if (r.TotalOrder > 0)
                                                    {
                                                        <div class="aw-table-meter" title="@pct % reçu">
                                                            <div class="aw-overview__meter-track">
                                                                <div class="@($"aw-overview__meter-fill aw-overview__meter-fill--{meterTone}")"
                                                                     style="width:@pct%"></div>
                                                            </div>
                                                            <span class="aw-table__num">@pct%</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="aw-table__meta">—</span>
                                                    }
                                                </td>
                                                <td>@(r.DateCommande?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td><span class="aw-badge @cmdBadge">@cmdLbl</span></td>
                                                <td>@r.User</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <AwPager TotalCount="_cmdFiltered.Count"
                                     Page="_cmdPage"
                                     PageSize="_cmdPageSize"
                                     ItemLabel="commande"
                                     PageChanged="SetCmdPage"
                                     PageSizeChanged="SetCmdPageSize" />
                        </div>
