@using MudBlazor
@using AppPlusPlus.Domain.Entities.Approvisionnement
@inject IDbContextFactory<AppPlusPlus.Infrastructure.Persistence.AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject MudBlazor.IDialogService DialogService
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        @if (_item == null)
        {
            <div class="aw-dialog">
                <div class="aw-dialog__body">
                    <AwSkeleton Variant="table" Rows="4" />
                </div>
            </div>
        }
        else
        {
            var item = _item;
            <div class="aw-dialog">
                <header class="aw-dialog__head">
                    <div class="aw-dialog__title-wrap">
                        <i class="bi bi-cash-coin" aria-hidden="true"></i>
                        <h2 class="aw-dialog__title">Versement N° @ExpenseId</h2>
                    </div>
                    @switch (item.Statut)
                    {
                        case "Accepté":
                            <span class="aw-badge aw-badge--brand"><i class="bi bi-check-circle" aria-hidden="true"></i>Accepté</span>
                            break;
                        case "Rejeté":
                            <span class="aw-badge aw-badge--danger"><i class="bi bi-x-circle" aria-hidden="true"></i>Rejeté</span>
                            break;
                        default:
                            <span class="aw-badge aw-badge--accent"><i class="bi bi-hourglass-split" aria-hidden="true"></i>En attente</span>
                            break;
                    }
                </header>
                <div class="aw-dialog__body">
                    @if (item.VersementId.HasValue)
                    {
                        <p class="aw-field__hint" style="margin-bottom:0.75rem;">
                            <i class="bi bi-link-45deg" aria-hidden="true"></i>
                            Provient de la <strong>Clôture N°@item.VersementId</strong>
                        </p>
                    }

                    <div class="aw-dialog__meta">
                        <div>
                            <span class="aw-dialog__meta-label">Description</span>
                            <span class="aw-dialog__meta-value">@(item.Description ?? "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Déposeur</span>
                            <span class="aw-dialog__meta-value">@(item.Depositeur ?? "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Montant</span>
                            <span class="aw-dialog__meta-value">@(item.AmountUSD is > 0 ? UserCurrency.FormatBusiness(item.AmountUSD.Value) : item.AmountCDF is > 0 ? UserCurrency.FormatFromFcStored(item.AmountCDF.Value, _displayTaux) : item.Montant is > 0 ? UserCurrency.FormatFromSnapshot(item.Montant, item.MoneyId, item.Taux, item.MontantApresConversion, item.Montant.Value, item.MoneyId ?? CurrencyDefaults.MoneyIdCdf, _displayTaux) : "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Date</span>
                            <span class="aw-dialog__meta-value">@(item.CreationDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                        </div>
                        <div>
                            <span class="aw-dialog__meta-label">Créé par</span>
                            <span class="aw-dialog__meta-value">@(item.UserLogin ?? "—")</span>
                        </div>
                        <div style="grid-column:1/-1;">
                            <span class="aw-dialog__meta-label">Commentaire</span>
                            <span class="aw-dialog__meta-value">@(item.Comment ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_item != null)
        {
            <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;justify-content:space-between;">
                <button type="button" class="aw-btn aw-btn--danger" @onclick="@OnSupprimer">
                    <i class="bi bi-trash"></i> Supprimer
                </button>
                <div style="display:inline-flex;gap:0.45rem;flex-wrap:wrap;">
                    @if (_item!.Statut != "Accepté")
                    {
                        <button type="button" class="aw-btn aw-btn--primary" @onclick="@OnAccepter">
                            <i class="bi bi-check-circle"></i> Accepter
                        </button>
                    }
                    @if (_item!.Statut != "Rejeté")
                    {
                        <button type="button" class="aw-btn aw-btn--danger" @onclick="@OnRejeter">
                            <i class="bi bi-x-circle"></i> Rejeter
                        </button>
                    }
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="@OnModifier">
                        <i class="bi bi-pencil"></i> Modifier
                    </button>
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="@Cancel">
                        <i class="bi bi-x-lg"></i> Fermer
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;">
                <button type="button" class="aw-btn aw-btn--ghost" @onclick="@Cancel">
                    <i class="bi bi-x-lg"></i> Fermer
                </button>
            </div>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int ExpenseId { get; set; }

    ApproExpense? _item;
    decimal _displayTaux = 1m;

    protected override async Task OnInitializedAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        _displayTaux = await ctx.TauxChanges.AsNoTracking()
            .OrderByDescending(t => t.Id)
            .Select(t => t.TauxValue)
            .FirstOrDefaultAsync();
        if (_displayTaux <= 0) _displayTaux = 1m;
        _item = await ctx.ApproExpenses.AsNoTracking().FirstOrDefaultAsync(e => e.Id == ExpenseId);
    }

    void Cancel() => MudDialog.Close();

    async Task OnAccepter()
    {
        if (_item == null) return;
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var entity = await ctx.ApproExpenses.FirstOrDefaultAsync(e => e.Id == ExpenseId);
        if (entity == null) return;
        entity.Statut = "Accepté";
        await ctx.SaveChangesAsync();
        Snackbar.Add("Versement accepté", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    async Task OnRejeter()
    {
        if (_item == null) return;
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var entity = await ctx.ApproExpenses.FirstOrDefaultAsync(e => e.Id == ExpenseId);
        if (entity == null) return;
        entity.Statut = "Rejeté";
        await ctx.SaveChangesAsync();
        Snackbar.Add("Versement rejeté", Severity.Warning);
        MudDialog.Close(DialogResult.Ok(true));
    }

    async Task OnSupprimer()
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmation",
            $"Supprimer le versement N° {ExpenseId} ?",
            yesText: "Supprimer",
            cancelText: "Annuler");
        if (confirm != true) return;
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var entity = await ctx.ApproExpenses.FirstOrDefaultAsync(e => e.Id == ExpenseId);
        if (entity == null) return;
        ctx.ApproExpenses.Remove(entity);
        await ctx.SaveChangesAsync();
        Snackbar.Add("Versement supprimé", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    void OnModifier()
    {
        MudDialog.Close();
        Navigation.NavigateTo($"/admin/versement/modifier/{ExpenseId}");
    }
}
