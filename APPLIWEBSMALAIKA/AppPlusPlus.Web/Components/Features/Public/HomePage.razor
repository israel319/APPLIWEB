                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="mk-hero__slide mk-hero__slide--kids-bg" style="--mk-kids-bg-image: url('/images/home/carousel/faces/slide-3.png'); --mk-kids-bg-position: 72% 42%;">
                        <div class="mk-wrap mk-hero__inner">
                            <div class="mk-hero__copy">
                                <p class="mk-hero__lane">Filles</p>
