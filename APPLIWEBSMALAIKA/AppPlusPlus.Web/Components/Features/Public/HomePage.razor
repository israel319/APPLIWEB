    <section class="mk-section mk-how" id="commande">
        <div class="mk-wrap">
            <div class="mk-sec-head"><div><h2>Commander en 4 &eacute;tapes</h2></div></div>
            <ol class="mk-steps">
                <li><h3>Parcourez</h3><p>Choisissez filles, gar&ccedil;ons ou toutes les cat&eacute;gories.</p></li>
                <li><h3>Ajoutez au panier</h3><p>S&eacute;lectionnez tailles et quantit&eacute;s.</p></li>
                <li><h3>Connectez-vous</h3><p>Client : votre num&eacute;ro de t&eacute;l&eacute;phone.</p></li>
                <li><h3>On livre</h3><p>Confirmation et livraison &agrave; @PublicBrand.ContactAddress.</p></li>
            </ol>
        </div>
    </section>

    <div class="mk-catalog-intro" id="categories">
        <div class="mk-wrap">
            <span class="mk-page-hero__eyebrow">La boutique @PublicBrand.ProductName</span>
            <h2>Le catalogue</h2>
            <p>Toutes les cat&eacute;gories et articles commandables - @PublicBrand.Tagline</p>
        </div>
    </div>

    <section class="mk-section mk-catalog-section ali-home__catalog" aria-label="Le catalogue" id="catalogue" style="padding-top:0">
        <div class="mk-wrap">
            <LandingCatalogSection StayOnHome="true" PreviewMode="true" MaxCategoryCards="8" />
        </div>
    </section>

    <footer class="mk-footer" id="contact">
        <div class="mk-wrap">
        <div class="mk-footer__panel">
        <div class="mk-foot-grid">
            <div class="mk-foot-brand">
                <img class="mk-foot-logo" src="images/brand/malaika-kids-logo.png" alt="@PublicBrand.ProductName" width="260" height="80" decoding="async" />
                <p>Mode et habillement enfant. Des v&ecirc;tements, des chaussures et des accessoires pour les 0 &agrave; 14 ans.</p>
            </div>
            <div class="mk-foot-shop">
                <h4>Boutique</h4>
                <ul>
                    <li><button type="button" class="mk-footer-link" @onclick="GoCatalogGirlsAsync">Filles</button></li>
                    <li><button type="button" class="mk-footer-link" @onclick="GoCatalogBoysAsync">Gar&ccedil;ons</button></li>
                    <li><button type="button" class="mk-footer-link" @onclick="GoCatalogGridAsync">Catalogue</button></li>
                </ul>
            </div>
            <div class="mk-foot-contact">
                <h4>Contact</h4>
                <ul class="mk-foot-contact-list">
                    <li>
                        <a class="mk-foot-contact-item" href="tel:@PublicBrand.ContactPhoneTel">
                            <i class="bi bi-telephone mk-foot-contact-ico" aria-hidden="true"></i>
                            <span>@PublicBrand.ContactPhone</span>
                        </a>
                    </li>
                    <li>
                        <a class="mk-foot-contact-item" href="mailto:@PublicBrand.ContactEmail">
                            <i class="bi bi-envelope mk-foot-contact-ico" aria-hidden="true"></i>
                            <span>@PublicBrand.ContactEmail</span>
                        </a>
                    </li>
                    <li>
                        <span class="mk-foot-contact-item">
                            <i class="bi bi-geo-alt mk-foot-contact-ico" aria-hidden="true"></i>
                            <span>@PublicBrand.ContactAddress</span>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="mk-foot-bottom">
            <span>&copy; @DateTime.Today.Year @PublicBrand.ProductName</span>
            <span>@PublicBrand.Tagline</span>
        </div>
        </div>
        </div>
    </footer>
</div>

@code {
    List<SidebarCategory> _allOrderableCategories = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var bootstrap = await CatalogueService.GetCatalogBootstrapAsync();
            _allOrderableCategories = bootstrap.Categories
                .Where(c => c.VisibleCatalog && bootstrap.OrderableCategoryIds.Contains(c.IdCategory))
                .OrderBy(c => c.DescriptionCategory)
                .Select(c => new SidebarCategory(
                    c.IdCategory,
                    FormatLabel(c.DescriptionCategory, c.IdCategory),
                    PickIcon(c.DescriptionCategory),
                    PickCssClass(c.DescriptionCategory)))
                .ToList();
        }
        catch
        {
            _allOrderableCategories = new();
        }
    }

    Task GoCatalogGridAsync() => GoFullCatalogAsync(null);

    Task GoFullCatalogAsync(string? search)
    {
        var url = string.IsNullOrWhiteSpace(search)
            ? "/catalogue"
            : $"/catalogue?q={Uri.EscapeDataString(search.Trim())}";
        Navigation.NavigateTo(url);
        return Task.CompletedTask;
    }

    Task GoCatalogGirlsAsync() => GoCatalogUniverseAsync(isGirls: true);

    Task GoCatalogBoysAsync() => GoCatalogUniverseAsync(isGirls: false);

    async Task GoCatalogUniverseAsync(bool isGirls)
    {
        if (TryPickUniverseCategory(isGirls, out var id))
        {
            await GoCatalogAsync(reset: false, categoryId: id, search: null);
            return;
        }

        await GoCatalogAsync(reset: false, categoryId: null, search: isGirls ? "fille" : "gar\u00e7on");
    }

    async Task GoCatalogAsync(bool reset, int? categoryId, string? search)
    {
        if (reset)
            HomeCatalog.RequestBrowseAll();
        else if (categoryId is > 0)
            HomeCatalog.RequestCategoryFilter(categoryId.Value, search);
        else if (!string.IsNullOrWhiteSpace(search))
            HomeCatalog.RequestSearch(search);
        else
            HomeCatalog.RequestBrowseAll();

        var url = BuildCatalogUrl(categoryId, search, reset);
        Navigation.NavigateTo(url, replace: true);
        await ScrollToCatalogAsync();
    }

    static string BuildCatalogUrl(int? categoryId, string? search, bool reset)
    {
        if (reset || (categoryId is null or <= 0 && string.IsNullOrWhiteSpace(search)))
            return "/#catalogue";

        if (categoryId is > 0)
        {
            var url = $"/?c={categoryId.Value}";
            if (!string.IsNullOrWhiteSpace(search))
                url += $"&q={Uri.EscapeDataString(search.Trim())}";
            return $"{url}#catalogue";
        }

        return $"/?q={Uri.EscapeDataString(search!.Trim())}#catalogue";
    }

    async Task ScrollToCatalogAsync()
    {
        try
        {
            await Task.Yield();
            var nav = await JS.InvokeAsync<IJSObjectReference>("import", "./js/public-nav.js");
            await nav.InvokeVoidAsync("scrollToId", "catalogue");
        }
        catch
        {
            // Défilement non bloquant.
        }
    }

    bool TryPickUniverseCategory(bool isGirls, out int categoryId)
    {
        var match = _allOrderableCategories.FirstOrDefault(c =>
            isGirls
                ? c.CssClass == "ali-cat-panel__item--girls"
                : c.CssClass == "ali-cat-panel__item--boys");

        if (match is not null)
        {
            categoryId = match.Id;
            return true;
        }

        categoryId = 0;
        return false;
    }

    [Inject] NavigationManager Navigation { get; set; } = default!;

    static string FormatLabel(string? name, int id) =>
        string.IsNullOrWhiteSpace(name) ? $"Categorie {id}" : name.Trim();

    static string PickIcon(string? name)
    {
        var n = name?.ToLowerInvariant() ?? "";
        if (n.Contains("fil") || n.Contains("girl") || n.Contains("robe")) return "bi-balloon-heart";
        if (n.Contains("gar") || n.Contains("boy") || n.Contains("homme")) return "bi-lightning";
        if (n.Contains("beb") || n.Contains("bebe")) return "bi-emoji-smile";
        return "bi-tag";
    }

    static string PickCssClass(string? name)
    {
        var n = name?.ToLowerInvariant() ?? "";
        if (n.Contains("fille") || n.Contains("girl") || n.Contains("robe") || n.Contains("jupe") || n.Contains("filles"))
            return "ali-cat-panel__item--girls";
        if (n.Contains("garcon") || n.Contains("boy") || n.Contains("garcons"))
            return "ali-cat-panel__item--boys";
        return "";
    }

    sealed record SidebarCategory(int Id, string Label, string Icon, string CssClass);
}
