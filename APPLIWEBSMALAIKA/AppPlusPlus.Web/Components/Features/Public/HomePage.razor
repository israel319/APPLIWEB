                                </div>
                                <div class="mk-hero__assure">
                                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Paiement s&eacute;curis&eacute;</span>
                                    <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> &Eacute;change facile</span>
                                </div>
                            </div>
                            <div class="mk-hero__art" aria-hidden="true">
                                <div class="mk-hero__sun"></div>
                                <img class="mk-hero__mascot mk-hero__mascot--photo"
                                     src="images/home/carousel/clothes/slide-flatlay.png"
                                     alt=""
                                     width="320"
                                     height="320"
                                     loading="lazy"
                                     decoding="async" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev mk-hero__control" type="button" data-bs-target="#mkHeroCarousel" data-bs-slide="prev">
                <span class="mk-hero__control-icon" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                <span class="visually-hidden">Diapositive pr&eacute;c&eacute;dente</span>
            </button>
            <button class="carousel-control-next mk-hero__control" type="button" data-bs-target="#mkHeroCarousel" data-bs-slide="next">
                <span class="mk-hero__control-icon" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
