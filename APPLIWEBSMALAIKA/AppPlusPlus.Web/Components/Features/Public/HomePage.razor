@page "/"
@attribute [AllowAnonymous]
@layout PublicLayout
@rendermode PublicRenderMode.Instance
@using AppPlusPlus.Application.Services.Catalogue
@using AppPlusPlus.Web.Services
@inject ICatalogueService CatalogueService
@inject HomeCatalogCoordinator HomeCatalog
@inject IJSRuntime JS

<PageTitle>@PublicBrand.ProductName - @PublicBrand.Tagline</PageTitle>

<div class="mk-home">
