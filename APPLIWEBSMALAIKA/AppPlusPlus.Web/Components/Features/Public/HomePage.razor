                                     alt=""
                                     width="320"
                                     height="320"
                                     loading="lazy"
                                     decoding="async" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="mk-hero__slide mk-hero__slide--kids-bg" style="--mk-kids-bg-image: url('/images/home/carousel/faces/slide-1.png'); --mk-kids-bg-position: 68% 38%;">
                        <div class="mk-wrap mk-hero__inner">
                            <div class="mk-hero__copy">
                                <p class="mk-hero__lane">Gar&ccedil;ons</p>
                                <h1>Confort et style pour les gar&ccedil;ons</h1>
                                <p class="mk-hero__lead">Sweats, jeans et tenues du quotidien pour suivre le rythme des aventures.</p>
                                <div class="mk-hero__cta">
