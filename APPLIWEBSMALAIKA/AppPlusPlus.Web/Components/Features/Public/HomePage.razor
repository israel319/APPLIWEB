                                    <a class="mk-btn mk-btn--ghost" href="#univers">Tous les univers</a>
                                </div>
                                <div class="mk-hero__assure">
                                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Paiement s&eacute;curis&eacute;</span>
                                    <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> &Eacute;change facile</span>
                                </div>
                            </div>
                            <div class="mk-hero__art" aria-hidden="true">
                                <div class="mk-hero__sun"></div>
                                <img class="mk-hero__mascot mk-hero__mascot--photo"
