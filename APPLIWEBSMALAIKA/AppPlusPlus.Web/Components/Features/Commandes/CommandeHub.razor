        ApplyVenteFilter();
        _venteLoading = false;
        _venteLoadedOnce = true;
    }

    static decimal ResolveCommandeDisplayTotalFc(Commande cmd) =>
        cmd.Details.Any(d => d.Article != null)
            ? CommandePricing.ResolveCommandeTotalFc(cmd)
            : CurrencyDefaults.IsCdfMoneyId(cmd.MoneyId ?? CurrencyDefaults.MoneyIdUsd)
                ? cmd.MontantTotal
                : cmd.MontantApresConversion ?? cmd.MontantTotal;

    void SetVenteStatusFilter(int? status)
    {
        _venteStatusFilter = status;
        ApplyVenteFilter();
    }

    Task OnVenteStatusFilterChanged(string? value)
    {
        SetVenteStatusFilter(int.TryParse(value, out var st) ? st : null);
        return Task.CompletedTask;
    }

    List<AwSearchSelect.Option> GetVenteStatusFilterOptions(int nouvelles, int enCours, int livrees) =>
    [
        new("", $"Statut : tous ({_venteData.Count})"),
        new("0", $"Nouvelles ({nouvelles})"),
        new("1", $"En cours ({enCours})"),
        new("2", $"Livrées+ ({livrees})")
    ];

    void ApplyVenteFilter()
    {
        _venteFiltered = _venteData.Where(c =>
        {
            if (_venteStatusFilter.HasValue)
            {
                var st = c.Status ?? 0;
                if (_venteStatusFilter == 2)
                {
                    if (st < 2) return false;
                }
                else if (st != _venteStatusFilter.Value)
                    return false;
            }
            if (string.IsNullOrWhiteSpace(_venteSearch))
                return true;
            var s = _venteSearch.Trim();
            return c.CommandeId.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
                || (c.CommandeDescription?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Customer?.CustomerName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Customer?.Contact?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
        }).OrderByDescending(c => (c.Status ?? 0) == 0)
          .ThenByDescending(c => c.CreationDate ?? DateTime.MinValue)
          .ToList();
        _ventePage = 1;
    }

    void OnVenteSearchChanged(string value)
    {
        _venteSearch = value ?? "";
        ApplyVenteFilter();
    }

