    void ApplyCmdFilter()
    {
        _cmdFiltered = _cmdData.Where(r =>
        {
            if (_cmdStatusFilter.HasValue && (r.Cmd.Status ?? 0) != _cmdStatusFilter.Value)
                return false;
            if (string.IsNullOrWhiteSpace(_cmdSearch))
                return true;
            var s = _cmdSearch.Trim();
            return r.Cmd.Id.ToString().Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.Cmd.Description?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.Cmd.Supplier?.SupplierName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
        }).ToList();
        _cmdPage = 1;
    }

