    void SetClientTypeFilter(string type)
    {
        _clientTypeFilter = type;
        ApplyClientFilter();
    }

    Task OnClientTypeFilterChanged(string? value)
    {
        SetClientTypeFilter(string.IsNullOrWhiteSpace(value) ? "all" : value);
        return Task.CompletedTask;
    }

    List<AwSearchSelect.Option> GetClientTypeFilterOptions(int permanents, int passagers) =>
    [
        new("all", $"Type : tous ({_clientData.Count})"),
        new("permanent", $"Permanents ({permanents})"),
        new("passager", $"Passagers ({passagers})")
    ];

    void ApplyClientFilter()
    {
        _clientFiltered = _clientData.Where(c =>
        {
            if (_clientTypeFilter == "permanent" && c.IsPermanent != true) return false;
            if (_clientTypeFilter == "passager" && c.IsPermanent == true) return false;
            if (string.IsNullOrWhiteSpace(_clientSearch))
                return true;
            var s = _clientSearch.Trim();
            return (c.CustomerName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Contact?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Email?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Adress?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false);
        }).ToList();
        _clientPage = 1;
    }

