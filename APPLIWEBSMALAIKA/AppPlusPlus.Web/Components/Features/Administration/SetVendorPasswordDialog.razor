@using MudBlazor
@inject IVendorSecurityService VendorSecurity
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="lov-form-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-key text-primary"></i>
                <h5 class="mb-0">@(_isFirstSetup ? "Définir le mot de passe vendeur" : "Changer le mot de passe vendeur")</h5>
            </div>
        </div>

        <div class="lov-form-body">
            @if (_isFirstSetup)
            {
                <div class="alert alert-info py-2 mb-3" style="font-size:.85rem;">
                    <i class="bi bi-info-circle me-1"></i>
                    Ce mot de passe est réservé au vendeur/intégrateur. Il protège l'accès à la gestion des licences modules.
                    <strong>Gardez-le confidentiel et ne le communiquez pas au client.</strong>
                </div>
            }
            else
            {
                <div class="lov-field">
                    <label class="form-label fw-semibold">Mot de passe actuel</label>
                    <div class="input-group">
                        <input type="@(_showCurrent ? "text" : "password")"
                               class="form-control @(_currentError ? "is-invalid" : "")"
                               @bind="_currentPassword"
                               placeholder="Mot de passe actuel" />
                        <button class="btn btn-outline-secondary" type="button"
                                @onclick="@(() => _showCurrent = !_showCurrent)">
                            <i class="bi @(_showCurrent ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                        @if (_currentError)
                        {
                            <div class="invalid-feedback">Mot de passe actuel incorrect.</div>
                        }
                    </div>
                </div>
            }

            <div class="lov-field">
                <label class="form-label fw-semibold">Nouveau mot de passe</label>
                <div class="input-group">
                    <input type="@(_showNew ? "text" : "password")"
                           class="form-control @(_newError ? "is-invalid" : "")"
                           @bind="_newPassword"
                           placeholder="Minimum 8 caractères" />
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="@(() => _showNew = !_showNew)">
                        <i class="bi @(_showNew ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                    @if (_newError)
                    {
                        <div class="invalid-feedback">@_newErrorMsg</div>
                    }
                </div>
                <div class="mt-1">
                    @{
                        var strength = GetPasswordStrength(_newPassword);
                        var (barClass, label) = strength switch {
                            0 => ("", ""),
                            1 => ("bg-danger", "Faible"),
                            2 => ("bg-warning", "Moyen"),
                            3 => ("bg-info", "Bon"),
                            _ => ("bg-success", "Excellent")
                        };
                    }
                    @if (_newPassword.Length > 0)
                    {
                        <div class="progress" style="height:4px;">
                            <div class="progress-bar @barClass" style="width:@(strength * 25)%;transition:width .3s;"></div>
                        </div>
                        <small class="text-muted">Force : <span class="fw-semibold">@label</span></small>
                    }
                </div>
            </div>

            <div class="lov-field">
                <label class="form-label fw-semibold">Confirmer le nouveau mot de passe</label>
                <div class="input-group">
                    <input type="@(_showConfirm ? "text" : "password")"
                           class="form-control @(_confirmError ? "is-invalid" : "")"
                           @bind="_confirmPassword"
                           placeholder="Répéter le nouveau mot de passe" />
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="@(() => _showConfirm = !_showConfirm)">
                        <i class="bi @(_showConfirm ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                    @if (_confirmError)
                    {
                        <div class="invalid-feedback">Les mots de passe ne correspondent pas.</div>
                    }
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="hub-dialog-actions px-1 pb-1">
            <div></div>
            <div class="hub-dialog-actions-right">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel">
                    <i class="bi bi-x-lg me-1"></i>Annuler
                </button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="Submit" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-1"></i>
                    }
                    @(_isFirstSetup ? "Définir" : "Changer")
                </button>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public bool IsFirstSetup { get; set; }

    bool _isFirstSetup;

    string _currentPassword = string.Empty;
    string _newPassword     = string.Empty;
    string _confirmPassword = string.Empty;

    bool _showCurrent; bool _showNew; bool _showConfirm;
    bool _currentError; bool _newError; bool _confirmError;
    string _newErrorMsg = string.Empty;
    bool _loading;

    protected override void OnInitialized() => _isFirstSetup = IsFirstSetup;

    async Task Submit()
    {
        _currentError = _newError = _confirmError = false;
        _newErrorMsg = string.Empty;

        // Validation
        if (_newPassword.Length < 8)
        {
            _newError = true;
            _newErrorMsg = "Le mot de passe doit contenir au moins 8 caractères.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _confirmError = true;
            return;
        }

        _loading = true;
        try
        {
            if (_isFirstSetup)
            {
                await VendorSecurity.SetPasswordAsync(_newPassword);
                Snackbar.Add("Mot de passe vendeur défini avec succès.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var ok = await VendorSecurity.ChangePasswordAsync(_currentPassword, _newPassword);
                if (!ok)
                {
                    _currentError = true;
                }
                else
                {
                    Snackbar.Add("Mot de passe vendeur modifié avec succès.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    void Cancel() => MudDialog.Cancel();

    static int GetPasswordStrength(string pwd)
    {
        if (string.IsNullOrEmpty(pwd)) return 0;
        int score = 0;
        if (pwd.Length >= 8) score++;
        if (pwd.Length >= 12) score++;
        if (pwd.Any(char.IsUpper) && pwd.Any(char.IsLower)) score++;
        if (pwd.Any(char.IsDigit)) score++;
        if (pwd.Any(c => !char.IsLetterOrDigit(c))) score++;
        return Math.Min(score, 4);
    }
}
