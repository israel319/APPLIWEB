@using AppPlusPlus.Application.DTOs.Stock
@inject IUserAdminService UserAdminService
@inject IStockService StockService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="aw-dialog">
                <div class="aw-dialog__body">
                    <AwSkeleton Variant="table" Rows="5" />
                </div>
            </div>
        }
        else
        {
            <div class="aw-dialog">
                <header class="aw-dialog__head">
                    <div class="aw-dialog__title-wrap">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <h2 class="aw-dialog__title">@(Localisation?.DescriptionLocalisation ?? "Localisation")</h2>
                    </div>
                </header>
                <div class="aw-dialog__body">
                    <div class="aw-dialog__section" style="margin-top:0;">Utilisateurs assignés (@_users.Count)</div>
                    @if (_users.Any())
                    {
                        <div class="aw-table-region" style="margin-bottom:0.85rem;">
                            <div class="aw-table-wrap" style="max-height:200px;">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>Login</th>
                                            <th>Nom</th>
                                            <th>Email</th>
                                            <th>Rôle</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in _users)
                                        {
                                            <tr style="cursor:default;">
                                                <td><span class="aw-table__title">@user.Login</span></td>
                                                <td>@user.Name</td>
                                                <td>@user.Email</td>
                                                <td>@(user.Role?.DescriptionRole ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-empty aw-empty--compact" style="margin-bottom:0.85rem;">
                            <i class="bi bi-people"></i>
                            <p>Aucun utilisateur assigné</p>
                        </div>
                    }

                    <div class="aw-dialog__section">Articles (@_articles.Count)</div>
                    @if (_articles.Any())
                    {
                        <div class="aw-table-region">
                            <div class="aw-table-wrap" style="max-height:300px;">
                                <table class="aw-table">
                                    <thead>
                                        <tr>
                                            <th>Code</th>
                                            <th>Description</th>
                                            <th class="aw-table__num">Quantité</th>
                                            <th class="aw-table__num">Min</th>
                                            <th class="aw-table__num">Max</th>
                                            <th>État</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var art in _articles)
                                        {
                                            var qte = art.Qte;
                                            var seuil = art.Seuil;
                                            var qteMax = art.QteMax;
                                            var etat = qte <= 0 ? "Rupture" : qte <= seuil ? "Stock bas" : "OK";
                                            var badgeClass = qte <= 0 ? "aw-badge--danger" : qte <= seuil ? "aw-badge--accent" : "aw-badge--brand";
                                            <tr style="cursor:default;">
                                                <td><span class="aw-table__title">@art.IdArticle</span></td>
                                                <td>@art.Description</td>
                                                <td class="aw-table__num">@qte.ToString("N2")</td>
                                                <td class="aw-table__num">@seuil.ToString("N0")</td>
                                                <td class="aw-table__num">@(qteMax > 0 ? qteMax.ToString() : "—")</td>
                                                <td><span class="aw-badge @badgeClass">@etat</span></td>
                                                <td>
                                                    <button type="button" class="aw-btn aw-btn--ghost aw-btn--icon aw-btn--sm"
                                                            title="Approvisionner"
                                                            @onclick="@(() => OnAppro(art))">
                                                        <i class="bi bi-cart-plus"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="aw-empty aw-empty--compact">
                            <i class="bi bi-box-seam"></i>
                            <p>Aucun article dans cette localisation</p>
                        </div>
                    }
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <div class="aw-dialog__footer" style="width:100%;border:none;padding:0.35rem 0.25rem 0.15rem;">
            <button type="button" class="aw-btn aw-btn--ghost" @onclick="Close">
                <i class="bi bi-x-lg"></i> Fermer
            </button>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Localisation? Localisation { get; set; }

    private bool _loading = true;
    private List<User> _users = new();
    private List<StockArticleDto> _articles = new();

    protected override async Task OnInitializedAsync()
    {
        if (Localisation == null) return;

        _users = await UserAdminService.GetUsersByLocalisationAsync(Localisation.IdLocalisation);
        _articles = await StockService.GetStockArticleViewAsync(Localisation.IdLocalisation);

        _loading = false;
    }

    void Close() => MudDialog.Close();

    void OnAppro(StockArticleDto art)
    {
        MudDialog.Close();
        Navigation.NavigateTo($"/stock/appro/nouveau?PreselectedArticleId={Uri.EscapeDataString(art.IdArticle)}&PreselectedLocalisationId={Localisation!.IdLocalisation}");
    }
}
