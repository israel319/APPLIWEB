@using MudBlazor
@inject IVendorSecurityService VendorSecurity
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="lov-form-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock text-warning"></i>
                <h5 class="mb-0">Accès restreint</h5>
            </div>
        </div>

        <div class="lov-form-body">
            <p class="text-muted small mb-3">
                Cette section est protégée. Entrez le mot de passe vendeur pour accéder à la gestion des licences modules.
            </p>

            <div class="lov-field">
                <label class="form-label fw-semibold">Mot de passe vendeur</label>
                <div class="input-group">
                    <input type="@(_showPassword ? "text" : "password")"
                           class="form-control @(_error ? "is-invalid" : "")"
                           @bind="_password"
                           @bind:event="oninput"
                           @onkeydown="OnKeyDown"
                           placeholder="••••••••••••"
                           autofocus />
                    <button class="btn btn-outline-secondary" type="button"
                            @onclick="@(() => _showPassword = !_showPassword)"
                            title="@(_showPassword ? "Masquer" : "Afficher")">
                        <i class="bi @(_showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                    @if (_error)
                    {
                        <div class="invalid-feedback">Mot de passe incorrect.</div>
                    }
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="hub-dialog-actions px-1 pb-1">
            <div></div>
            <div class="hub-dialog-actions-right">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel">
                    <i class="bi bi-x-lg me-1"></i>Annuler
                </button>
                <button type="button" class="btn btn-primary btn-sm" @onclick="Submit" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <i class="bi bi-unlock me-1"></i>
                    }
                    Accéder
                </button>
            </div>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    string _password = string.Empty;
    bool _showPassword;
    bool _error;
    bool _loading;

    async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_password)) return;
        _error = false;
        _loading = true;

        var ok = await VendorSecurity.VerifyPasswordAsync(_password);
        _loading = false;

        if (ok)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            _error = true;
            _password = string.Empty;
        }
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    void Cancel() => MudDialog.Cancel();
}
