    static List<AwSearchSelect.Option> ToSelectOptions(IEnumerable<string> values, string allLabel)
    {
        var list = new List<AwSearchSelect.Option> { new("", allLabel) };
        foreach (var v in values)
            list.Add(new(v, v));
        return list;
    }

