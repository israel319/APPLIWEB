    async Task LoadPendingCloturesAsync()
    {
        var all = await ClotureService.GetCloturesByLocalisationsAsync(new List<int>());
        var from = _versDateFrom.HasValue ? DateOnly.FromDateTime(_versDateFrom.Value) : (DateOnly?)null;
        var to = _versDateTo.HasValue ? DateOnly.FromDateTime(_versDateTo.Value) : (DateOnly?)null;

        _pendingClotures = all
            .Where(v => v.StatutCloture == 0)
            .Where(v => !from.HasValue || v.DateCloture >= from.Value)
            .Where(v => !to.HasValue || v.DateCloture <= to.Value)
            .OrderByDescending(v => v.DateCloture)
            .ThenByDescending(v => v.HeureCloture)
            .ToList();
    }

    bool CanModerateAdminCloture(Versement v) =>
        v.StatutCloture == 0
        && !string.Equals(v.UserLogin, _adminLogin, StringComparison.OrdinalIgnoreCase);

    async Task OnApprouverClotureAdmin(Versement v)
    {
        if (!CanModerateAdminCloture(v))
        {
            Snackbar.Add("Vous ne pouvez pas approuver votre propre clôture.", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Approuver la clôture",
            $"Approuver la clôture du {v.DateCloture:dd/MM/yyyy} par {v.UserLogin} ? Le vendeur pourra reprendre ses ventes.",
            yesText: "Approuver",
            cancelText: "Annuler");
        if (confirm != true) return;

        var ok = await ClotureService.UpdateClotureStatutAsync(v.Id, 1, _adminLogin);
        if (!ok)
        {
            Snackbar.Add("Impossible de mettre à jour la clôture.", Severity.Error);
            return;
        }

        await ClotureService.EnsureClotureExpenseAsync(v.Id);
        Snackbar.Add("Clôture approuvée. Versement caisse créé en attente.", Severity.Success);
        await LoadVersements();
    }

    async Task OnRejeterClotureAdmin(Versement v)
    {
        if (!CanModerateAdminCloture(v))
        {
            Snackbar.Add("Vous ne pouvez pas rejeter votre propre clôture.", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Rejeter la clôture",
            (MarkupString)$"Rejeter la clôture du <b>{v.DateCloture:dd/MM/yyyy}</b> par <b>{v.UserLogin}</b> ?<br/><small>Le vendeur reprendra immédiatement ses transactions.</small>",
            yesText: "Rejeter",
            cancelText: "Annuler");
        if (confirm != true) return;

        var ok = await ClotureService.UpdateClotureStatutAsync(v.Id, 2, _adminLogin, "Rejetée par l'administrateur");
        if (!ok)
        {
            Snackbar.Add("Impossible de mettre à jour la clôture.", Severity.Error);
            return;
