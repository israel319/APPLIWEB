    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAdministrator = AppFunctions.Normalize(user.FindFirst(ClaimTypes.Role)?.Value) == "administrateur";
        var login = user.FindFirst("login")?.Value
            ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var permissions = await PermissionResolver.GetPermissionsAsync(login);
        _canAccessAdmin = _isAdministrator && !permissions.HasHierarchicalGrants
            || permissions.CanAccessTab("administration")
            || (!permissions.HasHierarchicalGrants && permissions.CanRead(AppFunctions.Administration));
        _adminLogin = user.Identity?.Name ?? user.FindFirst(ClaimTypes.Name)?.Value ?? "";
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var savedTab = await JS.InvokeAsync<int>("tabNavigation.getTab", "admin", 0);
            if (savedTab != _tab)
                _tab = savedTab;
        }
        catch { }

        await LoadAdminTabAsync(_tab);
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadAdminTabAsync(int tab)
    {
        if (tab < 0 || tab >= _adminTabLoaded.Length || _adminTabLoaded[tab])
            return;

        switch (tab)
        {
            case 0:
                await LoadUsers();
                await LoadRolePermissions(false);
                await LoadFonctions();
                await LoadActivities();
                await InitializeUserAccessPanel();
                await InitializeUserActivitiesPanel();
                break;
            case 1:
                await LoadSuppliers();
                break;
            case 2:
                await LoadTaux();
                break;
            case 3:
                await LoadPeriodes();
                break;
            case 4:
                await LoadVersements();
                break;
            case 5:
                await LoadAdminFactures();
                break;
            case 6:
                await LoadLivraisonCommandes();
                break;
            case 7:
                await LoadLocalisations();
                break;
            case 8:
                await LoadModuleLicenses();
                break;
        }

        _adminTabLoaded[tab] = true;
    }

    async Task OnTabChange(int tabIndex)
    {
        _tab = tabIndex;
        try
        {
            await JS.InvokeVoidAsync("tabNavigation.saveTab", "admin", tabIndex);
        }
        catch { }

        await LoadAdminTabAsync(tabIndex);
        await InvokeAsync(StateHasChanged);
    }

