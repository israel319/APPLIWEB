    void ApplyVersementFilter()
    {
        _versPage = 1;
        _versementFiltered = _versementData.Where(e =>
        {
            var statut = e.VersementId.HasValue ? "Clôture" : "Manuel";
            if (!HubFilterHelper.MatchesSearch(_versSearch, e.Description, e.Depositeur, e.Comment, e.UserLogin, statut))
                return false;
            if (!HubFilterHelper.MatchesExact(_versStatutFilter, statut)) return false;
            return true;
        }).ToList();
