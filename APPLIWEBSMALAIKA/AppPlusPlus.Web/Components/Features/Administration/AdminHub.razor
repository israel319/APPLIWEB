    void ApplyUserFilter()
    {
        _userPage = 1;
        _userFiltered = _userData.Where(u =>
        {
            if (!HubFilterHelper.MatchesSearch(_userSearch, u.Login, u.Name, u.Email, u.Role?.DescriptionRole))
                return false;
            if (!HubFilterHelper.MatchesFilter(_userRoleFilter, u.Role?.DescriptionRole)) return false;
            if (_userStatusFilter == "Actif" && u.Activated != true) return false;
            if (_userStatusFilter == "Inactif" && u.Activated == true) return false;
            return true;
        }).ToList();
    }

    void ApplySupplierFilter()
    {
        _supplierPage = 1;
        _supplierFiltered = _supplierData.Where(s =>
            HubFilterHelper.MatchesSearch(_supplierSearch, s.SupplierName, s.SupplierNumber, s.Contact, s.Email, s.Adresse))
            .ToList();
    }

    void ApplyTauxFilter()
    {
        _tauxPage = 1;
        _tauxFiltered = _tauxData.Where(t =>
        {
            if (!HubFilterHelper.MatchesSearch(_tauxSearch, t.UserLogin, t.Comment, t.TauxValue.ToString()))
                return false;
            if (!HubFilterHelper.MatchesFilter(_tauxUserFilter, t.UserLogin)) return false;
            return true;
        }).ToList();
    }

    void ApplyPeriodeFilter()
    {
        _periodePage = 1;
        _periodeAuditsFiltered = _periodeAudits.Where(a =>
        {
            if (!HubFilterHelper.MatchesSearch(_periodeSearch,
                a.Periode.Comment, a.Periode.UserLogin, a.FactCount.ToString()))
                return false;
            if (!HubFilterHelper.MatchesFilter(_periodeUserFilter, a.Periode.UserLogin)) return false;
            return true;
        }).ToList();
