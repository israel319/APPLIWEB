    async Task OnDeleteUser(User item)
    {
        var confirm = await DialogService.ShowMessageBox(
            "Confirmation",
            $"Supprimer l'utilisateur '{item.Login}' ? Cette action est irréversible.",
            yesText: "Supprimer",
            cancelText: "Annuler");
        if (confirm == true)
        {
            try
            {
                await UserAdminService.DeleteUserAsync(item.Login);
                Snackbar.Add($"Utilisateur '{item.Login}' supprimé.", Severity.Success);
                await LoadUsers();
