    async Task LoadPeriodes()
    {
        _periodeLoading = true;
        await using var ctx = await DbFactory.CreateDbContextAsync();

        _periodeData = await ctx.Periodes.OrderByDescending(p => p.FromDate).ToListAsync();

        // Charger les données liées pour l'audit en une seule requête par type
        var allFacts   = await ctx.Facts.Select(f => new { f.Date, Total = f.TotalApresReduction ?? f.Total ?? 0 }).ToListAsync();
        var allPays    = await ctx.Payments.Select(p => new { p.Date, p.Montant }).ToListAsync();
        var allVers    = await ctx.Versements.Select(v => new { v.DateCloture, v.Montant }).ToListAsync();

        _periodeAudits = _periodeData.Select(p =>
        {
            var from = p.FromDate.HasValue ? DateOnly.FromDateTime(p.FromDate.Value) : DateOnly.MinValue;
            var to   = p.ToDate.HasValue   ? DateOnly.FromDateTime(p.ToDate.Value)   : DateOnly.MaxValue;

            var facts = allFacts.Where(f => f.Date >= from && f.Date <= to).ToList();
            var pays  = allPays.Where(x => x.Date >= from && x.Date <= to).ToList();
            var vers  = allVers.Where(v => v.DateCloture >= from && v.DateCloture <= to).ToList();

            int duree = (p.FromDate.HasValue && p.ToDate.HasValue)
                ? (int)(p.ToDate.Value - p.FromDate.Value).TotalDays
                : 0;

            return new PeriodeAudit(
                p,
                facts.Count, facts.Sum(f => f.Total),
                pays.Count,  pays.Sum(x => x.Montant),
                vers.Count,  vers.Sum(v => v.Montant),
                duree);
        }).ToList();

        _periodeLoading = false;
        ApplyPeriodeFilter();
    }

