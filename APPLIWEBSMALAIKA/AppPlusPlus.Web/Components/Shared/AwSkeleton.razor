<div class="aw-skel @CssClass" aria-busy="true" aria-live="polite">
    <span class="visually-hidden">Chargement…</span>
    @if (Variant == "page")
    {
        <div class="aw-skel__head">
            <div class="aw-skel__block aw-skel__block--title"></div>
            <div class="aw-skel__block aw-skel__block--line"></div>
        </div>
        <div class="aw-skel__kpi">
            <div class="aw-skel__block aw-skel__block--kpi"></div>
            <div class="aw-skel__block aw-skel__block--kpi"></div>
            <div class="aw-skel__block aw-skel__block--kpi"></div>
        </div>
        <div class="aw-skel__panel">
            <div class="aw-skel__block aw-skel__block--toolbar"></div>
            <div class="aw-skel__rows">
                @for (var i = 0; i < Rows; i++)
                {
                    <div class="aw-skel__block aw-skel__block--row"></div>
                }
            </div>
        </div>
    }
    else if (Variant == "table")
    {
        <div class="aw-skel__panel">
            <div class="aw-skel__block aw-skel__block--toolbar"></div>
            <div class="aw-skel__rows">
                @for (var i = 0; i < Rows; i++)
                {
                    <div class="aw-skel__block aw-skel__block--row"></div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="aw-skel__rows">
            @for (var i = 0; i < Rows; i++)
            {
                <div class="aw-skel__block aw-skel__block--row"></div>
            }
        </div>
    }
</div>

@code {
    /// <summary>page | table | rows</summary>
    [Parameter] public string Variant { get; set; } = "page";
    [Parameter] public int Rows { get; set; } = 6;
    [Parameter] public string? CssClass { get; set; }
}
