@using MudBlazor
@using AppPlusPlus.Application.Services.Shared
@inject ICurrencyService Currency
@implements IDisposable

<div class="appro-price-input">
    <MudNumericField T="decimal?" @bind-Value="_displayValue"
                     @bind-Value:after="OnDisplayChanged"
                     Min="0"
                     Format="N0"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     Disabled="@Disabled"
                     Placeholder="0 FC"
                     Class="appro-price-input__field" />
    @if (_displayValue.HasValue && _displayValue > 0 && Taux > 0)
    {
        <small class="text-muted d-block mt-1" style="font-size:10px;line-height:1.2;">
            ≈ @CurrencyFormat.Usd(Currency.FcToUsd(_displayValue.Value, Taux), "N2") au taux @Taux.ToString("N0")
        </small>
    }
</div>

@code {
    /// <summary>Montant stocké en FC (seule devise persistée).</summary>
    [Parameter] public decimal? FcValue { get; set; }
    [Parameter] public EventCallback<decimal?> FcValueChanged { get; set; }

    [Parameter] public decimal Taux { get; set; }
    [Parameter] public bool Disabled { get; set; }

    decimal? _displayValue;
    decimal? _syncFc;
    bool _disposed;

    protected override void OnParametersSet()
    {
        if (FcValue != _syncFc)
        {
            _syncFc = FcValue;
            _displayValue = FcValue;
        }
    }

    async Task OnDisplayChanged()
    {
        if (_disposed) return;

        var fc = _displayValue.HasValue
            ? Currency.NormalizeStorageFc(_displayValue.Value)
            : (decimal?)null;

        _displayValue = fc;
        _syncFc = fc;
        await FcValueChanged.InvokeAsync(fc);
    }

    public void Dispose() => _disposed = true;
}
