@page "/grh/postes/form"
@page "/grh/postes/form/{Id:int}"
@rendermode InteractiveServer
@inject IJobPositionService  JobPositionService
@inject IDepartmentService   DepartmentService
@inject ISnackbar            Snackbar
@inject NavigationManager    Nav

<PageTitle>@AppSettings.AppName — @(_isEdit ? "Modifier poste" : "Nouveau poste")</PageTitle>

@if (!_loaded)
{
    <div class="aw-page">
        <div class="aw-loading" style="min-height:200px;">
            <span class="aw-spinner" role="status" aria-hidden="true"></span>
            <span>Chargement…</span>
        </div>
    </div>
}
else
{
    <div class="aw-page">
        <div class="aw-form aw-form--wide">
            <header class="aw-form__head">
                <div>
                    <p class="aw-form__eyebrow">GRH · Organisation</p>
                    <h1 class="aw-form__title">@(_isEdit ? "Modifier le poste" : "Nouveau poste")</h1>
                </div>
                <div class="aw-form__actions">
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="Cancel">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </button>
                    <button type="button" class="aw-btn aw-btn--primary" @onclick="SaveAsync" disabled="@_saving">
                        <i class="bi bi-check-lg"></i> @(_saving ? "Enregistrement…" : "Enregistrer")
                    </button>
                </div>
            </header>
            <div class="aw-form__body">
                <div class="aw-form__grid">
                    <div class="aw-field">
                        <label class="aw-field__label">Code <span class="text-danger">*</span></label>
                        <input class="aw-input" @bind="_form.PositionCode" placeholder="PST001" />
                    </div>
                    <div class="aw-field">
                        <label class="aw-field__label">Intitulé <span class="text-danger">*</span></label>
                        <input class="aw-input" @bind="_form.PositionName" placeholder="Intitulé du poste" />
                    </div>
                    <div class="aw-field">
                        <label class="aw-field__label">Département <span class="text-danger">*</span></label>
                        <select class="aw-input" @bind="_form.DepartmentId">
                            <option value="0">— Sélectionner —</option>
                            @foreach (var d in _departments)
                            {
                                <option value="@d.Id">@d.DepartmentName</option>
                            }
                        </select>
                    </div>
                    <div class="aw-field">
                        <label class="aw-field__label">Niveau d'études</label>
                        <input class="aw-input" @bind="_form.EducationLevel" placeholder="Bac+2, Bac+5…" />
                    </div>
                    <div class="aw-field">
                        <label class="aw-field__label">Expérience (ans)</label>
                        <input type="number" class="aw-input" @bind="_form.ExperienceYearsRequired" placeholder="0" min="0" />
                    </div>
                    <div class="aw-field">
                        <label class="aw-field__label">Salaire min (TND)</label>
                        <input type="number" class="aw-input" @bind="_form.MinSalary" placeholder="0.00" min="0" step="0.01" />
                    </div>
                    <div class="aw-field">
                        <label class="aw-field__label">Salaire max (TND)</label>
                        <input type="number" class="aw-input" @bind="_form.MaxSalary" placeholder="0.00" min="0" step="0.01" />
                    </div>
                    <div class="aw-field aw-form__span-2">
                        <label class="aw-field__label">Description</label>
                        <textarea class="form-control" rows="3" style="height:auto;min-height:5rem;" @bind="_form.Description"
                                  placeholder="Description du poste"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    bool _loaded;
    bool _saving;
    bool _isEdit => Id > 0;

    JobPositionFormData _form = new();
    List<Department> _departments = new();

    protected override async Task OnInitializedAsync()
    {
        _departments = (await DepartmentService.GetAllDepartmentsAsync()).ToList();

        if (_isEdit)
        {
            try
            {
                var positions = await JobPositionService.GetAllPositionsAsync();
                var pos = positions.FirstOrDefault(p => p.Id == Id);
                if (pos != null)
                {
                    _form = new JobPositionFormData
                    {
                        PositionCode             = pos.PositionCode,
                        PositionName             = pos.PositionName,
                        DepartmentId             = pos.DepartmentId,
                        EducationLevel           = pos.RequiredEducation,
                        ExperienceYearsRequired  = pos.RequiredExperience ?? 0,
                        MinSalary                = pos.SalaryRange_Min ?? 0m,
                        MaxSalary                = pos.SalaryRange_Max ?? 0m
                    };
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erreur : {ex.Message}", Severity.Error);
                Nav.NavigateTo("/grh?tab=0");
            }
        }
        _loaded = true;
    }

    async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.PositionCode)) { Snackbar.Add("Le code est obligatoire.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_form.PositionName)) { Snackbar.Add("L'intitulé est obligatoire.", Severity.Warning); return; }
        if (_form.DepartmentId == 0) { Snackbar.Add("Veuillez sélectionner un département.", Severity.Warning); return; }

        _saving = true;
        try
        {
            if (_isEdit)
            {
                var positions = await JobPositionService.GetAllPositionsAsync();
                var pos = positions.First(p => p.Id == Id);
                pos.PositionCode            = _form.PositionCode.Trim();
                pos.PositionName            = _form.PositionName.Trim();
                pos.DepartmentId            = _form.DepartmentId;
                pos.RequiredEducation       = _form.EducationLevel;
                pos.RequiredExperience      = _form.ExperienceYearsRequired;
                pos.SalaryRange_Min         = _form.MinSalary;
                pos.SalaryRange_Max         = _form.MaxSalary;
                await JobPositionService.UpdateJobPositionAsync(pos);
                Snackbar.Add("Poste mis à jour.", Severity.Success);
            }
            else
            {
                var created = await JobPositionService.CreateJobPositionAsync(
                    _form.PositionCode.Trim(), _form.PositionName.Trim(),
                    _form.DepartmentId, _departments.FirstOrDefault(d => d.Id == _form.DepartmentId)?.CompanyId ?? 0);
                created.RequiredEducation  = _form.EducationLevel;
                created.RequiredExperience = _form.ExperienceYearsRequired;
                created.SalaryRange_Min    = _form.MinSalary;
                created.SalaryRange_Max    = _form.MaxSalary;
                await JobPositionService.UpdateJobPositionAsync(created);
                Snackbar.Add("Poste créé.", Severity.Success);
            }
            Nav.NavigateTo("/grh?tab=0");
        }
        catch (Exception ex) { Snackbar.Add($"Erreur : {ex.Message}", Severity.Error); }
        finally { _saving = false; }
    }

    void Cancel() => Nav.NavigateTo("/grh?tab=0");

    class JobPositionFormData
    {
        public string   PositionCode            { get; set; } = "";
        public string   PositionName            { get; set; } = "";
        public int      DepartmentId            { get; set; }
        public string?  EducationLevel          { get; set; }
        public int      ExperienceYearsRequired { get; set; }
        public decimal  MinSalary               { get; set; }
        public decimal  MaxSalary               { get; set; }
        public string?  Description             { get; set; }
    }
}
