@page "/grh/documents"
@using AppPlusPlus.Application.Services.GRH
@using AppPlusPlus.Application.DTOs.GRH.Document
@using MudBlazor
@inject IDocumentService DocumentService
@inject ISnackbar Snackbar

<PageTitle>@AppSettings.AppName — Documents</PageTitle>

<div class="aw-page aw-page--workspace">
    <div class="aw-workspace">
        <header class="aw-object-head">
            <div class="aw-object-head__identity">
                <p class="aw-object-head__eyebrow">Module GRH</p>
                <h1 class="aw-object-head__title">Gestion des documents</h1>
                <p class="aw-object-head__desc">Documents RH et attestations</p>
            </div>
        </header>

        <nav class="aw-modnav" aria-label="Sections documents" role="tablist">
            <button type="button" role="tab" aria-selected="@(_tab == 0)"
                    class="aw-modnav__item @(_tab == 0 ? "aw-modnav__item--active" : "")"
                    @onclick="@(() => _tab = 0)">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span>Documents</span>
            </button>
            <button type="button" role="tab" aria-selected="@(_tab == 1)"
                    class="aw-modnav__item @(_tab == 1 ? "aw-modnav__item--active" : "")"
                    @onclick="@(() => _tab = 1)">
                <i class="bi bi-award" aria-hidden="true"></i>
                <span>Attestations</span>
            </button>
        </nav>

        <div class="aw-workspace__body">
            @if (_tab == 0)
            {
                <div class="aw-actionbar">
                    <div class="aw-actionbar__actions">
                        <button type="button" class="aw-btn aw-btn--primary">
                            <i class="bi bi-upload"></i> Ajouter document
                        </button>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="aw-table-region">
                        <div class="aw-loading">
                            <span class="aw-spinner" role="status" aria-hidden="true"></span>
                            <span>Chargement des documents…</span>
                        </div>
                    </div>
                }
                else if (documents.Count > 0)
                {
                    <div class="aw-table-region">
                        <MudDataGrid Items="@documents" Hover="true" Bordered="false" Dense="true"
                                     Striped="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.DocumentNumber" Title="Numéro" />
                                <PropertyColumn Property="x => x.EmployeeName" Title="Employé" />
                                <PropertyColumn Property="x => x.DocumentTypeName" Title="Type" />
                                <PropertyColumn Property="x => x.UploadDate" Title="Ajout" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.ExpiryDate" Title="Expiration" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.Status" Title="Statut">
                                    <CellTemplate>
                                        <MudChip Size="Size.Small" Label="true"
                                                 Color="@GetDocumentStatusColor(context.Item.Status)">
                                            @context.Item.Status
                                        </MudChip>
                                    </CellTemplate>
                                </PropertyColumn>
                                <TemplateColumn CellClass="d-flex gap-2" Title="Actions">
                                    <CellTemplate>
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Download"
                                                      Color="Color.Info" />
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                                      Color="Color.Error" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>
                }
                else
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-file-earmark-text"></i>
                            <p>Aucun document.</p>
                        </div>
                    </div>
                }
            }
            else
            {
                @if (isLoading)
                {
                    <div class="aw-table-region">
                        <div class="aw-loading">
                            <span class="aw-spinner" role="status" aria-hidden="true"></span>
                            <span>Chargement des attestations…</span>
                        </div>
                    </div>
                }
                else if (attestations.Count > 0)
                {
                    <div class="aw-table-region">
                        <MudDataGrid Items="@attestations" Hover="true" Bordered="false" Dense="true"
                                     Striped="true" Elevation="0">
                            <Columns>
                                <PropertyColumn Property="x => x.AttestationNumber" Title="Numéro" />
                                <PropertyColumn Property="x => x.EmployeeName" Title="Employé" />
                                <PropertyColumn Property="x => x.AttestationType" Title="Type" />
                                <PropertyColumn Property="x => x.IssueDate" Title="Émise" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.ExpiryDate" Title="Expiration" Format="dd/MM/yyyy" />
                                <PropertyColumn Property="x => x.Status" Title="Statut">
                                    <CellTemplate>
                                        <MudChip Size="Size.Small" Label="true"
                                                 Color="@GetDocumentStatusColor(context.Item.Status)">
                                            @context.Item.Status
                                        </MudChip>
                                    </CellTemplate>
                                </PropertyColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>
                }
                else
                {
                    <div class="aw-table-region">
                        <div class="aw-empty">
                            <i class="bi bi-award"></i>
                            <p>Aucune attestation.</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<DocumentReadDto> documents = new();
    private List<AttestationReadDto> attestations = new();
    private int _tab = 0;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        try
        {
            isLoading = true;
            // TODO: Appeler les services
            await Task.Delay(500);
            isLoading = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur: {ex.Message}", Severity.Error);
            isLoading = false;
        }
    }

    private Color GetDocumentStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "active" => Color.Success,
            "expired" => Color.Error,
            "expiring soon" => Color.Warning,
            "archived" => Color.Default,
            _ => Color.Default
        };
    }
}
