@page "/grh/evaluations"
@using AppPlusPlus.Application.Services.GRH
@using AppPlusPlus.Application.DTOs.GRH.Evaluation
@using MudBlazor
@inject IEvaluationService EvaluationService
@inject ISnackbar Snackbar

<PageTitle>@AppSettings.AppName — Évaluations</PageTitle>

<div class="aw-page aw-page--workspace">
    <div class="aw-workspace">
        <header class="aw-object-head">
            <div class="aw-object-head__identity">
                <p class="aw-object-head__eyebrow">Module GRH</p>
                <h1 class="aw-object-head__title">Évaluations de performance</h1>
                <p class="aw-object-head__desc">Notes, périodes et suivi</p>
            </div>
        </header>

        <div class="aw-workspace__body">
            <div class="aw-actionbar">
                <div class="aw-actionbar__filters">
                    <MudNumericField @bind-Value="selectedYear" Label="Année" Min="2020" Max="2030"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:120px;" />
                </div>
                <div class="aw-actionbar__actions">
                    <button type="button" class="aw-btn aw-btn--ghost" @onclick="FilterEvaluations">
                        <i class="bi bi-funnel"></i> Filtrer
                    </button>
                    <button type="button" class="aw-btn aw-btn--primary">
                        <i class="bi bi-plus-lg"></i> Nouvelle évaluation
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="aw-table-region">
                    <div class="aw-loading">
                        <span class="aw-spinner" role="status" aria-hidden="true"></span>
                        <span>Chargement des évaluations…</span>
                    </div>
                </div>
            }
            else if (evaluations.Count > 0)
            {
                <div class="aw-table-region">
                    <MudDataGrid Items="@evaluations" Hover="true" Bordered="false" Dense="true"
                                 Striped="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => x.EvaluationCode" Title="Code" />
                            <PropertyColumn Property="x => x.EmployeeName" Title="Employé" />
                            <PropertyColumn Property="x => x.Year" Title="Année" />
                            <PropertyColumn Property="x => x.Period" Title="Période" />
                            <PropertyColumn Property="x => x.OverallRating" Title="Note">
                                <CellTemplate>
                                    <MudRating @bind-SelectedValue="context.Item.OverallRating" ReadOnly="true" />
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.Status" Title="Statut">
                                <CellTemplate>
                                    <MudChip Size="Size.Small" Label="true"
                                             Color="@GetEvaluationStatusColor(context.Item.Status)">
                                        @context.Item.Status
                                    </MudChip>
                                </CellTemplate>
                            </PropertyColumn>
                            <TemplateColumn CellClass="d-flex gap-2" Title="Actions">
                                <CellTemplate>
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Visibility"
                                                  Color="Color.Info" />
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                                  Color="Color.Primary" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </div>
            }
            else
            {
                <div class="aw-table-region">
                    <div class="aw-empty">
                        <i class="bi bi-star"></i>
                        <p>Aucune évaluation trouvée.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<PerformanceEvaluationReadDto> evaluations = new();
    private int selectedYear = DateTime.Now.Year;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvaluations();
    }

    private async Task LoadEvaluations()
    {
        try
        {
            isLoading = true;
            // TODO: Appeler le service
            await Task.Delay(500);
            isLoading = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erreur: {ex.Message}", Severity.Error);
            isLoading = false;
        }
    }

    private async Task FilterEvaluations()
    {
        await LoadEvaluations();
    }

    private Color GetEvaluationStatusColor(string status)
    {
        return status?.ToLower() switch
        {
            "draft" => Color.Default,
            "completed" => Color.Info,
            "approved" => Color.Success,
            _ => Color.Default
        };
    }
}
