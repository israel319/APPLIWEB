    async Task<bool> Confirmer(string message)
    {
        var result = await DialogService.ShowMessageBox("Confirmation", message,
            yesText: "Supprimer", cancelText: "Annuler");
        return result == true;
    }

    string GetCompanyName(int id)
        => _companies.FirstOrDefault(c => c.Id == id)?.CompanyName ?? "";

    string GetDepartmentName(int id)
        => _departments.FirstOrDefault(d => d.Id == id)?.DepartmentName ?? "";

    string GetPositionName(int id)
        => _positions.FirstOrDefault(p => p.Id == id)?.PositionName ?? "";

    string GetEmployeeName(int id)
    {
        var e = _employees.FirstOrDefault(x => x.Id == id);
        return e is null ? $"#{id}" : $"{e.LastName} {e.FirstName}";
    }

    string GetLeaveTypeName(int id)
        => _leaveTypes.FirstOrDefault(lt => lt.Id == id)?.LeaveTypeName ?? $"#{id}";

