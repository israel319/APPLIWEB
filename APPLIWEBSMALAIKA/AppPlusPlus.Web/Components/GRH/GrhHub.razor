    async Task SavePayrollAsync()
    {
        if (_payrollForm.PeriodStart >= _payrollForm.PeriodEnd)
        {
            Snackbar.Add("La date de fin doit être postérieure à la date de début.", Severity.Warning);
            return;
        }
        try
        {
            var run = await PayrollService.CreatePayrollRunAsync(
                _payrollForm.PeriodStart, _payrollForm.PeriodEnd);
            run.TotalGrossSalary = _payrollForm.TotalGross;
            run.TotalNetSalary   = _payrollForm.TotalNet;
            run.TotalDeductions  = _payrollForm.TotalDeductions;
            run.NumberOfEmployees = _payrollForm.NumberOfEmployees;
            run.Notes            = _payrollForm.Notes;
            await PayrollService.ProcessPayrollAsync(run.Id);  // stays Draft until explicit action
            _showPayrollForm = false;
            await LoadPayrollAsync();
            Snackbar.Add("Bulletin créé avec succès.", Severity.Success);
