        try
        {
            if (_editSalaryCompId == 0)
            {
                await SalaryComponentService.AddAsync(new SalaryComponent
                {
                    ComponentCode     = _salaryCompForm.ComponentCode.Trim(),
                    ComponentName     = _salaryCompForm.ComponentName.Trim(),
                    ComponentType     = _salaryCompForm.ComponentType,
                    CalculationMethod = _salaryCompForm.CalculationMethod,
                    DefaultAmount     = _salaryCompForm.DefaultAmount,
                    Percentage        = _salaryCompForm.Percentage,
                    Description       = _salaryCompForm.Description,
                    IsActive          = true
                });
                Snackbar.Add("Composante ajoutée.", Severity.Success);
