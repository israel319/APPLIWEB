    protected override async Task OnInitializedAsync()
    {
        // Auth check only — no GRH DB calls here to avoid DbContext concurrency.
        // All data loading is deferred to OnAfterRenderAsync (after JS interop is available).
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var login   = user.FindFirst("login")?.Value
                       ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var isAdmin = AppFunctions.Normalize(user.FindFirst(ClaimTypes.Role)?.Value) == "administrateur";

            if (!string.IsNullOrEmpty(login))
            {
                var perms = await PermissionResolver.GetPermissionsAsync(login);
                _canGrhRead   = PermissionGate.ViewTab(perms, "grh",
                    () => PermissionGate.LegacyRead(perms, AppFunctions.GRH, isAdmin));
                _canGrhWrite  = PermissionGate.DoAction(perms, "grh.write",
                    () => PermissionGate.LegacyWrite(perms, AppFunctions.GRH, isAdmin));
                _canGrhDelete = PermissionGate.LegacyDelete(perms, AppFunctions.GRH, isAdmin);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!_canGrhRead)
        {
            _loaded = true;
            StateHasChanged();
            return;
        }

        try
        {
            // Retrieve the tab that was active before the refresh
            _tab = await JS.InvokeAsync<int>("tabNavigation.getTab", "grh-hub", 0);
        }
        catch
        {
            _tab = 0;
        }

        // Load data for the active tab — single sequential chain, no concurrency
        await LoadTabDataAsync(_tab);
        _tabLoaded[_tab] = true;

        _loaded = true;
        StateHasChanged();
    }

    async Task OnTabChange(int tabIndex)
    {
        _tab = tabIndex;
        CloseForms();
        try { await JS.InvokeVoidAsync("tabNavigation.saveTab", "grh-hub", tabIndex); } catch { }

        if (_canGrhRead && !_tabLoaded[tabIndex])
        {
            await LoadTabDataAsync(tabIndex);
            _tabLoaded[tabIndex] = true;
        }
    }

    async Task LoadTabDataAsync(int tabIndex)
    {
        switch (tabIndex)
        {
            case 0: await LoadOrgAsync();         break;
            case 1: await LoadEmployeesAsync();    break;
            case 2: await LoadLeaveAsync();        break;
            case 3: await LoadPayrollAsync();      break;
            case 4: await LoadRecruitAsync();      break;
            case 5: await LoadTrainingAsync();     break;
            case 6: await LoadEvaluationsAsync();  break;
            case 7: await LoadDocumentsAsync();    break;
        }
    }

