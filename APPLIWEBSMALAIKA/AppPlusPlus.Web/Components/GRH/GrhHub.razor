                                        <TemplateColumn Title="Autres ret. (TND)" CellStyle="text-align:right;">
                                            <CellTemplate><span class="text-danger">@context.Item.OtherDeductions.ToString("N3")</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Net (TND)" CellStyle="text-align:right;">
