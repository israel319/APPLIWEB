                entity.City        = _companyForm.City;
                entity.Phone       = _companyForm.Phone;
                entity.Email       = _companyForm.Email;
                entity.Country     = _companyForm.Country;
                entity.Address     = _companyForm.Address;
                await CompanyService.UpdateCompanyAsync(entity);
