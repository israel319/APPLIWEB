    void ApplyCompanySearch()
    {
        if (string.IsNullOrWhiteSpace(_companySearch)) { _companiesFiltered = _companies; return; }
        var q = _companySearch.Trim();
        _companiesFiltered = _companies
            .Where(c => c.CompanyCode.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || c.CompanyName.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || (c.City ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    void ApplyDepartmentSearch()
    {
        if (string.IsNullOrWhiteSpace(_departmentSearch)) { _departmentsFiltered = _departments; return; }
        var q = _departmentSearch.Trim();
        _departmentsFiltered = _departments
            .Where(d => d.DepartmentCode.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || d.DepartmentName.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || (d.CompanyName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    void ApplyPositionSearch()
    {
        if (string.IsNullOrWhiteSpace(_positionSearch)) { _positionsFiltered = _positions; return; }
        var q = _positionSearch.Trim();
        _positionsFiltered = _positions
            .Where(p => p.PositionCode.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || p.PositionName.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || (p.DepartmentName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    void ApplyEmployeeSearch()
    {
        var result = _employees.AsEnumerable();

        if (_empDeptFilter > 0)
            result = result.Where(e => e.DepartmentId == _empDeptFilter);

        if (!string.IsNullOrWhiteSpace(_employeeSearch))
        {
            var q = _employeeSearch.Trim();
            result = result.Where(e =>
                e.EmployeeCode.Contains(q, StringComparison.OrdinalIgnoreCase)
             || e.FirstName.Contains(q, StringComparison.OrdinalIgnoreCase)
             || e.LastName.Contains(q, StringComparison.OrdinalIgnoreCase)
             || (e.Email ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        _employeesFiltered = result.ToList();
    }

