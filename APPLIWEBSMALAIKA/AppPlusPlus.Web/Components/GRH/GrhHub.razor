                                                <span class="fw-bold text-success">@context.Item.NetSalary.ToString("N3")</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="PayrollDetail" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }
                }

            </div>
        </div>
    </div>
    }
}

