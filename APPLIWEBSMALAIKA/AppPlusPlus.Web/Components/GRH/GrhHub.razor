@page "/grh"
@page "/grh/organization"
@rendermode InteractiveServer
@inject ICompanyService                CompanyService
@inject IDepartmentService             DepartmentService
@inject IServiceService                ServiceService
@inject IJobPositionService            JobPositionService
@inject IEmployeeService               EmployeeService
@inject ILeaveService                  LeaveService
@inject IAbsenceService                AbsenceService
@inject ILeaveTypeService              LeaveTypeService
@inject IAbsenceTypeService            AbsenceTypeService
@inject IEmployeeCategoryService       EmployeeCategoryService
@inject IEmployeeClassificationService EmployeeClassificationService
@inject IPayrollService          PayrollService
@inject ISalaryComponentService  SalaryComponentService
@inject IRecruitmentService  RecruitmentService
@inject ITrainingService     TrainingService
@inject IEvaluationService   EvaluationService
@inject IDocumentService     DocumentService
@inject ISnackbar            Snackbar
@inject IDialogService       DialogService
@inject NavigationManager    Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionResolver  PermissionResolver
@inject IJSRuntime           JS

<ModuleGuard ModuleCode="grh" ModuleName="GRH – Ressources Humaines">

<PageTitle>@AppSettings.AppName — GRH</PageTitle>

@if (!_loaded)
{
    <div class="aw-page">
        <AwSkeleton Variant="page" Rows="7" />
    </div>
}
else
{
    @if (!_canGrhRead)
    {
        <div class="aw-page">
            <div class="aw-shell" style="max-width:720px;margin:1.5rem auto;">
                <div class="aw-empty">
                    <i class="bi bi-lock"></i>
                    <p><strong>Accès refusé</strong><br />Votre rôle ne possède pas les droits d'accès au module GRH.</p>
                </div>
            </div>
        </div>
    }
    else
    {
    <div class="aw-page aw-page--workspace">
        <div class="aw-workspace">
            <header class="aw-object-head">
                <div class="aw-object-head__identity">
                    <p class="aw-object-head__eyebrow">Module GRH</p>
                    <h1 class="aw-object-head__title">GRH — Ressources Humaines</h1>
                    <p class="aw-object-head__desc">Organisation · Employés · Congés &amp; Absences · Paie</p>
                </div>
            </header>

            <nav class="aw-railnav" aria-label="Sections GRH" role="tablist">
                <button type="button" role="tab" aria-selected="@(_tab == 0)"
                        class="aw-railnav__item @(_tab == 0 ? "aw-railnav__item--active" : "")"
                        title="Organisation"
                        @onclick="@(async () => await OnTabChange(0))">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    Organisation
                </button>
                <button type="button" role="tab" aria-selected="@(_tab == 1)"
                        class="aw-railnav__item @(_tab == 1 ? "aw-railnav__item--active" : "")"
                        title="Employés"
                        @onclick="@(async () => await OnTabChange(1))">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                    Employés
                </button>
                <button type="button" role="tab" aria-selected="@(_tab == 2)"
                        class="aw-railnav__item @(_tab == 2 ? "aw-railnav__item--active" : "")"
                        title="Congés &amp; Absences"
                        @onclick="@(async () => await OnTabChange(2))">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i>
                    Congés &amp; Absences
                </button>
                <button type="button" role="tab" aria-selected="@(_tab == 3)"
                        class="aw-railnav__item @(_tab == 3 ? "aw-railnav__item--active" : "")"
                        title="Paie"
                        @onclick="@(async () => await OnTabChange(3))">
                    <i class="bi bi-cash-coin" aria-hidden="true"></i>
                    Paie
                </button>
            </nav>

            <div class="aw-workspace__body">

                @* ════════════════════════════════════════════════════════════
                   ONGLET 0 — ORGANISATION
                   ════════════════════════════════════════════════════════════ *@
                @if (_tab == 0)
                {
                    <nav class="aw-modnav" aria-label="Sous-sections organisation" role="tablist">
                        <button type="button" role="tab" aria-selected="@(_orgTab == 0)"
                                class="aw-modnav__item @(_orgTab == 0 ? "aw-modnav__item--active" : "")"
                                @onclick="@(() => _orgTab = 0)">
                            <i class="bi bi-building" aria-hidden="true"></i>
                            <span>Sociétés</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_orgTab == 1)"
                                class="aw-modnav__item @(_orgTab == 1 ? "aw-modnav__item--active" : "")"
                                @onclick="@(() => _orgTab = 1)">
                            <i class="bi bi-diagram-3" aria-hidden="true"></i>
                            <span>Départements</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_orgTab == 2)"
                                class="aw-modnav__item @(_orgTab == 2 ? "aw-modnav__item--active" : "")"
                                @onclick="@(() => _orgTab = 2)">
                            <i class="bi bi-briefcase" aria-hidden="true"></i>
                            <span>Postes</span>
                        </button>
                    </nav>

                    @* ── SOCIÉTÉS ── *@
                    @if (_orgTab == 0)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" placeholder="Rechercher une société…"
                                       aria-label="Rechercher une société"
                                       @bind="_companySearch" @bind:event="oninput"
                                       @bind:after="ApplyCompanySearch" />
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateCompany">
                                        <i class="bi bi-plus-lg"></i> Nouvelle société
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_companiesLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_companiesFiltered.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-building"></i>
                                    <p>Aucune société pour ces filtres.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="Company" Items="@_companiesFiltered"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="10">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.CompanyCode)" Title="Code" />
                                        <PropertyColumn Property="@(x => x.CompanyName)" Title="Raison sociale" />
                                        <PropertyColumn Property="@(x => x.City)" Title="Ville" />
                                        <PropertyColumn Property="@(x => x.Phone)" Title="Téléphone" />
                                        <PropertyColumn Property="@(x => x.Email)" Title="Email" />
                                        <TemplateColumn Title="Statut" CellStyle="width:90px;">
                                            <CellTemplate>
                                                @if (context.Item.IsActive)
                                                {
                                                    <span class="hub-badge hub-badge--success"><i class="bi bi-check-circle me-1"></i>Actif</span>
                                                }
                                                else
                                                {
                                                    <span class="hub-badge hub-badge--neutral"><i class="bi bi-dash-circle me-1"></i>Inactif</span>
                                                }
                                            </CellTemplate>
                                        </TemplateColumn>
                                        @if (_canGrhWrite)
                                        {
                                            <TemplateColumn Title="Actions" CellStyle="width:90px;text-align:center;">
                                                <CellTemplate>
                                                    <div class="hub-grid-actions">
                                                        <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon" title="Modifier" @onclick="@(() => OpenEditCompany(context.Item))"><i class="bi bi-pencil"></i></button>
                                                        @if (_canGrhDelete)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon" title="Supprimer" @onclick="@(() => DeleteCompanyAsync(context.Item))"><i class="bi bi-trash"></i></button>
                                                        }
                                                    </div>
                                                </CellTemplate>
                                            </TemplateColumn>
                                        }
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="Company" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }

                    @* ── DÉPARTEMENTS ── *@
                    @if (_orgTab == 1)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" placeholder="Rechercher un département…"
                                       aria-label="Rechercher un département"
                                       @bind="_departmentSearch" @bind:event="oninput"
                                       @bind:after="ApplyDepartmentSearch" />
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateDepartment"
                                            disabled="@(_companies.Count == 0)">
                                        <i class="bi bi-plus-lg"></i> Nouveau département
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_departmentsLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_departmentsFiltered.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-diagram-3"></i>
                                    <p>Aucun département pour ces filtres.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="DepartmentReadDto" Items="@_departmentsFiltered"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="10">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.DepartmentCode)" Title="Code" />
                                        <PropertyColumn Property="@(x => x.DepartmentName)" Title="Nom" />
                                        <PropertyColumn Property="@(x => x.CompanyName)" Title="Société" />
                                        <PropertyColumn Property="@(x => x.EmployeeCount)" Title="Employés"
                                                        CellStyle="text-align:center" />
                                        <TemplateColumn Title="Budget" CellStyle="width:130px;text-align:right;">
                                            <CellTemplate>
                                                @if (context.Item.BudgetAmount.HasValue)
                                                {
                                                    <span>@context.Item.BudgetAmount.Value.ToString("N0")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </CellTemplate>
                                        </TemplateColumn>
                                        @if (_canGrhWrite)
                                        {
                                            <TemplateColumn Title="Actions" CellStyle="width:90px;text-align:center;">
                                                <CellTemplate>
                                                    <div class="hub-grid-actions">
                                                        <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon" title="Modifier" @onclick="@(() => OpenEditDepartment(context.Item))"><i class="bi bi-pencil"></i></button>
                                                        @if (_canGrhDelete)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon" title="Supprimer" @onclick="@(() => DeleteDepartmentAsync(context.Item))"><i class="bi bi-trash"></i></button>
                                                        }
                                                    </div>
                                                </CellTemplate>
                                            </TemplateColumn>
                                        }
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="DepartmentReadDto" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }

                    @* ── POSTES ── *@
                    @if (_orgTab == 2)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" placeholder="Rechercher un poste…"
                                       aria-label="Rechercher un poste"
                                       @bind="_positionSearch" @bind:event="oninput"
                                       @bind:after="ApplyPositionSearch" />
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreatePosition"
                                            disabled="@(_departments.Count == 0)">
                                        <i class="bi bi-plus-lg"></i> Nouveau poste
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_positionsLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_positionsFiltered.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-briefcase"></i>
                                    <p>Aucun poste pour ces filtres.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="JobPositionReadDto" Items="@_positionsFiltered"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="10">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.PositionCode)" Title="Code" />
                                        <PropertyColumn Property="@(x => x.PositionName)" Title="Intitulé" />
                                        <PropertyColumn Property="@(x => x.DepartmentName)" Title="Département" />
                                        <PropertyColumn Property="@(x => x.EducationLevel)" Title="Formation" />
                                        <TemplateColumn Title="Fourchette salariale" CellStyle="text-align:right;">
                                            <CellTemplate>
                                                @{
                                                    var pMin = context.Item.MinSalary;
                                                    var pMax = context.Item.MaxSalary;
                                                }
                                                @if (pMin.HasValue || pMax.HasValue)
                                                {
                                                    <span>@(pMin?.ToString("N0") ?? "—") – @(pMax?.ToString("N0") ?? "—")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(x => x.EmployeeCount)" Title="Employés"
                                                        CellStyle="text-align:center" />
                                        @if (_canGrhWrite)
                                        {
                                            <TemplateColumn Title="Actions" CellStyle="width:90px;text-align:center;">
                                                <CellTemplate>
                                                    <div class="hub-grid-actions">
                                                        <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon" title="Modifier" @onclick="@(() => OpenEditPosition(context.Item))"><i class="bi bi-pencil"></i></button>
                                                        @if (_canGrhDelete)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon" title="Supprimer" @onclick="@(() => DeletePositionAsync(context.Item))"><i class="bi bi-trash"></i></button>
                                                        }
                                                    </div>
                                                </CellTemplate>
                                            </TemplateColumn>
                                        }
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="JobPositionReadDto" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }
                }

                @* ════════════════════════════════════════════════════════════
                   ONGLET 1 — EMPLOYÉS
                   ════════════════════════════════════════════════════════════ *@
                @if (_tab == 1)
                {
                    <nav class="aw-modnav" aria-label="Sous-sections employés" role="tablist">
                        <button type="button" role="tab" aria-selected="@(_empTab == 0)"
                                class="aw-modnav__item @(_empTab == 0 ? "aw-modnav__item--active" : "")"
                                @onclick="@(() => _empTab = 0)">
                            <i class="bi bi-person-vcard" aria-hidden="true"></i>
                            <span>Fiches</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_empTab == 1)"
                                class="aw-modnav__item @(_empTab == 1 ? "aw-modnav__item--active" : "")"
                                @onclick="@(async () => { _empTab = 1; await LoadContractsAsync(); })">
                            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                            <span>Contrats</span>
                        </button>
                    </nav>

                    @* ── FICHES EMPLOYÉS ── *@
                    @if (_empTab == 0)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" placeholder="Rechercher un employé…"
                                       aria-label="Rechercher un employé"
                                       @bind="_employeeSearch" @bind:event="oninput"
                                       @bind:after="ApplyEmployeeSearch" />
                            </div>
                            <div class="aw-actionbar__filters">
                                <select class="aw-select" aria-label="Département"
                                        @bind="_empDeptFilter" @bind:after="ApplyEmployeeSearch">
                                    <option value="0">Tous les départements</option>
                                    @foreach (var d in _departments)
                                    {
                                        <option value="@d.Id">@d.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateEmployee">
                                        <i class="bi bi-plus-lg"></i> Nouvel employé
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_empLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_employeesFiltered.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-people"></i>
                                    <p>Aucun employé pour ces filtres.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="Employee" Items="@_employeesFiltered"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="15">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.EmployeeCode)" Title="Code" />
                                        <TemplateColumn Title="Nom complet">
                                            <CellTemplate>
                                                <span class="fw-semibold">@context.Item.LastName @context.Item.FirstName</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(x => x.Email)" Title="Email" />
                                        <TemplateColumn Title="Département">
                                            <CellTemplate><span>@GetDepartmentName(context.Item.DepartmentId)</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Poste">
                                            <CellTemplate><span>@GetPositionName(context.Item.JobPositionId)</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Contrat" CellStyle="width:80px;">
                                            <CellTemplate><span class="hub-badge hub-badge--info">@context.Item.ContractType</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Statut" CellStyle="width:85px;">
                                            <CellTemplate>
                                                @if (context.Item.Status == EmployeeStatusEnum.Active)
                                                {
                                                    <span class="hub-badge hub-badge--success"><i class="bi bi-check-circle me-1"></i>Actif</span>
                                                }
                                                else
                                                {
                                                    <span class="hub-badge hub-badge--neutral"><i class="bi bi-dash-circle me-1"></i>Inactif</span>
                                                }
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Embauche" CellStyle="width:110px;">
                                            <CellTemplate><span>@context.Item.HireDate.ToString("dd/MM/yyyy")</span></CellTemplate>
                                        </TemplateColumn>
                                        @if (_canGrhWrite)
                                        {
                                            <TemplateColumn Title="Actions" CellStyle="width:100px;text-align:center;">
                                                <CellTemplate>
                                                    <div class="hub-grid-actions">
                                                        <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon" title="Modifier" @onclick="@(() => OpenEditEmployee(context.Item))"><i class="bi bi-pencil"></i></button>
                                                        @if (_canGrhDelete && context.Item.Status == EmployeeStatusEnum.Active)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon" title="Désactiver" @onclick="@(() => DeactivateEmployeeActionAsync(context.Item))"><i class="bi bi-person-x"></i></button>
                                                        }
                                                    </div>
                                                </CellTemplate>
                                            </TemplateColumn>
                                        }
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="Employee" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }

                    @* ── CONTRATS ── *@
                    @if (_empTab == 1)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__filters">
                                <select class="aw-select" aria-label="Employé"
                                        @bind="_selectedEmpIdForContracts"
                                        @bind:after="LoadContractsAsync">
                                    <option value="0">— Sélectionner un employé —</option>
                                    @foreach (var e in _employees)
                                    {
                                        <option value="@e.Id">@e.LastName @e.FirstName (@e.EmployeeCode)</option>
                                    }
                                </select>
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateContract"
                                            disabled="@(_selectedEmpIdForContracts == 0)">
                                        <i class="bi bi-plus-lg"></i> Nouveau contrat
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_contractsLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (_selectedEmpIdForContracts == 0)
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-person-check"></i>
                                    <p>Sélectionnez un employé pour consulter ses contrats.</p>
                                </div>
                            </div>
                        }
                        else if (!_contracts.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <p>Aucun contrat pour cet employé.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="EmployeeContract" Items="@_contracts"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="10">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.ContractNumber)" Title="N° Contrat" />
                                        <PropertyColumn Property="@(x => x.ContractType)" Title="Type" />
                                        <TemplateColumn Title="Début" CellStyle="width:120px;">
                                            <CellTemplate><span>@context.Item.StartDate.ToString("dd/MM/yyyy")</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Fin" CellStyle="width:120px;">
                                            <CellTemplate>
                                                @if (context.Item.EndDate.HasValue)
                                                {
                                                    <span>@context.Item.EndDate.Value.ToString("dd/MM/yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Indéterminé</span>
                                                }
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Statut" CellStyle="width:90px;">
                                            <CellTemplate>
                                                <span class="hub-badge @(context.Item.IsActive ? "hub-badge--success" : "hub-badge--neutral")">
                                                    @(context.Item.IsActive ? "Actif" : "Terminé")
                                                </span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="EmployeeContract" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }
                }

                @* ════════════════════════════════════════════════════════════
                   ONGLET 2 — CONGÉS & ABSENCES
                   ════════════════════════════════════════════════════════════ *@
                @if (_tab == 2)
                {
                    <nav class="aw-modnav" aria-label="Sous-sections congés" role="tablist">
                        <button type="button" role="tab" aria-selected="@(_leaveTab == 0)"
                                class="aw-modnav__item @(_leaveTab == 0 ? "aw-modnav__item--active" : "")"
                                @onclick="@(() => _leaveTab = 0)">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            <span>Congés</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_leaveTab == 1)"
                                class="aw-modnav__item @(_leaveTab == 1 ? "aw-modnav__item--active" : "")"
                                @onclick="@(async () => { _leaveTab = 1; await LoadAbsencesAsync(); })">
                            <i class="bi bi-calendar-x" aria-hidden="true"></i>
                            <span>Absences</span>
                        </button>
                    </nav>

                    @* ── CONGÉS ── *@
                    @if (_leaveTab == 0)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__filters">
                                <select class="aw-select" aria-label="Statut"
                                        @bind="_leaveStatusFilter" @bind:after="StateHasChanged">
                                    <option value="All">Tous les statuts</option>
                                    <option value="Pending">En attente</option>
                                    <option value="Approved">Approuvé</option>
                                    <option value="Rejected">Refusé</option>
                                </select>
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--ghost"
                                            @onclick="@(async () => await ResetAnnualLeavesActionAsync())"
                                            disabled="@_resettingLeaves"
                                            title="Reporte les soldes de l'année précédente — sp_GenerateAnnualLeaveReset">
                                        @if (_resettingLeaves)
                                        {
                                            <span class="aw-spinner" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        }
                                        Réinit. annuelle (@DateTime.Now.Year)
                                    </button>
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateLeaveRequest">
                                        <i class="bi bi-plus-lg"></i> Nouvelle demande
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_leaveLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else
                        {
                            var filteredLeaves = _leaveStatusFilter == "All"
                                ? _allLeaveRequests
                                : _allLeaveRequests.Where(r => r.Status.ToString() == _leaveStatusFilter).ToList();
                            @if (!filteredLeaves.Any())
                            {
                                <div class="aw-table-region">
                                    <div class="aw-empty">
                                        <i class="bi bi-calendar-check"></i>
                                        <p>Aucune demande de congé pour ces filtres.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="aw-table-region">
                                    <MudDataGrid T="LeaveRequest" Items="@filteredLeaves"
                                                 Dense="true" Hover="true" Bordered="true"
                                                 Elevation="0" Filterable="false" RowsPerPage="15">
                                        <Columns>
                                            <TemplateColumn Title="Employé">
                                                <CellTemplate><span>@GetEmployeeName(context.Item.EmployeeId)</span></CellTemplate>
                                            </TemplateColumn>
                                            <TemplateColumn Title="Type congé">
                                                <CellTemplate><span>@GetLeaveTypeName(context.Item.LeaveTypeId)</span></CellTemplate>
                                            </TemplateColumn>
                                            <TemplateColumn Title="Début" CellStyle="width:110px;">
                                                <CellTemplate><span>@context.Item.StartDate.ToString("dd/MM/yyyy")</span></CellTemplate>
                                            </TemplateColumn>
                                            <TemplateColumn Title="Fin" CellStyle="width:110px;">
                                                <CellTemplate><span>@context.Item.EndDate.ToString("dd/MM/yyyy")</span></CellTemplate>
                                            </TemplateColumn>
                                            <PropertyColumn Property="@(x => x.NumberOfDays)" Title="Jours" />
                                            <TemplateColumn Title="Statut" CellStyle="width:110px;">
                                                <CellTemplate>
                                                    @{
                                                        var (lBadge, lLbl, lIcon) = context.Item.Status.ToString() switch
                                                        {
                                                            "Pending"  => ("hub-badge--warning", "En attente", "bi-hourglass-split"),
                                                            "Approved" => ("hub-badge--success", "Approuvé", "bi-check-circle"),
                                                            "Rejected" => ("hub-badge--danger", "Refusé", "bi-x-circle"),
                                                            _          => ("hub-badge--neutral", context.Item.Status.ToString(), "bi-question-circle")
                                                        };
                                                    }
                                                    <span class="hub-badge @lBadge"><i class="bi @lIcon me-1"></i>@lLbl</span>
                                                </CellTemplate>
                                            </TemplateColumn>
                                            <PropertyColumn Property="@(x => x.Reason)" Title="Motif" />
                                            @if (_canGrhWrite)
                                            {
                                                <TemplateColumn Title="Actions" CellStyle="width:110px;text-align:center;">
                                                    <CellTemplate>
                                                        @if (context.Item.Status == LeaveStatusEnum.Pending)
                                                        {
                                                            <div class="hub-grid-actions">
                                                                <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon" title="Approuver" @onclick="@(() => ApproveLeaveAsync(context.Item.Id))"><i class="bi bi-check-lg"></i></button>
                                                                <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon" title="Refuser" @onclick="@(() => RejectLeaveAsync(context.Item.Id))"><i class="bi bi-x-lg"></i></button>
                                                            </div>
                                                        }
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            }
                                        </Columns>
                                        <PagerContent>
                                            <MudDataGridPager T="LeaveRequest" />
                                        </PagerContent>
                                    </MudDataGrid>
                                </div>
                            }
                        }
                    }

                    @* ── ABSENCES ── *@
                    @if (_leaveTab == 1)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateAbsence">
                                        <i class="bi bi-plus-lg"></i> Nouvelle absence
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_absenceLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_absences.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-calendar-x"></i>
                                    <p>Aucune absence enregistrée.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="Absence" Items="@_absences"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="15">
                                    <Columns>
                                        <TemplateColumn Title="Employé">
                                            <CellTemplate><span>@GetEmployeeName(context.Item.EmployeeId)</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Type">
                                            <CellTemplate><span>@GetAbsenceTypeName(context.Item.AbsenceTypeId)</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Date" CellStyle="width:110px;">
                                            <CellTemplate><span>@context.Item.AbsenceDate.ToString("dd/MM/yyyy")</span></CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Durée (h)" CellStyle="width:100px;">
                                            <CellTemplate><span>@context.Item.Duration h</span></CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(x => x.Reason)" Title="Motif" />
                                        <TemplateColumn Title="Statut" CellStyle="width:110px;">
                                            <CellTemplate>
                                                @{
                                                    var (aBadge, aLbl, aIcon) = (context.Item.Status ?? "") switch
                                                    {
                                                        "Pending"  => ("hub-badge--warning", "En attente", "bi-hourglass-split"),
                                                        "Approved" => ("hub-badge--success", "Approuvé", "bi-check-circle"),
                                                        "Rejected" => ("hub-badge--danger", "Refusé", "bi-x-circle"),
                                                        _          => ("hub-badge--neutral", context.Item.Status ?? "—", "bi-question-circle")
                                                    };
                                                }
                                                <span class="hub-badge @aBadge"><i class="bi @aIcon me-1"></i>@aLbl</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        @if (_canGrhWrite)
                                        {
                                            <TemplateColumn Title="Actions" CellStyle="width:110px;text-align:center;">
                                                <CellTemplate>
                                                    @if ((context.Item.Status ?? "Pending") == "Pending")
                                                    {
                                                        <div class="hub-grid-actions">
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon" title="Approuver" @onclick="@(() => ApproveAbsenceActionAsync(context.Item.Id))"><i class="bi bi-check-lg"></i></button>
                                                            <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon" title="Refuser" @onclick="@(() => RejectAbsenceActionAsync(context.Item.Id))"><i class="bi bi-x-lg"></i></button>
                                                        </div>
                                                    }
                                                </CellTemplate>
                                            </TemplateColumn>
                                        }
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="Absence" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }
                }

                @* ════════════════════════════════════════════════════════════
                   ONGLET 3 — PAIE
                   ════════════════════════════════════════════════════════════ *@
                @if (_tab == 3)
                {
                    <nav class="aw-modnav" aria-label="Sous-sections paie" role="tablist">
                        <button type="button" role="tab" aria-selected="@(_paieTab == 0)"
                                class="aw-modnav__item @(_paieTab == 0 ? "aw-modnav__item--active" : "")"
                                @onclick="@(async () => { _paieTab = 0; await LoadPayrollAsync(); })">
                            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                            <span>Bulletins</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_paieTab == 1)"
                                class="aw-modnav__item @(_paieTab == 1 ? "aw-modnav__item--active" : "")"
                                @onclick="@(async () => { _paieTab = 1; await LoadSalaryComponentsAsync(); })">
                            <i class="bi bi-sliders" aria-hidden="true"></i>
                            <span>Composantes</span>
                        </button>
                        @if (_selectedPayrollRun != null)
                        {
                            <button type="button" role="tab" aria-selected="@(_paieTab == 2)"
                                    class="aw-modnav__item @(_paieTab == 2 ? "aw-modnav__item--active" : "")"
                                    @onclick="@(async () => { _paieTab = 2; await LoadPayrollDetailsAsync(); })">
                                <i class="bi bi-people" aria-hidden="true"></i>
                                <span>Détails — @_selectedPayrollRun.PayrollNumber</span>
                            </button>
                        }
                    </nav>

                    @* ── Sous-onglet 0 : Bulletins ── *@
                    @if (_paieTab == 0)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__filters">
                                <select class="aw-select" aria-label="Mois"
                                        @bind="_payrollMonth" @bind:after="LoadPayrollAsync">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        var mo = m;
                                        <option value="@mo">
                                            @(new DateTime(2000, mo, 1).ToString("MMMM", new System.Globalization.CultureInfo("fr-FR")))
                                        </option>
                                    }
                                </select>
                                <input type="number" class="aw-input" style="width:5.5rem;"
                                       aria-label="Année"
                                       @bind="_payrollYear" @bind:after="LoadPayrollAsync"
                                       min="2000" max="2100" />
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreatePayroll">
                                        <i class="bi bi-plus-lg"></i> Nouveau bulletin
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_payrollLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_payrollRuns.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <p>Aucun bulletin pour cette période.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="PayrollRun" Items="@_payrollRuns"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="15">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.PayrollNumber)" Title="N° Bulletin" />
                                        <TemplateColumn Title="Période">
                                            <CellTemplate>
                                                @context.Item.PayPeriodStart.ToString("dd/MM/yyyy")
                                                – @context.Item.PayPeriodEnd.ToString("dd/MM/yyyy")
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(x => x.NumberOfEmployees)" Title="Employés" />
                                        <TemplateColumn Title="Brut total (TND)" CellStyle="text-align:right;">
                                            <CellTemplate>
                                                <span class="text-end">@context.Item.TotalGrossSalary.ToString("N3")</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Retenues (TND)" CellStyle="text-align:right;">
                                            <CellTemplate>
                                                <span class="text-danger">@context.Item.TotalDeductions.ToString("N3")</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Net total (TND)" CellStyle="text-align:right;">
                                            <CellTemplate>
                                                <span class="fw-semibold text-success">@context.Item.TotalNetSalary.ToString("N3")</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Statut" CellStyle="width:110px;">
                                            <CellTemplate>
                                                @{
                                                    var (pBadge, pLbl, pIcon) = context.Item.Status switch
                                                    {
                                                        PayrollStatusEnum.Draft      => ("hub-badge--neutral", "Brouillon", "bi-pencil"),
                                                        PayrollStatusEnum.Prepared   => ("hub-badge--info", "Préparé", "bi-gear"),
                                                        PayrollStatusEnum.Approved   => ("hub-badge--success", "Approuvé", "bi-check-circle"),
                                                        PayrollStatusEnum.Paid       => ("hub-badge--primary", "Payé", "bi-cash-coin"),
                                                        PayrollStatusEnum.Cancelled  => ("hub-badge--danger", "Annulé", "bi-x-circle"),
                                                        _                            => ("hub-badge--neutral", context.Item.Status.ToString(), "bi-question-circle")
                                                    };
                                                }
                                                <span class="hub-badge @pBadge"><i class="bi @pIcon me-1"></i>@pLbl</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Actions" CellStyle="width:200px;">
                                            <CellTemplate>
                                                <div class="hub-grid-actions">
                                                    <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon"
                                                            title="Voir détails"
                                                            @onclick="@(() => OpenPayrollDetails(context.Item))">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    @if (_canGrhWrite)
                                                    {
                                                        @if (context.Item.Status == PayrollStatusEnum.Draft)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon"
                                                                    title="Passer en Préparé"
                                                                    @onclick="@(async () => await ProcessPayrollActionAsync(context.Item.Id))">
                                                                <i class="bi bi-gear"></i>
                                                            </button>
                                                        }
                                                        @if (context.Item.Status == PayrollStatusEnum.Prepared)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon"
                                                                    title="Approuver"
                                                                    @onclick="@(async () => await ApprovePayrollActionAsync(context.Item.Id))">
                                                                <i class="bi bi-check-circle"></i>
                                                            </button>
                                                        }
                                                        @if (context.Item.Status == PayrollStatusEnum.Approved)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon"
                                                                    title="Marquer Payé"
                                                                    @onclick="@(async () => await MarkPaidActionAsync(context.Item.Id))">
                                                                <i class="bi bi-currency-dollar"></i>
                                                            </button>
                                                        }
                                                    }
                                                    @if (_canGrhDelete && context.Item.Status == PayrollStatusEnum.Draft)
                                                    {
                                                        <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon"
                                                                title="Supprimer"
                                                                @onclick="@(async () => await DeletePayrollActionAsync(context.Item.Id))">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="PayrollRun" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }

                    @* ── Sous-onglet 1 : Composantes salariales ── *@
                    @if (_paieTab == 1)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite)
                                {
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenCreateSalaryComp">
                                        <i class="bi bi-plus-lg"></i> Nouvelle composante
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_salaryCompLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_salaryComponents.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-cash-stack"></i>
                                    <p>Aucune composante salariale.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="SalaryComponent" Items="@_salaryComponents"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="15">
                                    <Columns>
                                        <PropertyColumn Property="@(x => x.ComponentCode)" Title="Code" />
                                        <PropertyColumn Property="@(x => x.ComponentName)" Title="Libellé" />
                                        <TemplateColumn Title="Type" CellStyle="width:130px;">
                                            <CellTemplate>
                                                @{
                                                    var (tcls, tlbl) = context.Item.ComponentType switch
                                                    {
                                                        "Base"       => ("hub-badge--primary",  "Salaire de base"),
                                                        "Allowance"  => ("hub-badge--success",  "Prime"),
                                                        "Deduction"  => ("hub-badge--danger",   "Retenue"),
                                                        "Bonus"      => ("hub-badge--warning",  "Bonus"),
                                                        _            => ("hub-badge--neutral",  context.Item.ComponentType)
                                                    };
                                                }
                                                <span class="hub-badge @tcls">@tlbl</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Méthode">
                                            <CellTemplate>
                                                @(context.Item.CalculationMethod == "Percentage"
                                                    ? $"{context.Item.Percentage:N2} %"
                                                    : $"{context.Item.DefaultAmount:N3} TND")
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(x => x.Description)" Title="Description" />
                                        @if (_canGrhWrite || _canGrhDelete)
                                        {
                                            <TemplateColumn Title="Actions" CellStyle="width:100px;">
                                                <CellTemplate>
                                                    <div class="hub-grid-actions">
                                                        @if (_canGrhWrite)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--ghost aw-btn--sm aw-btn--icon"
                                                                    title="Modifier"
                                                                    @onclick="@(() => OpenEditSalaryComp(context.Item))">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                        }
                                                        @if (_canGrhDelete)
                                                        {
                                                            <button type="button" class="aw-btn aw-btn--danger aw-btn--sm aw-btn--icon"
                                                                    title="Supprimer"
                                                                    @onclick="@(async () => await DeleteSalaryCompAsync(context.Item.Id))">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </CellTemplate>
                                            </TemplateColumn>
                                        }
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="SalaryComponent" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        }
                    }

                    @* ── Sous-onglet 2 : Détails du bulletin sélectionné ── *@
                    @if (_paieTab == 2 && _selectedPayrollRun != null)
                    {
                        <div class="aw-actionbar">
                            <div class="aw-actionbar__filters" style="flex-wrap:wrap;gap:0.75rem 1.25rem;">
                                <span>
                                    <span class="aw-object-head__eyebrow" style="display:block;">Bulletin</span>
                                    <strong>@_selectedPayrollRun.PayrollNumber</strong>
                                </span>
                                <span>
                                    <span class="aw-object-head__eyebrow" style="display:block;">Période</span>
                                    <strong>
                                        @_selectedPayrollRun.PayPeriodStart.ToString("dd/MM/yyyy") –
                                        @_selectedPayrollRun.PayPeriodEnd.ToString("dd/MM/yyyy")
                                    </strong>
                                </span>
                                <span>
                                    <span class="aw-object-head__eyebrow" style="display:block;">Brut</span>
                                    <strong>@_selectedPayrollRun.TotalGrossSalary.ToString("N3") TND</strong>
                                </span>
                                <span>
                                    <span class="aw-object-head__eyebrow" style="display:block;">Net</span>
                                    <strong style="color:var(--aw-brand,#007a68);">@_selectedPayrollRun.TotalNetSalary.ToString("N3") TND</strong>
                                </span>
                                @{
                                    var (rBadge, rLbl) = _selectedPayrollRun.Status switch
                                    {
                                        PayrollStatusEnum.Draft     => ("hub-badge--neutral", "Brouillon"),
                                        PayrollStatusEnum.Prepared  => ("hub-badge--info",    "Préparé"),
                                        PayrollStatusEnum.Approved  => ("hub-badge--success", "Approuvé"),
                                        PayrollStatusEnum.Paid      => ("hub-badge--primary", "Payé"),
                                        _                           => ("hub-badge--neutral", _selectedPayrollRun.Status.ToString())
                                    };
                                }
                                <span class="hub-badge @rBadge">@rLbl</span>
                            </div>
                            <div class="aw-actionbar__actions">
                                @if (_canGrhWrite && _selectedPayrollRun.Status == PayrollStatusEnum.Draft)
                                {
                                    <button type="button" class="aw-btn aw-btn--ghost"
                                            @onclick="@(async () => await CalculatePayrollAutoAsync())"
                                            disabled="@_calculatingPayroll"
                                            title="Calcul automatique via sp_CalculatePayroll">
                                        @if (_calculatingPayroll)
                                        {
                                            <span class="aw-spinner" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-calculator"></i>
                                        }
                                        Calculer
                                    </button>
                                    <button type="button" class="aw-btn aw-btn--primary" @onclick="OpenAddDetail">
                                        <i class="bi bi-plus-lg"></i> Ajouter ligne
                                    </button>
                                }
                            </div>
                        </div>

                        @if (_detailsLoading)
                        {
                            <div class="aw-table-region">
                                <AwSkeleton Variant="table" Rows="5" />
                            </div>
                        }
                        else if (!_payrollDetails.Any())
                        {
                            <div class="aw-table-region">
                                <div class="aw-empty">
                                    <i class="bi bi-people"></i>
                                    <p>Aucune ligne de bulletin.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="aw-table-region">
                                <MudDataGrid T="PayrollDetail" Items="@_payrollDetails"
                                             Dense="true" Hover="true" Bordered="true"
                                             Elevation="0" Filterable="false" RowsPerPage="20">
                                    <Columns>
                                        <TemplateColumn Title="Employé">
                                            <CellTemplate>
                                                <span class="fw-semibold">@GetEmployeeName(context.Item.EmployeeId)</span>
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Salaire base (TND)" CellStyle="text-align:right;">
                                            <CellTemplate>@context.Item.BaseSalary.ToString("N3")</CellTemplate>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Brut (TND)" CellStyle="text-align:right;">
