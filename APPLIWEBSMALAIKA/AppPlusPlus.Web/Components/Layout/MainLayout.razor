@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IPermissionResolver PermissionResolver
@inject IModuleLicenseService ModuleLicenseService
@inject IUserCurrencyPreferenceService UserCurrency
@inject IJSRuntime JS
@inject UiNavigationGate NavGate
@implements IDisposable
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Globalization
@using Microsoft.JSInterop

<MudThemeProvider Theme="_appTheme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_isLoginPage || !_isAuthenticated)
{
    @Body
}
else
{
    <div class="app-layout @(_useTopbarLayout ? "app-layout--topbar" : "")">

        <!-- ══════════════ SIDEBAR ══════════════ -->
        @if (!_useTopbarLayout)
        {
        <aside class="sidebar @(_sidebarCollapsed ? "sidebar--collapsed" : "") @(_mobileSidebarOpen ? "mobile-show" : "")">

            <!-- Brand -->
            <a href="/catalogue" data-enhance-nav="false" class="sb-brand" title="Catalogue client">
                <div class="sb-brand-icon">
                    <img src="appliweb-logo-v2.png" alt="AppliWeb+" class="sb-brand-logo" />
                </div>
                @if (!_sidebarCollapsed)
                {
                    <div class="sb-brand-text">
                        <p class="sb-brand-name">@AppSettings.AppName</p>
                        <p class="sb-brand-sub">Gestion commerciale</p>
                    </div>
                }
            </a>

            <!-- Nav -->
            <nav class="sb-nav">

                @* ── PRINCIPAL ── *@
                @if (!_sidebarCollapsed)
                {
                    <p class="sb-section-label">PRINCIPAL</p>
                }

                @if (ShowDashboard)
                {
                    <a href="/dashboard" title="@(_sidebarCollapsed ? "Tableau de bord" : null)"
                       class="sb-item @(IsNavActive("/dashboard") ? "sb-item--active" : "")">
                        <i class="ti ti-layout-dashboard sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Tableau de bord</span> }
                    </a>
                }

                @if (ModuleActive("vente") && CanAccessTabNav("vente", AppFunctions.Vente, AppFunctions.Facturation))
                {
                    <a href="@VenteNavHref" title="@(_sidebarCollapsed ? "Ventes" : null)"
                       class="sb-item @(IsNavActive("/vente") ? "sb-item--active" : "")">
                        <i class="ti ti-receipt sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Ventes</span> }
                    </a>
                }

                @if (ShowArticlesNav)
                {
                    <a href="@ArticlesNavHref" title="@(_sidebarCollapsed ? "Articles" : null)"
                       class="sb-item @(IsNavActive("/stock", "/gestion/article", "/gestion/approvisionnement", "/gestion/transformation") ? "sb-item--active" : "")">
                        <i class="ti ti-box-seam sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Articles</span> }
                    </a>
                }

                @if (ModuleActive("commandes") && CanAccessTabNav("commandes", AppFunctions.CommandesClients, AppFunctions.CommandesInternes))
                {
                    <a href="@CommandesNavHref" title="@(_sidebarCollapsed ? "Commandes" : null)"
                       class="sb-item @(IsNavActive("/commandes", "/gestion/commande", "/gestion/client", "/gestion/vente") ? "sb-item--active" : "")">
                        <i class="ti ti-shopping-cart sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Commandes</span> }
                    </a>
                }

                @if (ModuleActive("services") && CanAccessTabNav("services", AppFunctions.Services))
                {
                    <a href="/services" title="@(_sidebarCollapsed ? "Prestations" : null)"
                       class="sb-item @(IsNavActive("/services") ? "sb-item--active" : "")">
                        <i class="ti ti-briefcase sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Prestations</span> }
                    </a>
                }

                @if (ModuleActive("grh") && CanAccessTabNav("grh", AppFunctions.GRH))
                {
                    <a href="/grh" title="@(_sidebarCollapsed ? "GRH" : null)"
                       class="sb-item @(IsNavActive("/grh") ? "sb-item--active" : "")">
                        <i class="ti ti-users-group sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>GRH</span> }
                    </a>
                }

                @* ── ANALYSE ── *@
                @if (!_sidebarCollapsed)
                {
                    <p class="sb-section-label">ANALYSE</p>
                }

                @if (ModuleActive("rapports") && CanAccessTabNav("rapports", AppFunctions.Rapports))
                {
                    <a href="/rapports" title="@(_sidebarCollapsed ? "Rapports" : null)"
                       class="sb-item @(IsNavActive("/rapports", "/rapport") ? "sb-item--active" : "")">
                        <i class="ti ti-chart-bar sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Rapports</span> }
                    </a>
                }

                @* ── SYSTÈME ── *@
                @if (!_sidebarCollapsed)
                {
                    <p class="sb-section-label">SYSTÈME</p>
                }

                @if (CanAccessTabNav("administration", AppFunctions.Administration))
                {
                    <a href="/administration" title="@(_sidebarCollapsed ? "Administration" : null)"
                       class="sb-item @(IsNavActive("/administration", "/admin/") ? "sb-item--active" : "")">
                        <i class="ti ti-settings-2 sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Administration</span> }
                    </a>
                }

                @if (CanAccessTabNav("parametres", AppFunctions.Parametres))
                {
                    <a href="/settings" title="@(_sidebarCollapsed ? "Paramètres" : null)"
                       class="sb-item @(IsNavActive("/settings") ? "sb-item--active" : "")">
                        <i class="ti ti-adjustments sb-icon"></i>
                        @if (!_sidebarCollapsed) { <span>Paramètres</span> }
                    </a>
                }

                @if (!_sidebarCollapsed)
                {
                    <p class="sb-section-label">CLIENT</p>
                }
                <a href="/catalogue" data-enhance-nav="false" title="@(_sidebarCollapsed ? "Catalogue client" : null)" class="sb-item">
                    <i class="ti ti-shopping-bag sb-icon"></i>
                    @if (!_sidebarCollapsed) { <span>Catalogue client</span> }
                </a>

            </nav>

            <!-- Footer : collapse + logout -->
            <div class="sb-footer">
                <button class="sb-footer-btn" @onclick="@(() => _sidebarCollapsed = !_sidebarCollapsed)"
                        title="@(_sidebarCollapsed ? "Développer" : "Réduire")">
                    <i class="ti @(_sidebarCollapsed ? "ti-chevron-right" : "ti-chevron-left") sb-icon"></i>
                    @if (!_sidebarCollapsed) { <span>Réduire</span> }
                </button>
                <a href="/auth/logout" class="sb-footer-btn sb-footer-btn--danger"
                   title="@(_sidebarCollapsed ? "Déconnexion" : null)">
                    <i class="ti ti-logout sb-icon"></i>
                    @if (!_sidebarCollapsed) { <span>Déconnexion</span> }
                </a>
            </div>
        </aside>

        <div class="sidebar-overlay @(_mobileSidebarOpen ? "show" : "")" @onclick="CloseMobileSidebar"></div>
        }

        <!-- ══════════════ MAIN AREA ══════════════ -->
        <div class="main-area">

            @if (_useTopbarLayout)
            {
                <!-- TOPNAV UNIFIED BAR (topbar mode) -->
                <nav class="topnav topnav--unified">
                  <div class="topnav-inner">
                    <a href="/catalogue" data-enhance-nav="false" class="topnav-brand" title="Catalogue client">
                        <span class="topnav-brand-icon"><img src="appliweb-logo-v2.png" alt="AppliWeb+" class="topnav-brand-logo" /></span>
                        <span class="topnav-brand-name">@AppSettings.AppName</span>
                    </a>

                    <!-- Nav links -->
                    <div class="topnav-links">
                        @if (ShowDashboard)
                        {
                            <a href="/dashboard" class="topnav-item @(IsNavActive("/dashboard") ? "topnav-item--active" : "")">
                                <i class="ti ti-layout-dashboard"></i>
                                <span>Tableau de bord</span>
                            </a>
                        }

                        @if (ModuleActive("vente") && CanAccessTabNav("vente", AppFunctions.Vente, AppFunctions.Facturation))
                        {
                            <a href="@VenteNavHref" class="topnav-item @(IsNavActive("/vente") ? "topnav-item--active" : "")">
                                <i class="ti ti-receipt"></i>
                                <span>Ventes</span>
                            </a>
                        }

                        @if (ShowArticlesNav)
                        {
                            <a href="@ArticlesNavHref" class="topnav-item @(IsNavActive("/stock", "/gestion/article", "/gestion/approvisionnement", "/gestion/transformation") ? "topnav-item--active" : "")">
                                <i class="ti ti-box-seam"></i>
                                <span>Articles</span>
                            </a>
                        }

                        @if (ModuleActive("commandes") && CanAccessTabNav("commandes", AppFunctions.CommandesClients, AppFunctions.CommandesInternes))
                        {
                            <a href="@CommandesNavHref" class="topnav-item @(IsNavActive("/commandes", "/gestion/commande", "/gestion/client", "/gestion/vente") ? "topnav-item--active" : "")">
                                <i class="ti ti-shopping-cart"></i>
                                <span>Commandes</span>
                            </a>
                        }

                        @if (ModuleActive("services") && CanAccessTabNav("services", AppFunctions.Services))
                        {
                            <a href="/services" class="topnav-item @(IsNavActive("/services") ? "topnav-item--active" : "")">
                                <i class="ti ti-briefcase"></i>
                                <span>Prestations</span>
                            </a>
                        }

                        @if (ModuleActive("grh") && CanAccessTabNav("grh", AppFunctions.GRH))
                        {
                            <a href="/grh" class="topnav-item @(IsNavActive("/grh") ? "topnav-item--active" : "")">
                                <i class="ti ti-users-group"></i>
                                <span>GRH</span>
                            </a>
                        }

                        @if (ModuleActive("rapports") && CanAccessTabNav("rapports", AppFunctions.Rapports))
                        {
                            <a href="/rapports" class="topnav-item @(IsNavActive("/rapports", "/rapport") ? "topnav-item--active" : "")">
                                <i class="ti ti-chart-bar"></i>
                                <span>Rapports</span>
                            </a>
                        }

                        @if (CanAccessTabNav("administration", AppFunctions.Administration))
                        {
                            <a href="/administration" class="topnav-item @(IsNavActive("/administration", "/admin/") ? "topnav-item--active" : "")">
                                <i class="ti ti-settings-2"></i>
                                <span>Administration</span>
                            </a>
                        }

                        @if (CanAccessTabNav("parametres", AppFunctions.Parametres))
                        {
                            <a href="/settings" class="topnav-item @(IsNavActive("/settings") ? "topnav-item--active" : "")">
                                <i class="ti ti-adjustments"></i>
                                <span>Paramètres</span>
                            </a>
                        }
                    </div>

                    <!-- Right section: actions + user -->
                    <div class="topnav-right">
                        <a href="/catalogue" data-enhance-nav="false" class="topnav-tool" title="Catalogue client">
                            <i class="ti ti-shopping-bag"></i>
                        </a>
                        <CurrencyToggle CssClass="currency-toggle--topnav" />

                        @if (_profileOpen)
                        {
                            <div @ref="_accountBackdropRef" class="dropdown-backdrop aw-float-backdrop"></div>
                        }
                        <div class="aw-account">
                            <button type="button"
                                    @ref="_accountTriggerRef"
                                    class="aw-account__trigger @(_profileOpen ? "aw-account__trigger--open" : "")"
                                    aria-expanded="@_profileOpen"
                                    aria-haspopup="menu"
                                    @onclick="ToggleProfileMenuAsync"
                                    @onclick:stopPropagation="true">
                                <span class="aw-account__avatar" aria-hidden="true">
                                    <i class="ti ti-user"></i>
                                </span>
                                <span class="aw-account__meta">
                                    <span class="aw-account__name">@_currentUserName</span>
                                    <span class="aw-account__role">@_currentUserRole</span>
                                </span>
                                <i class="ti ti-chevron-down aw-account__chevron" aria-hidden="true"></i>
                            </button>
                            @if (_profileOpen)
                            {
                                <div @ref="_accountMenuRef" class="aw-account__menu aw-float-panel" role="menu">
                                    <div class="aw-account__head">
                                        <span class="aw-account__avatar aw-account__avatar--lg" aria-hidden="true">
                                            <i class="ti ti-user"></i>
                                        </span>
                                        <div class="aw-account__head-text">
                                            <span class="aw-account__head-name">@_currentUserName</span>
                                            <span class="aw-account__head-role">@_currentUserRole</span>
                                        </div>
                                    </div>
                                    <div class="aw-account__list">
                                        <a href="/catalogue" data-enhance-nav="false" class="aw-account__item" role="menuitem"
                                           @onclick="@(() => _ = CloseProfileMenuAsync())">
                                            <i class="ti ti-shopping-bag" aria-hidden="true"></i>
                                            <span>Catalogue client</span>
                                        </a>
                                        <a href="/profile" class="aw-account__item" role="menuitem"
                                           @onclick="@(() => _ = CloseProfileMenuAsync())">
                                            <i class="ti ti-user" aria-hidden="true"></i>
                                            <span>Mon profil</span>
                                        </a>
                                        @if (CanAccessTabNav("parametres", AppFunctions.Parametres))
                                        {
                                            <a href="/settings" class="aw-account__item" role="menuitem"
                                               @onclick="@(() => _ = CloseProfileMenuAsync())">
                                                <i class="ti ti-adjustments" aria-hidden="true"></i>
                                                <span>Paramètres</span>
                                            </a>
                                        }
                                    </div>
                                    <div class="aw-account__footer">
                                        <a href="/auth/logout" class="aw-account__item aw-account__item--danger" role="menuitem">
                                            <i class="ti ti-logout" aria-hidden="true"></i>
                                            <span>Déconnexion</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                  </div>
                </nav>
            }
            else
            {
                <!-- TOPBAR (sidebar mode — white bar) -->
                <header class="topbar">
                    <button type="button"
                            class="topbar-menu-btn d-lg-none"
                            aria-label="Ouvrir le menu"
                            @onclick="ToggleMobileSidebar">
                        <i class="ti ti-menu-2"></i>
                    </button>
                    <!-- Page title + date -->
                    <div class="topbar-title">
                        <h1 class="topbar-page-name">@_pageTitle</h1>
                        <div class="topbar-date">
                            <i class="ti ti-calendar-event" style="font-size:13px;"></i>
                            <span>@_todayLabel</span>
                        </div>
                    </div>

                    <!-- Spacer -->
                    <div style="flex:1;"></div>

                    <!-- Action buttons -->
                    <div class="topbar-actions">
                        <a href="/catalogue" data-enhance-nav="false" class="topbar-tool" title="Catalogue client">
                            <i class="ti ti-shopping-bag"></i>
                        </a>
                        <CurrencyToggle CssClass="currency-toggle--topbar" />
                    </div>

                    @if (_profileOpen)
                    {
                        <div @ref="_accountBackdropRef" class="dropdown-backdrop aw-float-backdrop"></div>
                    }
                    <div class="aw-account aw-account--light">
                        <button type="button"
                                @ref="_accountTriggerRef"
                                class="aw-account__trigger @(_profileOpen ? "aw-account__trigger--open" : "")"
                                aria-expanded="@_profileOpen"
                                aria-haspopup="menu"
                                @onclick="ToggleProfileMenuAsync"
                                @onclick:stopPropagation="true">
                            <span class="aw-account__avatar" aria-hidden="true">
                                <i class="ti ti-user"></i>
                            </span>
                            <span class="aw-account__meta">
                                <span class="aw-account__name">@_currentUserName</span>
                                <span class="aw-account__role">@_currentUserRole</span>
                            </span>
                            <i class="ti ti-chevron-down aw-account__chevron" aria-hidden="true"></i>
                        </button>
                        @if (_profileOpen)
                        {
                            <div @ref="_accountMenuRef" class="aw-account__menu aw-float-panel" role="menu">
                                <div class="aw-account__head">
                                    <span class="aw-account__avatar aw-account__avatar--lg" aria-hidden="true">
                                        <i class="ti ti-user"></i>
                                    </span>
                                    <div class="aw-account__head-text">
                                        <span class="aw-account__head-name">@_currentUserName</span>
                                        <span class="aw-account__head-role">@_currentUserRole</span>
                                    </div>
                                </div>
                                <div class="aw-account__list">
                                    <a href="/catalogue" data-enhance-nav="false" class="aw-account__item" role="menuitem"
                                       @onclick="@(() => _ = CloseProfileMenuAsync())">
                                        <i class="ti ti-shopping-bag" aria-hidden="true"></i>
                                        <span>Catalogue client</span>
                                    </a>
                                    <a href="/profile" class="aw-account__item" role="menuitem"
                                       @onclick="@(() => _ = CloseProfileMenuAsync())">
                                        <i class="ti ti-user" aria-hidden="true"></i>
                                        <span>Mon profil</span>
                                    </a>
                                    @if (CanAccessTabNav("parametres", AppFunctions.Parametres))
                                    {
                                        <a href="/settings" class="aw-account__item" role="menuitem"
                                           @onclick="@(() => _ = CloseProfileMenuAsync())">
                                            <i class="ti ti-adjustments" aria-hidden="true"></i>
                                            <span>Paramètres</span>
                                        </a>
                                    }
                                </div>
                                <div class="aw-account__footer">
                                    <a href="/auth/logout" class="aw-account__item aw-account__item--danger" role="menuitem">
                                        <i class="ti ti-logout" aria-hidden="true"></i>
                                        <span>Déconnexion</span>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </header>
            }

            <!-- CONTENT -->
            <main class="page-content">
                <div class="page-shell">
                    @if (_hasCurrentRouteAccess)
                    {
                        <CurrencyRefreshBoundary>
                            @Body
                        </CurrencyRefreshBoundary>
                    }
                    else
                    {
                        <div class="aw-page" style="padding:1.5rem 0;">
                            <div class="aw-shell" style="max-width:720px;margin:0 auto;">
                                <div class="aw-empty">
                                    <i class="bi bi-lock"></i>
                                    <p><strong>Accès refusé</strong><br />Votre rôle ne possède pas la fonction nécessaire pour afficher cette page.</p>
                                    <button type="button" class="aw-btn aw-btn--primary" style="margin-top:0.75rem;"
                                            @onclick="@(() => Nav.NavigateTo(GetFirstAccessibleRoute()))">
                                        <i class="bi bi-house"></i> Retour
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </main>

            <!-- ══════════════ APP FOOTER ══════════════ -->
            <footer class="app-footer">
                <div class="app-footer-inner">
                    <span class="app-footer-copy">
                        &copy; @DateTime.Now.Year <strong>@AppSettings.AppName</strong>. Tous droits réservés.
                    </span>
                    <span class="app-footer-version">
                        v@_appVersion
                    </span>
                </div>
            </footer>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // MudBlazor Theme with new color palette
    private readonly MudTheme _appTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#009e84",
            Secondary = "#a67235",
            Tertiary = "#3b82f6",
            Error = "#9a170c",
            Warning = "#a67235",
            Success = "#009e84",
            Info = "#3b82f6",
            Background = "#e8eef5",
            Surface = "#ffffff",
            AppbarBackground = "#0f172a",
            AppbarText = "#ffffff",
            DrawerBackground = "#0f172a",
            DrawerText = "rgba(255,255,255,0.78)",
            DrawerIcon = "rgba(255,255,255,0.65)"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#009e84",
