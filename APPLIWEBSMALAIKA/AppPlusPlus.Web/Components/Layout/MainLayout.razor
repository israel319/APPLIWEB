        ("/vente/payement", "Ventes > Paiements", "payments"),
        ("/vente", "Ventes", "point_of_sale"),
        // Articles
        ("/gestion/article/nouveau", "Articles > Nouvel article", "add_circle"),
        ("/gestion/article/modifier", "Articles > Modifier article", "edit"),
        ("/gestion/article", "Articles > Catalogue", "category"),
        ("/gestion/approvisionnement", "Articles > Approvisionnement", "add_shopping_cart"),
        ("/gestion/transformation", "Articles > Transformation", "transform"),
        ("/stock", "Articles", "inventory_2"),
        ("/settings", "Paramètres", "settings"),
        // Commandes
        ("/gestion/commande", "Commandes > Commandes internes", "assignment"),
        ("/gestion/client", "Commandes > Clients", "people"),
        ("/gestion/vente", "Commandes > Commandes clients", "storefront"),
        ("/commandes", "Commandes & Clients", "shopping_cart"),
        // Services
        ("/services/catalogue", "Services > Catalogue", "work"),
        ("/services", "Catalogue prestations", "work"),
        // GRH
        ("/grh", "GRH — Ressources Humaines", "badge"),
        // Rapports
        ("/rapport/appro-ben", "Rapports > Appro & B\u00e9n\u00e9fice", "analytics"),
        ("/rapport/commande", "Rapports > Commandes", "list_alt"),
        ("/rapport/stock", "Rapports > Stock", "inventory"),
        ("/rapport/vente-mois", "Rapports > Ventes mensuelles", "calendar_month"),
        ("/rapport/vente-appro", "Rapports > Ventes & Appro", "compare_arrows"),
        ("/rapport/vente", "Rapports > Ventes", "trending_up"),
        ("/rapports", "Rapports", "assessment"),
        // Administration
        ("/admin/facture", "Administration > Gestion factures", "receipt"),
        ("/admin/livraison-payement", "Administration > Gestion livraisons", "local_shipping"),
        ("/admin/periode-gestion", "Administration > P\u00e9riodes", "date_range"),
        ("/admin/utilisateur", "Administration > Utilisateurs", "manage_accounts"),
        ("/admin/taux", "Administration > Taux", "percent"),
        ("/admin/versement", "Administration > Versements", "account_balance"),
        ("/administration", "Administration", "admin_panel_settings"),
    };

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        AppSettings.OnChange += OnAppSettingsChanged;

        _currentPath = new Uri(Nav.Uri).AbsolutePath;
        LoadLayoutPreference();
        LoadThemePreference();
        UpdatePageTitle(Nav.Uri);
        UpdateTodayLabel();
        await RefreshSecurityStateAsync();
        await LoadModuleLicensesAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            try
            {
                try { await JS.InvokeVoidAsync("appNavigation.startProgress"); } catch { }

                _currentPath = new Uri(e.Location).AbsolutePath;
                UpdatePageTitle(e.Location);
                await CloseProfileMenuAsync();
                _mobileSidebarOpen = false;
                await RefreshSecurityStateAsync();
                StateHasChanged();
            }
            catch
            {
            }
            finally
            {
                NavGate.ForceReset();
                try { await JS.InvokeVoidAsync("appNavigation.finishProgress"); } catch { }
            }
        });

    private void ToggleMobileSidebar() => _mobileSidebarOpen = !_mobileSidebarOpen;

    private void CloseMobileSidebar() => _mobileSidebarOpen = false;

    private async Task ToggleProfileMenuAsync()
    {
        if (_profileOpen)
        {
            await CloseProfileMenuAsync();
            return;
        }
        _profileOpen = true;
        _accountPlacePending = true;
    }

    private async Task CloseProfileMenuAsync()
    {
        if (!_profileOpen) return;
        await StopAccountWatchAsync();
        _profileOpen = false;
        _accountPlacePending = false;
    }

    private async Task StartAccountWatchAsync()
    {
        await StopAccountWatchAsync();
        try
        {
            _overlayRef ??= DotNetObjectReference.Create(this);
            _accountWatchId = await JS.InvokeAsync<int>("awOverlay.watch", _accountTriggerRef, _accountMenuRef, new
            {
                align = "end",
                width = 248,
                minWidth = 248,
                maxWidth = 248,
                maxHeight = 420,
                estimatedHeight = 280,
                gap = 6
            }, _accountBackdropRef, _overlayRef);
        }
        catch { /* ignore */ }
    }

    private async Task StopAccountWatchAsync()
    {
        if (_accountWatchId is null) return;
        var id = _accountWatchId.Value;
        _accountWatchId = null;
        try
        {
            await JS.InvokeVoidAsync("awOverlay.unwatch", id);
        }
        catch { /* ignore */ }
    }

    private void UpdatePageTitle(string url)
    {
        var path = new Uri(url).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        foreach (var (prefix, label, _) in _routes)
        {
            if (path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                // Keep only the last segment after " > " for the topbar title
                var parts = label.Split(" > ");
                _pageTitle = parts[^1];
                return;
            }
        }
        _pageTitle = "Tableau de bord";
    }

    // IsNavActive helper — returns true if current path matches any of the given prefixes
    private bool IsNavActive(params string[] prefixes)
    {
        var path = _currentPath.TrimEnd('/').ToLowerInvariant();
        foreach (var prefix in prefixes)
        {
            var rawPrefix = prefix.ToLowerInvariant();
            var p = rawPrefix.TrimEnd('/');
            if (rawPrefix == "/")
            {
                if (path == "") return true;
            }
            else if (path == p || path.StartsWith(p + "/"))
            {
                return true;
            }
        }
        return false;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await RefreshSecurityStateAsync(task);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSecurityStateAsync(Task<AuthenticationState>? authTask = null)
    {
        var authState = authTask is null
            ? await AuthStateProvider.GetAuthenticationStateAsync()
            : await authTask;

        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;

        if (user.Identity?.IsAuthenticated == true)
        {
            var login = user.FindFirst("login")?.Value
                ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            _currentUserName = user.FindFirst("login")?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? "Utilisateur";
            _currentUserRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "Aucun rôle";
            _isAdministrator = AppFunctions.Normalize(_currentUserRole) == "administrateur";
            _isVendeur = AppFunctions.IsVendeurRole(_currentUserRole);
            if (!string.Equals(_permissionsLogin, login, StringComparison.OrdinalIgnoreCase))
            {
                _permissions = await PermissionResolver.GetPermissionsAsync(login);
                _permissionsLogin = login;
            }
            _hasCurrentRouteAccess = HasRouteReadAccess(_currentPath);
            await UserCurrency.EnsureLoadedAsync();

            if (_permissions.HasHierarchicalGrants)
            {
                if (PermissionCatalog.ShouldRedirectStockToInventaire(_permissions.Grants)
                    && (_currentPath == "/stock" || _currentPath == "/stock/"))
                {
                    Nav.NavigateTo("/stock/inventaire", replace: true);
                    return;
                }

                if (!_hasCurrentRouteAccess)
                {
                    var target = GetFirstAccessibleRoute();
                    if (target != _currentPath)
                    {
                        Nav.NavigateTo(target);
                        return;
                    }
                }
            }
            else if (_isVendeur && (_currentPath == "/dashboard" || _currentPath == "/dashboard/"))
            {
                Nav.NavigateTo("/vente");
                return;
            }
            else if (_isVendeur && (_currentPath == "/" || _currentPath == ""))
            {
                Nav.NavigateTo("/vente");
                return;
            }

            // Redirect to first accessible page if current route is not allowed
            if (!_hasCurrentRouteAccess)
            {
                var target = GetFirstAccessibleRoute();
                if (target != _currentPath)
                {
                    Nav.NavigateTo(target);
                    return;
                }
            }

            return;
        }

        _currentUserName = "Invité";
        _currentUserRole = "Non connecté";
        _isAdministrator = false;
        _isVendeur = false;
        _permissions = PermissionSnapshot.Empty;
        _permissionsLogin = null;
        _hasCurrentRouteAccess = true;
    }

    private async void OnAppSettingsChanged()
    {
        LoadLayoutPreference();
        LoadThemePreference();
        UpdateTodayLabel();
        await CloseProfileMenuAsync();
        await InvokeAsync(async () =>
        {
            await ApplyHtmlAttributesAsync();
            StateHasChanged();
        });
    }

    private void LoadLayoutPreference()
    {
        var pref = AppSettings.Get(IAppSettingsService.KEY_LAYOUT_PREFERENCE);
        _layoutPreference = NormalizeLayoutPreference(pref);
    }

    private void LoadThemePreference()
    {
        var theme = AppSettings.Get(IAppSettingsService.KEY_THEME);
        _isDarkMode = string.Equals(theme, "Sombre", StringComparison.OrdinalIgnoreCase);
    }

    private void UpdateTodayLabel()
    {
        var langue = AppSettings.Get(IAppSettingsService.KEY_LANGUE);
        var culture = langue switch
        {
            "English" => new CultureInfo("en-US"),
            "Español" => new CultureInfo("es-ES"),
            "Deutsch" => new CultureInfo("de-DE"),
            _ => new CultureInfo("fr-FR")
        };
        _todayLabel = DateTime.Now.ToString("dddd d MMMM yyyy", culture);
    }

    private CultureInfo GetCurrentCulture()
    {
        var langue = AppSettings.Get(IAppSettingsService.KEY_LANGUE);
        return langue switch
        {
            "English" => new CultureInfo("en-US"),
            "Español" => new CultureInfo("es-ES"),
            "Deutsch" => new CultureInfo("de-DE"),
            _ => new CultureInfo("fr-FR")
        };
    }

    private async Task ApplyHtmlAttributesAsync()
    {
        try
        {
            var bsTheme = _isDarkMode ? "dark" : "light";
            var langue = AppSettings.Get(IAppSettingsService.KEY_LANGUE);
            var langCode = langue switch
            {
                "English" => "en",
                "Español" => "es",
                "Deutsch" => "de",
                _ => "fr"
            };
            await JS.InvokeVoidAsync("eval",
                $"document.documentElement.setAttribute('data-bs-theme','{bsTheme}');" +
                $"document.documentElement.setAttribute('lang','{langCode}');");
        }
        catch { /* SSR prerender — no JS available yet */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            LoadThemePreference();
            await ApplyHtmlAttributesAsync();
            try
            {
                await JS.InvokeVoidAsync("awOverlay.configureBootstrapDropdowns");
            }
            catch { /* ignore */ }
            // Do not call StateHasChanged here — it causes a visible double paint of the chrome.
        }

        if (_accountPlacePending && _profileOpen)
        {
            _accountPlacePending = false;
            await StartAccountWatchAsync();
        }
    }

    private static string NormalizeLayoutPreference(string? layoutPreference)
        => string.Equals(layoutPreference, LayoutTopbar, StringComparison.OrdinalIgnoreCase)
            ? LayoutTopbar
            : LayoutSidebar;

    private string ArticlesNavHref =>
        HasHierarchicalGrants
            ? PermissionCatalog.FirstAccessibleArticlesRoute(_permissions.Grants) ?? "/profile"
            : "/stock";

    private string VenteNavHref =>
        HasHierarchicalGrants
            ? PermissionCatalog.FirstAccessibleVenteRoute(_permissions.Grants) ?? "/profile"
            : "/vente";

    private string CommandesNavHref =>
        HasHierarchicalGrants
            ? PermissionCatalog.FirstAccessibleCommandesRoute(_permissions.Grants) ?? "/profile"
            : "/commandes";

    private bool HasHierarchicalGrants => _permissions.HasHierarchicalGrants;

    private bool CanAccessTabNav(string tabCode, params string[] legacyReadModules)
    {
        if (HasHierarchicalGrants)
            return _permissions.CanAccessTab(tabCode);

        if (_isAdministrator)
            return true;

        return legacyReadModules.Any(m => _permissions.CanRead(m));
    }

    private bool CanRead(string functionName) =>
        !HasHierarchicalGrants && (_isAdministrator || _permissions.CanRead(functionName));

    private bool ShowDashboard =>
        HasHierarchicalGrants
            ? _permissions.CanAccessTab("dashboard")
            : CanAccessTabNav("dashboard", AppFunctions.Dashboard) && !_isVendeur;

    private bool ShowArticlesNav =>
        ModuleActive("stock") && (
            HasHierarchicalGrants
                ? _permissions.CanAccessTab("articles")
                : CanAccessTabNav("articles", AppFunctions.Stock, AppFunctions.Approvisionnement));

    private async Task LoadModuleLicensesAsync()
    {
        try
        {
            var all = await ModuleLicenseService.GetAllModulesAsync();
            _moduleLicenses = all.ToDictionary(m => m.ModuleCode, m => m.IsActive);
        }
        catch
        {
            // If the table is not yet created, all modules are considered active (fail-open)
            _moduleLicenses = new Dictionary<string, bool>();
        }
    }

    private string GetFirstAccessibleRoute() =>
        HasHierarchicalGrants
            ? PermissionCatalog.FirstAccessibleRoute(_permissions.Grants)
            : GetLegacyFirstAccessibleRoute();

    private string GetLegacyFirstAccessibleRoute()
    {
        if (ShowDashboard) return "/dashboard";
        if (CanAccessTabNav("vente", AppFunctions.Vente, AppFunctions.Facturation)) return "/vente";
        if (CanAccessTabNav("articles", AppFunctions.Stock, AppFunctions.Approvisionnement)) return "/stock";
        if (CanAccessTabNav("commandes", AppFunctions.CommandesClients, AppFunctions.CommandesInternes)) return "/commandes";
        if (CanAccessTabNav("grh", AppFunctions.GRH)) return "/grh";
        if (CanAccessTabNav("rapports", AppFunctions.Rapports)) return "/rapports";
        if (CanAccessTabNav("administration", AppFunctions.Administration)) return "/administration";
        if (CanAccessTabNav("parametres", AppFunctions.Parametres)) return "/settings";
        return "/profile";
    }

    private bool HasRouteReadAccess(string path)
    {
        var normalizedPath = (path ?? "/").Trim().ToLowerInvariant();

        if (normalizedPath == "/dashboard" || normalizedPath == "/dashboard/")
            return ShowDashboard;

        if (normalizedPath == "/" || normalizedPath == "")
            return true;

        if (HasHierarchicalGrants)
            return PermissionCatalog.CanAccessRoutePath(_permissions.Grants, normalizedPath);

        if (_isVendeur && (normalizedPath.StartsWith("/gestion/") || normalizedPath.StartsWith("/stock/appro") || normalizedPath.StartsWith("/stock/transformation")))
            return false;

        if (_isVendeur && normalizedPath.StartsWith("/stock"))
            return ShowArticlesNav;

        if (normalizedPath.StartsWith("/commandes"))
            return CanAccessTabNav("commandes", AppFunctions.CommandesClients, AppFunctions.CommandesInternes);

        var requiredFunction = GetRequiredFunction(path ?? "/");
        return string.IsNullOrWhiteSpace(requiredFunction) || CanRead(requiredFunction);
    }

    private static string? GetRequiredFunction(string path)
    {
        var normalizedPath = (path ?? "/").Trim().ToLowerInvariant();

        if (normalizedPath.StartsWith("/login") || normalizedPath.StartsWith("/profile") || normalizedPath.StartsWith("/client/"))
            return null;

        if (normalizedPath == "/" || normalizedPath == "")
            return null;

        if (normalizedPath == "/dashboard" || normalizedPath == "/dashboard/")
            return AppFunctions.Dashboard;

        if (normalizedPath.StartsWith("/settings"))
            return AppFunctions.Parametres;

        if (normalizedPath.StartsWith("/administration") || normalizedPath.StartsWith("/admin/"))
            return AppFunctions.Administration;

        if (normalizedPath.StartsWith("/rapports") || normalizedPath.StartsWith("/rapport/"))
            return AppFunctions.Rapports;

        if (normalizedPath.StartsWith("/grh"))
            return AppFunctions.GRH;

        if (normalizedPath.StartsWith("/services"))
            return AppFunctions.Services;

        if (normalizedPath.StartsWith("/vente/facturation") || normalizedPath.StartsWith("/vente/facture/print"))
            return AppFunctions.Facturation;

        if (normalizedPath.StartsWith("/vente"))
            return AppFunctions.Vente;

        if (normalizedPath.StartsWith("/stock")
            || normalizedPath.StartsWith("/gestion/article")
            || normalizedPath.StartsWith("/gestion/transformation"))
            return AppFunctions.Stock;

        if (normalizedPath.StartsWith("/gestion/approvisionnement"))
            return AppFunctions.Approvisionnement;

        if (normalizedPath.StartsWith("/gestion/commande"))
            return AppFunctions.CommandesInternes;

        if (normalizedPath.StartsWith("/gestion/client")
            || normalizedPath.StartsWith("/gestion/vente"))
            return AppFunctions.CommandesClients;

        return null;
    }

    [JSInvokable]
    public Task OnOverlayDismiss() => CloseProfileMenuAsync();

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        AppSettings.OnChange -= OnAppSettingsChanged;
        _ = StopAccountWatchAsync();
        _overlayRef?.Dispose();
    }
}
