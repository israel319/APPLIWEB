    private bool _isDarkMode;

    private const string LayoutSidebar = IAppSettingsService.LAYOUT_SIDEBAR;
    private const string LayoutTopbar = IAppSettingsService.LAYOUT_TOPBAR;

    private string _layoutPreference = LayoutSidebar;
    private bool _useTopbarLayout => string.Equals(_layoutPreference, LayoutTopbar, StringComparison.OrdinalIgnoreCase);
    private bool _sidebarCollapsed = true;
    private bool _mobileSidebarOpen;
    private bool _profileOpen;
    private bool _accountPlacePending;
    private int? _accountWatchId;
    private DotNetObjectReference<MainLayout>? _overlayRef;
    private ElementReference _accountTriggerRef;
    private ElementReference _accountMenuRef;
    private ElementReference _accountBackdropRef;
    private string _pageTitle = "Tableau de bord";
    private string _todayLabel = "";
    private string _currentUserName = "Utilisateur";
    private string _currentUserRole = "Aucun rôle";
    private string _currentPath = "/";
    private string _appVersion = typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.0.0";
    private bool _isAuthenticated;
    private bool _isAdministrator;
    private bool _isVendeur;
    private bool _hasCurrentRouteAccess = true;
    private PermissionSnapshot _permissions = PermissionSnapshot.Empty;
    private string? _permissionsLogin;

    // Module licenses cache — loaded once at init
    private Dictionary<string, bool> _moduleLicenses = new();
    private bool ModuleActive(string moduleCode)
        => _moduleLicenses.TryGetValue(moduleCode, out var active) && active;

    private bool _isLoginPage => _currentPath.StartsWith("/login", StringComparison.OrdinalIgnoreCase);

    // Map URL prefixes to breadcrumb labels
    private static readonly (string prefix, string label, string icon)[] _routes = new[]
    {
        ("/dashboard", "Tableau de bord", "dashboard"),
        // Ventes
        ("/vente/facturation", "Ventes > Facturation", "shopping_cart_checkout"),
        ("/vente/facture/print", "Ventes > Impression facture", "print"),
